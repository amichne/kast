{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "operation",
    "status",
    "delivery_stop",
    "semantic",
    "binding",
    "nextQuery",
    "detail"
  ],
  "properties": {
    "type": {
      "const": "QUERY_PRESENTATION_HEADER"
    },
    "operation": {
      "const": "query.run"
    },
    "status": {
      "enum": [
        "complete",
        "qualified",
        "rejected"
      ]
    },
    "delivery_stop": {
      "enum": [
        "BYTE_LIMIT",
        "DETAIL_SECTION"
      ]
    },
    "semantic": {
      "$ref": "#/$defs/SemanticHeader"
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "result"
          ],
          "properties": {
            "type": {
              "const": "RETAINED_RESULT"
            },
            "result": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "root",
            "host",
            "epoch",
            "contentView",
            "version"
          ],
          "properties": {
            "type": {
              "const": "LIVE"
            },
            "root": {
              "type": "string",
              "maxLength": 4096
            },
            "host": {
              "type": "string",
              "maxLength": 128
            },
            "epoch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "contentView": {
              "type": "string",
              "maxLength": 128
            },
            "version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "UNAVAILABLE"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "workspace_digest",
            "host",
            "epoch",
            "contentView",
            "version"
          ],
          "properties": {
            "type": {
              "const": "LIVE_DIGEST"
            },
            "workspace_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "maxLength": 64
            },
            "host": {
              "type": "string",
              "maxLength": 36
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "contentView": {
              "enum": [
                "SAVED_PSI_COMMITTED"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1
            }
          }
        }
      ]
    },
    "nextQuery": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "request"
          ],
          "additionalProperties": false,
          "properties": {
            "request": {
              "$ref": "#/$defs/ReadResultAction"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selector",
            "end",
            "total",
            "text"
          ],
          "properties": {
            "selector": {
              "$ref": "#/$defs/DetailSelector"
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "text": {
              "type": "string",
              "maxLength": 32768
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "SemanticHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_outcome",
        "completion",
        "authority",
        "coverage",
        "blockers",
        "omissions",
        "presentation",
        "recovery"
      ],
      "properties": {
        "original_outcome": {
          "enum": [
            "complete",
            "qualified",
            "rejected_document",
            "rejected"
          ]
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy",
            "model",
            "interpretation",
            "cause"
          ],
          "properties": {
            "policy": {
              "enum": [
                "COMPLETE_ONLY",
                "UNAVAILABLE"
              ]
            },
            "model": {
              "enum": [
                "COMPILER_RESOLVED_STATIC_V1",
                "UNAVAILABLE"
              ]
            },
            "interpretation": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "cause": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            }
          }
        },
        "authority": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "result"
              ],
              "properties": {
                "type": {
                  "const": "RETAINED_RESULT"
                },
                "result": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "root",
                "host",
                "epoch",
                "contentView",
                "version"
              ],
              "properties": {
                "type": {
                  "const": "LIVE"
                },
                "root": {
                  "type": "string",
                  "maxLength": 4096
                },
                "host": {
                  "type": "string",
                  "maxLength": 128
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "contentView": {
                  "type": "string",
                  "maxLength": 128
                },
                "version": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "UNAVAILABLE"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "workspace_digest",
                "host",
                "epoch",
                "contentView",
                "version"
              ],
              "properties": {
                "type": {
                  "const": "LIVE_DIGEST"
                },
                "workspace_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "maxLength": 64
                },
                "host": {
                  "type": "string",
                  "maxLength": 36
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "contentView": {
                  "enum": [
                    "SAVED_PSI_COMMITTED"
                  ]
                },
                "version": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1
                }
              }
            }
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "exhaustive",
            "known_minimum",
            "limitations",
            "progress"
          ],
          "properties": {
            "type": {
              "enum": [
                "COMPLETE",
                "QUALIFIED",
                "UNKNOWN"
              ]
            },
            "exhaustive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "known_minimum": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "limitations": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            },
            "progress": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "reason",
                "next_action"
              ],
              "properties": {
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                },
                "next_action": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 128
                }
              }
            }
          }
        },
        "blockers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failure",
            "rejection",
            "cause",
            "stop",
            "qualification",
            "codes",
            "failure_count",
            "kinds"
          ],
          "properties": {
            "failure": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "rejection": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "cause": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "stop": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "qualification": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            },
            "codes": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            },
            "failure_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kinds": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "omissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "codes"
          ],
          "properties": {
            "codes": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            },
            "count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "accumulated_rows",
            "evidence_presented",
            "evidence_total",
            "detail",
            "deferred_count",
            "detail_read"
          ],
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "accumulated_rows": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "evidence_presented": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "evidence_total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "detail": {
              "enum": [
                "INLINE",
                "DEFERRED_DETAIL",
                "UNAVAILABLE"
              ]
            },
            "deferred_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "detail_read": {
              "enum": [
                "NONE",
                "FRAGMENT",
                "FINAL_FRAGMENT"
              ]
            }
          }
        },
        "recovery": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "result",
                "cursor",
                "evidence_cursor"
              ],
              "properties": {
                "type": {
                  "const": "READ_RESULT"
                },
                "result": {
                  "type": "string",
                  "maxLength": 128
                },
                "cursor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "evidence_cursor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "continuation"
              ],
              "properties": {
                "type": {
                  "const": "RESUME"
                },
                "continuation": {
                  "type": "string",
                  "maxLength": 128
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "reason"
              ],
              "properties": {
                "type": {
                  "const": "UNAVAILABLE"
                },
                "reason": {
                  "enum": [
                    "NO_RETAINED_AUTHORITY",
                    "AUTHORITY_REJECTED"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "ReadResultOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/SymbolsOutput"
        },
        {
          "$ref": "#/$defs/OccurrencesOutput"
        },
        {
          "$ref": "#/$defs/TraversalRecordsOutput"
        },
        {
          "$ref": "#/$defs/BindingRowsOutput"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/ValuePathsOutput"
        },
        {
          "$ref": "#/$defs/ImpactWitnessOutput"
        }
      ],
      "description": "Present retained symbols, compiler-confirmed occurrences, depth-bearing traversal records or typed binding rows without rerunning stages. Omission or null selects symbol fields and rejects a retained occurrence or binding-row result."
    },
    "SymbolsOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SYMBOLS"
          ],
          "default": "SYMBOLS"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NAME",
              "LOCATION",
              "SIGNATURE",
              "SOURCE"
            ]
          },
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "description": "[] requests mandatory identity and kind only. Source adds a committed bounded source window."
        }
      },
      "required": [
        "type",
        "fields"
      ],
      "additionalProperties": false
    },
    "OccurrencesOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "OCCURRENCES"
          ],
          "default": "OCCURRENCES"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "TraversalRecordsOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TRAVERSAL_RECORDS"
          ],
          "default": "TRAVERSAL_RECORDS"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Present each compiler-confirmed walk record with its hop depth and relation fact."
    },
    "ExecutionBudget": {
      "type": [
        "object",
        "null"
      ],
      "description": "RUNNER_CONTROLLED has no implicit semantic work or time limit. It accepts an explicit timeout and output page controls. Legacy BOUNDED mode uses configured grants and ceilings.",
      "properties": {
        "maxElapsedMs": {
          "description": "Explicit timeout in milliseconds for RUNNER_CONTROLLED execution, including model capture. Omission adds no timeout. Legacy BOUNDED mode uses KAST_READ_SEMANTIC_MILLIS and host clamps.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "maxWorkUnits": {
          "description": "Accounted work allowance. Query omission uses KAST_READ_SEMANTIC_WORK. Time and response size do not change this allowance.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "maxResults": {
          "description": "In BOUNDED mode, this caps results. In RUNNER_CONTROLLED mode, this caps each output page.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxReturnedBytes": {
          "description": "Query minimum: 4096 UTF-8 bytes. Omission uses KAST_READ_SEMANTIC_RETURNED_BYTES.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {},
      "x-default-owner": "ExecutionBudgetDocument.requested"
    },
    "ResultReference": {
      "type": "string",
      "pattern": "^result:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 46,
      "maxLength": 46,
      "x-kotlin-type": "QueryResultReference",
      "description": "Opaque retained-result reference returned by Kast. It is separate from an exact-symbol reference and an execution continuation."
    },
    "ResultCursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000,
      "x-kotlin-type": "QueryResultCursor",
      "description": "Optional presentation offset in the immutable retained result. Omission or null starts at zero; this cursor does not resume semantic execution."
    },
    "EvidenceCursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000,
      "x-kotlin-type": "QueryEvidenceCursor",
      "description": "Presentation offset in retained evidence, including deferred summaries. DEFERRED_DETAIL does not mean detail delivery. READ_RESULT.detail reads selected fragments without semantic replay.",
      "examples": [
        0,
        25
      ]
    },
    "ReadResultAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "READ_RESULT"
          ],
          "default": "READ_RESULT"
        },
        "result": {
          "$ref": "#/$defs/ResultReference"
        },
        "cursor": {
          "$ref": "#/$defs/ResultCursor"
        },
        "output": {
          "$ref": "#/$defs/ReadResultOutput"
        },
        "executionBudget": {
          "$ref": "#/$defs/ExecutionBudget"
        },
        "evidence_cursor": {
          "$ref": "#/$defs/EvidenceCursor"
        },
        "detail": {
          "$ref": "#/$defs/DetailSelector"
        }
      },
      "required": [
        "type",
        "result"
      ],
      "additionalProperties": false,
      "description": "Present an immutable retained result, starting at the supplied result cursor; this performs no query evaluation."
    },
    "BindingRowsOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "BINDING_ROWS"
          ],
          "default": "BINDING_ROWS"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Present both named symbol or exact-occurrence bindings in each inner-join pair, preserving multiplicity and evidence."
    },
    "ValuePathsOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "VALUE_PATHS"
          ],
          "default": "VALUE_PATHS"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ImpactWitnessSection": {
      "type": "string",
      "enum": [
        "PRODUCERS",
        "MODELS",
        "NATIVE_READS",
        "READ_REJECTIONS",
        "FINDINGS",
        "SITE_ACCOUNTING"
      ],
      "x-kotlin-type": "io.github.amichne.kast.protocol.contract.ImpactWitnessSectionDocument"
    },
    "ImpactWitnessOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "IMPACT_WITNESS"
          ],
          "default": "IMPACT_WITNESS"
        },
        "section": {
          "$ref": "#/$defs/ImpactWitnessSection"
        }
      },
      "required": [
        "type",
        "section"
      ],
      "additionalProperties": false,
      "description": "Present a retained original impact ledger through READ_RESULT. A strict RUN from IMPACT with no steps completes the original investigation before presenting this section. Findings retain original VALUE_PATHS row ordinals and IDs; presentation never independently proves completion."
    },
    "DetailSection": {
      "type": "string",
      "enum": [
        "CANONICAL_ENTRY_JSON"
      ],
      "default": "CANONICAL_ENTRY_JSON",
      "x-kotlin-type": "io.github.amichne.kast.protocol.contract.QueryEntryDetailSection"
    },
    "DetailSelector": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "result": {
          "$ref": "#/$defs/ResultReference"
        },
        "section": {
          "$ref": "#/$defs/DetailSection"
        },
        "target": {
          "type": "string",
          "enum": [
            "ROW",
            "EVIDENCE"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "kind": {
          "type": "string",
          "enum": [
            "EXACT_SYMBOL",
            "OCCURRENCE",
            "REFERENCE_OCCURRENCE",
            "TRAVERSAL_RECORD",
            "BINDING_ROW",
            "VALUE_PATH",
            "IMPACT_WITNESS",
            "FAILURE",
            "OMISSION",
            "WALK_OBSERVATION",
            "REFERENCE_OBSERVATION",
            "DISCOVERY_OBSERVATION",
            "RELATION_OBSERVATION"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "result",
        "section",
        "target",
        "ordinal",
        "kind",
        "sha256",
        "offset"
      ],
      "additionalProperties": false,
      "x-kotlin-type": "io.github.amichne.kast.protocol.contract.QueryEntryDetailSelectorDocument"
    }
  }
}
