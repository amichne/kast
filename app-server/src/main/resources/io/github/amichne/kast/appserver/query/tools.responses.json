[
  {
    "type": "function",
    "name": "kast_check_diagnostics",
    "description": "Check compiler diagnostics for a file or recursively beneath a directory in the session workspace. Use '.' explicitly for the workspace root. This is not symbol search and does not build the project. Results retain incomplete-coverage evidence; an incomplete empty result does not establish that the scope is clean. Requires the saved, indexed IntelliJ state.",
    "parameters": {
      "type": "object",
      "properties": {
        "relative_path": {
          "type": "string",
          "description": "File or directory path relative to the session workspace root, such as src/main/kotlin/orders/OrderService.kt or services/orders. Use '.' for the root. Not a package name, glob, absolute path, or parent traversal."
        },
        "max_diagnostics": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum diagnostic entries to return. Omission or null selects 100. This limits results, not module admission, indexing, or compiler work; incomplete coverage remains explicit."
        },
        "continuation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Opaque same-basis diagnostic continuation. Omit or use null to start. Resume the same relative_path; increase execution_budget if a grant cannot cross the enumeration prefix."
        },
        "execution_budget": {
          "$ref": "#/$defs/ExecutionBudget"
        }
      },
      "required": [
        "relative_path",
        "max_diagnostics",
        "continuation",
        "execution_budget"
      ],
      "additionalProperties": false,
      "$defs": {
        "ExecutionBudget": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional execution allowances. Null or omitted dimensions use configured defaults; positive values are independently clamped to operator and transport ceilings. These controls do not alter query take, scope, or projection.",
          "properties": {
            "max_elapsed_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_work_units": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_results": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 2147483647
            },
            "max_returned_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "max_elapsed_ms",
            "max_work_units",
            "max_results",
            "max_returned_bytes"
          ],
          "additionalProperties": false
        }
      }
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "kast_query_symbols",
    "description": "Run, resume, and read one compositional compiler-grounded Kotlin symbol query. Start from declaration discovery, a containing declaration at file offset, exact references, or immutable retained rows. Apply structured predicates, relation expansion, bounded walk, set composition, and retained binding projection and joins. Join matches canonical symbol identity and preserves both named output cells, multiplicity, and occurrence evidence; anti-join requires complete right coverage. Choose symbol, occurrence, traversal record, or binding row output. Retained results preserve qualification and omissions; execution continuation and result presentation cursor remain distinct.",
    "parameters": {
      "type": "object",
      "properties": {
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunAction"
            },
            {
              "$ref": "#/$defs/ResumeAction"
            },
            {
              "$ref": "#/$defs/ReadResultAction"
            }
          ],
          "description": "Exactly one closed query action: run, resume, or read_result."
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false,
      "$defs": {
        "DirectoryScope": {
          "type": "object",
          "properties": {
            "relative_directory_path": {
              "type": "string",
              "description": "Directory relative to the session workspace root, such as services/orders. Use '.' for the root. Not a file path, absolute path, glob, or package name. Parent traversal and non-canonical paths are rejected by server admission."
            },
            "include_subdirectories": {
              "type": "boolean",
              "description": "true includes the named directory and nested directories; false selects only the named directory."
            },
            "source_set_names": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "description": "Exact imported Gradle source-set name, such as main, integrationTest, or commonMain."
              },
              "minItems": 1,
              "maxItems": 1000,
              "description": "Omission or null selects the names main and test. Otherwise use exact imported Gradle source-set names, not paths, globs, or production/test categories. Empty and duplicate lists are rejected by server admission."
            }
          },
          "required": [
            "relative_directory_path",
            "include_subdirectories",
            "source_set_names"
          ],
          "additionalProperties": false
        },
        "PackageScope": {
          "type": "object",
          "properties": {
            "package_name": {
              "type": "string",
              "description": "Semantic Kotlin package name, such as com.example.orders. Not a filesystem path. Uses Kast's supported package-name grammar."
            },
            "include_subpackages": {
              "type": "boolean",
              "description": "true includes the named package and subpackages; false selects only the named package."
            },
            "source_set_names": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "description": "Exact imported Gradle source-set name, such as main, integrationTest, or commonMain."
              },
              "minItems": 1,
              "maxItems": 1000,
              "description": "Omission or null selects the names main and test. Otherwise use exact imported Gradle source-set names, not paths, globs, or production/test categories. Empty and duplicate lists are rejected by server admission."
            }
          },
          "required": [
            "package_name",
            "include_subpackages",
            "source_set_names"
          ],
          "additionalProperties": false
        },
        "SearchSource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "search_declarations"
              ]
            },
            "declaration_name": {
              "type": "string",
              "description": "Simple declaration name. Not a signature, source-text query, or qualified name."
            },
            "name_match": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "exact",
                "fuzzy",
                null
              ],
              "description": "Omission or null means exact, case-sensitive declaration-name matching. Exact matching returns every matching overload; it does not select one overload. Fuzzy matching requires explicit opt-in."
            },
            "declaration_kinds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "class",
                  "function",
                  "property",
                  "type_alias"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "description": "null includes all four supported declaration families. Supply a non-empty, non-duplicate list to restrict them. The class family means Kast's supported class-like declarations. Constructors are not included."
            },
            "scope": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DirectoryScope"
                },
                {
                  "$ref": "#/$defs/PackageScope"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Omission or null searches the session workspace recursively in source sets main and test. Otherwise choose one directory scope or one package scope. Source-set restrictions intersect with the chosen scope."
            }
          },
          "required": [
            "type",
            "declaration_name",
            "name_match",
            "declaration_kinds",
            "scope"
          ],
          "additionalProperties": false,
          "description": "Find declarations and establish exact symbol identities. Source scope restricts discovery only, not later expansion destinations."
        },
        "AllSource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "all_declarations"
              ]
            },
            "declaration_kinds": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "class",
                  "function",
                  "property",
                  "type_alias"
                ]
              },
              "minItems": 1,
              "maxItems": 4,
              "description": "null includes all four supported declaration families. Supply a non-empty, non-duplicate list to restrict them. The class family means Kast's supported class-like declarations. Constructors are not included."
            },
            "scope": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DirectoryScope"
                },
                {
                  "$ref": "#/$defs/PackageScope"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Omission or null searches the session workspace recursively in source sets main and test. Otherwise choose one directory scope or one package scope. Source-set restrictions intersect with the chosen scope."
            }
          },
          "required": [
            "type",
            "declaration_kinds",
            "scope"
          ],
          "additionalProperties": false,
          "description": "Enumerate declarations under existing bounded execution. All does not mean unlimited work or guaranteed complete coverage."
        },
        "ReferenceSource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "symbol_refs"
              ]
            },
            "symbol_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Opaque exact-symbol reference returned by Kast. Copy the token verbatim; do not construct, edit, or substitute a candidate reference."
              },
              "minItems": 1,
              "maxItems": 1000
            }
          },
          "required": [
            "type",
            "symbol_refs"
          ],
          "additionalProperties": false
        },
        "Output": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolsOutput"
            },
            {
              "$ref": "#/$defs/OccurrencesOutput"
            },
            {
              "$ref": "#/$defs/TraversalRecordsOutput"
            },
            {
              "$ref": "#/$defs/BindingRowsOutput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omission or null returns symbols with name and location. Choose occurrences, traversal_records, or binding_rows for their typed established evidence."
        },
        "ReadResultOutput": {
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolsOutput"
            },
            {
              "$ref": "#/$defs/BindingRowsOutput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present retained symbols or typed binding rows without rerunning stages. Omission or null selects symbol fields and rejects a retained binding-row result."
        },
        "SymbolsOutput": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "symbols"
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "location",
                  "signature",
                  "source"
                ]
              },
              "minItems": 0,
              "maxItems": 4,
              "description": "[] requests mandatory identity and kind only. Source adds a committed bounded source window."
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        },
        "OccurrencesOutput": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "occurrences"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "TraversalRecordsOutput": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "traversal_records"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Present each compiler-confirmed walk record with its hop depth and relation fact."
        },
        "Predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisibilityPredicate"
            },
            {
              "$ref": "#/$defs/PrimitivePredicate"
            }
          ],
          "description": "A closed predicate over compiler-grounded symbol facts."
        },
        "VisibilityPredicate": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "visibility"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "public",
                  "protected",
                  "internal",
                  "private",
                  "local"
                ]
              },
              "minItems": 1,
              "maxItems": 5,
              "description": "Keep symbols with one of these compiler-established visibilities. Duplicate values are rejected by server admission."
            }
          },
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false
        },
        "PrimitivePredicate": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "primitive"
              ]
            },
            "field": {
              "type": "string",
              "enum": [
                "name",
                "kind",
                "file"
              ],
              "description": "Compiler-grounded name, declaration kind, or stable file identity."
            },
            "operator": {
              "type": "string",
              "enum": [
                "equals",
                "not_equals",
                "starts_with",
                "ends_with"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "[\\s\\S]*\\S[\\s\\S]*",
              "description": "Nonblank literal compared with the selected compiler-grounded field."
            }
          },
          "required": [
            "type",
            "field",
            "operator",
            "value"
          ],
          "additionalProperties": false
        },
        "Where": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "where"
              ]
            },
            "predicate": {
              "$ref": "#/$defs/Predicate"
            }
          },
          "required": [
            "type",
            "predicate"
          ],
          "additionalProperties": false,
          "description": "Keep symbols satisfying one structured compiler-grounded predicate."
        },
        "ExpandRelation": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "expand_relation"
              ]
            },
            "relation": {
              "type": "string",
              "enum": [
                "references",
                "callers",
                "callees",
                "implementations",
                "inheritors",
                "overrides",
                "type_uses"
              ],
              "description": "One semantic hop. callers means declarations calling the current symbols; callees means declarations called by them. Choose output type occurrences to return individual relation facts, including repeated use sites."
            }
          },
          "required": [
            "type",
            "relation"
          ],
          "additionalProperties": false
        },
        "WalkDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum semantic hop depth; each walk remains bounded by the hosted traversal ceiling."
        },
        "WalkStrategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BreadthFirstStrategy"
            },
            {
              "$ref": "#/$defs/BoundedFanOutStrategy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Omission or null uses breadth-first exploration. Bounded fan-out keeps representative deeper paths and qualifies truncated coverage."
        },
        "BreadthFirstStrategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "breadth_first"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "BoundedFanOutStrategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "bounded_fan_out"
              ]
            },
            "maximumEdgesPerNode": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "type",
            "maximumEdgesPerNode"
          ],
          "additionalProperties": false
        },
        "Walk": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "walk"
              ]
            },
            "relation": {
              "type": "string",
              "enum": [
                "references",
                "callers",
                "callees",
                "implementations",
                "inheritors",
                "overrides",
                "type_uses"
              ]
            },
            "maximum_depth": {
              "$ref": "#/$defs/WalkDepth"
            },
            "strategy": {
              "$ref": "#/$defs/WalkStrategy"
            }
          },
          "required": [
            "type",
            "relation",
            "maximum_depth",
            "strategy"
          ],
          "additionalProperties": false,
          "description": "Traverse each input symbol through compiler-confirmed relations up to the requested depth. Existing traversal execution retains frontier, progress, strategy and partial-expansion evidence."
        },
        "DistinctSymbols": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "distinct_symbols"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Keep the first row and its evidence for each canonical symbol identity at this position."
        },
        "ProjectBinding": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "project_binding"
              ]
            },
            "name": {
              "$ref": "#/$defs/BindingName"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false,
          "description": "Select one named symbol cell from each retained or newly joined binding row before symbol stages continue."
        },
        "ExecutionBudget": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional execution allowances. Null or omitted dimensions use configured defaults; positive values are independently clamped to operator and transport ceilings. These controls do not alter query take, scope, or projection.",
          "properties": {
            "max_elapsed_ms": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_work_units": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "max_results": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 2147483647
            },
            "max_returned_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "max_elapsed_ms",
            "max_work_units",
            "max_results",
            "max_returned_bytes"
          ],
          "additionalProperties": false
        },
        "Concat": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "concat"
              ]
            },
            "input": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ReferenceSource"
                },
                {
                  "$ref": "#/$defs/ResultSource"
                }
              ],
              "description": "Append exact-symbol references or selected rows from one retained result, preserving stream order and multiplicity."
            }
          },
          "required": [
            "type",
            "input"
          ],
          "additionalProperties": false,
          "description": "Concatenate a typed input at this pipeline position. Later steps transform both streams."
        },
        "Intersect": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "intersect"
              ]
            },
            "right": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResultSource"
                }
              ]
            }
          },
          "required": [
            "type",
            "right"
          ],
          "additionalProperties": false,
          "description": "Keep left rows whose canonical semantic identity occurs in the retained right result."
        },
        "Union": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "union"
              ]
            },
            "right": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResultSource"
                }
              ]
            }
          },
          "required": [
            "type",
            "right"
          ],
          "additionalProperties": false,
          "description": "Form a set union by canonical semantic identity while retaining source qualification."
        },
        "Difference": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "difference"
              ]
            },
            "right": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResultSource"
                }
              ]
            }
          },
          "required": [
            "type",
            "right"
          ],
          "additionalProperties": false,
          "description": "Exclude right-hand canonical identities only when retained right coverage establishes absence."
        },
        "ResultReference": {
          "type": "string",
          "pattern": "^result:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Opaque retained-result reference returned by Kast. It is separate from an exact-symbol reference and an execution continuation."
        },
        "ResultRowReference": {
          "type": "string",
          "pattern": "^result-row:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Issued identity of one row in one retained result. Supply it with its owning result reference; restoration checks ownership."
        },
        "ResultCursor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000,
          "description": "Optional presentation offset in the immutable retained result. Omission or null starts at zero; this cursor does not resume semantic execution."
        },
        "ResultSource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "result"
              ]
            },
            "result": {
              "$ref": "#/$defs/ResultReference"
            },
            "row_ids": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/ResultRowReference"
              },
              "minItems": 0,
              "maxItems": 1000,
              "description": "Omission or null selects all rows. [] selects no rows. Otherwise select these issued rows, in order, from this result; a subset keeps its source qualification and cannot prove coverage of omitted rows."
            }
          },
          "required": [
            "type",
            "result",
            "row_ids"
          ],
          "additionalProperties": false,
          "description": "Seed a new pipeline from a retained immutable result or selected issued rows. The same semantic basis is checked when Kast restores it, including empty selections and incomplete-coverage qualification."
        },
        "RunAction": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "run"
              ]
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SearchSource"
                },
                {
                  "$ref": "#/$defs/AllSource"
                },
                {
                  "$ref": "#/$defs/LocationSource"
                },
                {
                  "$ref": "#/$defs/ReferenceSource"
                },
                {
                  "$ref": "#/$defs/ResultSource"
                }
              ],
              "description": "Starting declaration search, containing named declaration at file offset, exact-symbol references, or one retained result."
            },
            "steps": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Where"
                  },
                  {
                    "$ref": "#/$defs/ExpandRelation"
                  },
                  {
                    "$ref": "#/$defs/Walk"
                  },
                  {
                    "$ref": "#/$defs/DistinctSymbols"
                  },
                  {
                    "$ref": "#/$defs/ProjectBinding"
                  },
                  {
                    "$ref": "#/$defs/Concat"
                  },
                  {
                    "$ref": "#/$defs/Intersect"
                  },
                  {
                    "$ref": "#/$defs/Union"
                  },
                  {
                    "$ref": "#/$defs/Difference"
                  },
                  {
                    "$ref": "#/$defs/Join"
                  }
                ]
              },
              "minItems": 0,
              "maxItems": 1000,
              "description": "Ordered transformations executed left to right. null and [] mean no transformations. bind captures a symbol stream once; join references only an earlier bind or retained symbols. Inner join yields binding rows; project_binding selects one named cell before symbol stages continue. Semi and anti joins retain symbol rows; anti requires complete right coverage."
            },
            "output": {
              "$ref": "#/$defs/Output"
            },
            "retention": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "discard",
                "retain",
                null
              ],
              "description": "Omission or null discards the completed result after returning it. retain publishes an immutable bounded same-basis result reference; publication failure is reported without erasing the query result."
            },
            "execution_budget": {
              "$ref": "#/$defs/ExecutionBudget"
            }
          },
          "required": [
            "action",
            "source",
            "steps",
            "output",
            "retention",
            "execution_budget"
          ],
          "additionalProperties": false,
          "description": "Run a query from the supplied source and ordered steps. Retain the completed result only when requested."
        },
        "ResumeAction": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "resume"
              ]
            },
            "continuation": {
              "$ref": "#/$defs/ExecutionContinuation"
            },
            "execution_budget": {
              "$ref": "#/$defs/ExecutionBudget"
            }
          },
          "required": [
            "action",
            "continuation",
            "execution_budget"
          ],
          "additionalProperties": false,
          "description": "Continue the saved query execution without resending or rediscovering its completed prefix."
        },
        "ReadResultAction": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "read_result"
              ]
            },
            "result": {
              "$ref": "#/$defs/ResultReference"
            },
            "cursor": {
              "$ref": "#/$defs/ResultCursor"
            },
            "output": {
              "$ref": "#/$defs/ReadResultOutput"
            },
            "execution_budget": {
              "$ref": "#/$defs/ExecutionBudget"
            }
          },
          "required": [
            "action",
            "result",
            "cursor",
            "output",
            "execution_budget"
          ],
          "additionalProperties": false,
          "description": "Present an immutable retained result, starting at the supplied result cursor; this performs no query evaluation."
        },
        "ExecutionContinuation": {
          "type": "string",
          "pattern": "^(?:query|query-output):v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "Issued execution continuation for an unfinished query pipeline or retained transport output. Copy verbatim. A retained-result reference cannot resume execution."
        },
        "BindingName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
          "description": "One bounded query-local binding name. A bind name is unique and a join may refer only to an earlier bind."
        },
        "InnerJoinMode": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "inner"
              ]
            },
            "left_name": {
              "$ref": "#/$defs/BindingName"
            },
            "right_name": {
              "$ref": "#/$defs/BindingName"
            }
          },
          "required": [
            "type",
            "left_name",
            "right_name"
          ],
          "additionalProperties": false,
          "description": "Emit one typed binding row per matching pair. The two output column names must differ."
        },
        "SemiJoinMode": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "semi"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Keep left symbol rows with a matching right identity, preserving left multiplicity and evidence."
        },
        "AntiJoinMode": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "anti"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Keep left symbol rows only when complete right coverage proves no matching identity."
        },
        "Join": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "join"
              ]
            },
            "mode": {
              "anyOf": [
                {
                  "$ref": "#/$defs/InnerJoinMode"
                },
                {
                  "$ref": "#/$defs/SemiJoinMode"
                },
                {
                  "$ref": "#/$defs/AntiJoinMode"
                }
              ]
            },
            "right": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ResultSource"
                }
              ],
              "description": "Immutable retained symbol rows. A retained binding-row result is not a symbol right input."
            }
          },
          "required": [
            "type",
            "mode",
            "right"
          ],
          "additionalProperties": false,
          "description": "Join on canonical symbol identity. Inner emits typed paired rows; semi keeps proven matches; anti requires complete right coverage to establish absence."
        },
        "BindingRowsOutput": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "binding_rows"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Present both named symbol or exact-occurrence bindings in each inner-join pair, preserving multiplicity and evidence."
        },
        "LocationSource": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "at_location"
              ]
            },
            "file": {
              "type": "string",
              "description": "Canonical workspace-relative file path containing the offset."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "description": "UTF-16 offset inside the named declaration."
            }
          },
          "required": [
            "type",
            "file",
            "offset"
          ],
          "additionalProperties": false,
          "description": "Find the nearest named declaration containing this offset, then return its exact compiler-grounded symbol."
        }
      }
    },
    "strict": true
  }
]
