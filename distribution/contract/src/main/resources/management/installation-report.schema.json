{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.michne.com/schemas/installation-report.schema.json",
  "type": "object",
  "required": [
    "operation",
    "type",
    "activation",
    "semanticVersion",
    "installation",
    "controlSha256",
    "hostedPluginSha256",
    "ideaHome",
    "ideaLaunch",
    "changes",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "operation": {
      "const": "installation.install"
    },
    "type": {
      "enum": [
        "PLANNED",
        "INSTALLED",
        "ACTIVATED"
      ]
    },
    "activation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "planned",
                "not-requested",
                "ready"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "reason",
            "resume"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pending"
            },
            "reason": {
              "enum": [
                "EXIT_REJECTED",
                "DEADLINE_EXCEEDED",
                "IO_REJECTED",
                "INTERRUPTED"
              ]
            },
            "resume": {
              "const": "kast codex"
            }
          }
        }
      ]
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "installation": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "controlSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hostedPluginSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ideaHome": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "ideaLaunch": {
      "$ref": "#/$defs/SelectedIde"
    },
    "changes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "status": {
      "enum": [
        "planned",
        "installed",
        "installed-activation-pending"
      ]
    }
  },
  "$defs": {
    "SelectedIde": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "home",
            "bundle",
            "executable",
            "hostPluginTarget"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "resolved"
            },
            "home": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "bundle": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "executable": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "hostPluginTarget": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "UNRECORDED"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "root"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "RECORDED"
                    },
                    "root": {
                      "type": "string",
                      "pattern": "^/",
                      "maxLength": 4096
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "home",
            "bundle",
            "executable"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "resolved"
            },
            "home": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "bundle": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "executable": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "METADATA_UNAVAILABLE",
                "INVALID_METADATA",
                "SAVED_SELECTION_REJECTED",
                "UNSUPPORTED_PLATFORM_LINE",
                "MISSING_LAUNCHER",
                "AMBIGUOUS_LAUNCHER",
                "INVALID_LAUNCHER",
                "EXECUTABLE_UNAVAILABLE"
              ]
            }
          }
        }
      ]
    }
  }
}
