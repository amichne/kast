{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.michne.com/schemas/uninstall-retirement.schema.json",
  "title": "Kast uninstall retirement proof",
  "type": "object",
  "required": [
    "type",
    "installationRoot",
    "executable",
    "executableSha256",
    "channel",
    "managedRootIdentity",
    "recoveryProof",
    "controlIdentity",
    "product"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "REMOVAL_REQUESTED",
        "CONTROL_RETIRED",
        "EXTERNALS_CLEANED"
      ]
    },
    "installationRoot": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2,
      "maxLength": 4096
    },
    "executable": {
      "type": "string",
      "pattern": "^/",
      "minLength": 2,
      "maxLength": 4096
    },
    "executableSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "STABLE",
        "DEVELOPER"
      ]
    },
    "managedRootIdentity": {
      "$ref": "#/$defs/FilesystemIdentity"
    },
    "recoveryProof": {
      "$ref": "#/$defs/RecoveryProof"
    },
    "controlIdentity": {
      "$ref": "#/$defs/FilesystemIdentity"
    },
    "product": {
      "$ref": "#/$defs/ProductReference"
    }
  },
  "examples": [
    {
      "type": "REMOVAL_REQUESTED",
      "installationRoot": "/home/user/.local/share/kast",
      "executable": "/home/user/.local/bin/kast",
      "executableSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "channel": "STABLE",
      "managedRootIdentity": {
        "device": 1,
        "inode": 2,
        "owner": 501
      },
      "recoveryProof": {
        "type": "ABSENT_RECOVERY"
      },
      "controlIdentity": {
        "device": 1,
        "inode": 3,
        "owner": 501
      },
      "product": {
        "releaseTag": "v1.2.3",
        "publicVersion": "1.2.3",
        "version": "1.2.3",
        "sourceRevision": "0123456789abcdef0123456789abcdef01234567",
        "sourceTree": "89abcdef0123456789abcdef0123456789abcdef",
        "buildRecordSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "target": "macos-aarch64",
        "bundleSha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "qualificationSha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "runtimeRoot": "/home/user/.local/share/kast-runtimes/runtime",
        "runtimeArchiveSha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "runtimeManifestSha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "policy": "TrackStable",
        "schemaVersion": 1
      }
    },
    {
      "type": "CONTROL_RETIRED",
      "installationRoot": "/home/user/.local/share/kast",
      "executable": "/home/user/.local/bin/kast",
      "executableSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "channel": "STABLE",
      "managedRootIdentity": {
        "device": 1,
        "inode": 2,
        "owner": 501
      },
      "recoveryProof": {
        "type": "ABSENT_RECOVERY"
      },
      "controlIdentity": {
        "device": 1,
        "inode": 3,
        "owner": 501
      },
      "product": {
        "releaseTag": "v1.2.3",
        "publicVersion": "1.2.3",
        "version": "1.2.3",
        "sourceRevision": "0123456789abcdef0123456789abcdef01234567",
        "sourceTree": "89abcdef0123456789abcdef0123456789abcdef",
        "buildRecordSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "target": "macos-aarch64",
        "bundleSha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "qualificationSha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "runtimeRoot": "/home/user/.local/share/kast-runtimes/runtime",
        "runtimeArchiveSha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "runtimeManifestSha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "policy": "TrackStable",
        "schemaVersion": 1
      }
    },
    {
      "type": "EXTERNALS_CLEANED",
      "installationRoot": "/home/user/.local/share/kast",
      "executable": "/home/user/.local/bin/kast",
      "executableSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "channel": "STABLE",
      "managedRootIdentity": {
        "device": 1,
        "inode": 2,
        "owner": 501
      },
      "recoveryProof": {
        "type": "ABSENT_RECOVERY"
      },
      "controlIdentity": {
        "device": 1,
        "inode": 3,
        "owner": 501
      },
      "product": {
        "releaseTag": "v1.2.3",
        "publicVersion": "1.2.3",
        "version": "1.2.3",
        "sourceRevision": "0123456789abcdef0123456789abcdef01234567",
        "sourceTree": "89abcdef0123456789abcdef0123456789abcdef",
        "buildRecordSha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "target": "macos-aarch64",
        "bundleSha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "qualificationSha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "runtimeRoot": "/home/user/.local/share/kast-runtimes/runtime",
        "runtimeArchiveSha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "runtimeManifestSha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "policy": "TrackStable",
        "schemaVersion": 1
      }
    }
  ],
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ProductReference": {
      "type": "object",
      "required": [
        "releaseTag",
        "publicVersion",
        "version",
        "sourceRevision",
        "sourceTree",
        "buildRecordSha256",
        "target",
        "bundleSha256",
        "qualificationSha256",
        "runtimeRoot",
        "runtimeArchiveSha256",
        "runtimeManifestSha256",
        "policy",
        "schemaVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "releaseTag": {
          "type": "string",
          "minLength": 1
        },
        "publicVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1
        },
        "sourceTree": {
          "type": "string",
          "minLength": 1
        },
        "buildRecordSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "bundleSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "qualificationSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "runtimeRoot": {
          "type": "string",
          "pattern": "^/",
          "minLength": 2,
          "maxLength": 4096
        },
        "runtimeArchiveSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "runtimeManifestSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "policy": {
          "type": "string",
          "enum": [
            "TrackStable",
            "TrackMain",
            "PinnedBuild"
          ]
        },
        "schemaVersion": {
          "const": 1
        }
      }
    },
    "FilesystemIdentity": {
      "type": "object",
      "required": [
        "device",
        "inode",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "device": {
          "type": "integer",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "minimum": 0
        },
        "owner": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CapturedRecoveryFile": {
      "type": "object",
      "required": [
        "identity",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/FilesystemIdentity"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "RecoveryProof": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ABSENT_RECOVERY"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "installation",
            "installationIdentity",
            "recoveryDirectoryIdentity",
            "bundleIdentity",
            "receipt",
            "recoveryScript",
            "lifecycleScript"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ADMITTED_RECOVERY"
              ]
            },
            "installation": {
              "type": "string",
              "pattern": "^/",
              "minLength": 2,
              "maxLength": 4096
            },
            "installationIdentity": {
              "$ref": "#/$defs/FilesystemIdentity"
            },
            "recoveryDirectoryIdentity": {
              "$ref": "#/$defs/FilesystemIdentity"
            },
            "bundleIdentity": {
              "$ref": "#/$defs/FilesystemIdentity"
            },
            "receipt": {
              "$ref": "#/$defs/CapturedRecoveryFile"
            },
            "recoveryScript": {
              "$ref": "#/$defs/CapturedRecoveryFile"
            },
            "lifecycleScript": {
              "$ref": "#/$defs/CapturedRecoveryFile"
            },
            "journalScript": {
              "oneOf": [
                {
                  "$ref": "#/$defs/CapturedRecoveryFile"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "installation",
            "recoveryDirectoryIdentity"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "EMPTY_RECOVERY"
            },
            "installation": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "recoveryDirectoryIdentity": {
              "$ref": "#/$defs/FilesystemIdentity"
            }
          }
        }
      ]
    }
  }
}
