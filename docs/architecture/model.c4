model {
  developer = person "User or coding agent" {
    #public
    description "Invokes Kast and consumes typed compiler evidence."
    metadata {
      boundary "public"
      trust "caller"
    }
  }

  installer = adapter "install.sh bootstrap" {
    #adapter
    description "Delegates verified release activation to the private control plane."
    link https://github.com/amichne/kast/blob/main/install.sh "Source"
  }

  codexHooks = adapter "Agent harness hooks" {
    #adapter
    description "Translate harness events into public Kast commands."
    link https://github.com/amichne/kast/blob/main/cli-rs/src/interface/codex/hook/runtime.rs "Source"
  }

  runtimeLibraries = platform "Compatible IntelliJ runtime libraries" {
    #compiler
    description "A supported macOS installation supplies libraries; its foreground process is not a Kast authority."
    icon tech:intellij-idea
    metadata {
      supportedBuilds ["IDEA 262", "Android Studio 261"]
    }
  }

  kotlinCompiler = platform "Kotlin compiler stack" {
    #compiler
    description "Live PSI and K2 state queried through the Kotlin Analysis API."
    icon tech:kotlin

    psi = service "PSI" {
      #compiler #live
      description "KtFile trees, declarations, references, and edit state."
      technology "IntelliJ PSI"
    }

    analysisApi = contract "Analysis API" {
      #compiler #live
      description "KaSession boundary for symbols, types, calls, and diagnostics."
      technology "Kotlin Analysis API"
    }

    k2Frontend = service "K2 Frontend" {
      #compiler #live
      description "Semantic analysis, call resolution, and type inference."
      technology "K2"
    }

    fir = service "FIR semantic model" {
      #compiler #live
      description "Front-end Intermediate Representation below the public analysis boundary."
      technology "FIR"
    }
  }

  workspaceState = datastore "Workspace state" {
    #persisted
    description "Release receipt, exact-root descriptor, configuration, and local caches."
    metadata {
      identity "canonical workspace root"
      authority "active installation receipt"
    }
  }

  kast = platform "Kast" {
    #public #proof
    description "One typed command boundary and one exact-root indexer for compiler-backed Kotlin work."
    link https://github.com/amichne/kast "Repository"

    cli = executable "kast CLI" {
      #public
      technology "Rust + Clap"
      description "Parses public commands and dispatches typed command families."
      metadata {
        source "cli-rs/src/interface/cli/root.rs"
        output ["human", "TOON", "JSON compatibility"]
      }
      link https://github.com/amichne/kast/blob/main/cli-rs/src/interface/cli/root.rs "Source"
    }

    control = service "Exact-root admission" {
      technology "Rust"
      description "Reuses an eligible indexer or creates one isolated process."
      metadata {
        source "cli-rs/src/execution/runtime/backend/workspace_admission.rs"
        invariant "one canonical workspace identity"
      }
      link https://github.com/amichne/kast/blob/main/cli-rs/src/execution/runtime/backend/workspace_admission.rs "Source"
    }

    agent = service "Agent command dispatch" {
      #public
      technology "Rust"
      description "Normalizes commands into bounded requests with coverage evidence."
      metadata {
        source "cli-rs/src/agent/core/dispatch/commands.rs"
        request "AgentEnvelope"
      }
    }

    rpcClient = service "Indexer client" {
      technology "Rust + local socket"
      description "Validates the command catalog and exchanges typed JSON-RPC messages."
    }

    server = platform "Analysis server" {
      dispatcher = service "RpcAnalysisDispatcher" {
        technology "Kotlin coroutines"
        description "Validates envelopes and applies bounded timeouts."
        metadata {
          fqName "io.github.amichne.kast.server.dispatch.RpcAnalysisDispatcher"
        }
      }

      router = service "RpcMethodRouter" {
        technology "Kotlin"
        description "Checks capabilities and routes typed methods."
        metadata {
          fqName "io.github.amichne.kast.server.dispatch.RpcMethodRouter"
        }
      }

      orchestrator = service "SkillRpcOrchestrator" {
        technology "Kotlin"
        description "Runs compiler-backed discovery, navigation, and diagnostics."
        metadata {
          fqName "io.github.amichne.kast.server.SkillRpcOrchestrator"
        }
      }

      mutation = service "MutationExecutionService" {
        technology "Kotlin"
        description "Plans and applies semantic mutations with terminal validation."
      }
    }

    indexer = platform "Kast indexer" {
      #compiler #indexing
      description "The sole production owner of compiler analysis and persistent indexing."

      runtime = service "KastIndexerRuntime" {
        #trigger
        technology "Isolated IntelliJ process"
        description "Owns exact-root startup, Gradle import, and lifecycle."
        metadata {
          fqName "io.github.amichne.kast.indexer.KastIndexerRuntime"
          source "indexer/src/main/kotlin/io/github/amichne/kast/indexer/KastIndexerRuntime.kt"
        }
      }

      serverRuntime = service "IndexerServerRuntime" {
        technology "Kotlin"
        description "Binds the analysis server and persistent writer to the admitted process."
        metadata {
          fqName "io.github.amichne.kast.idea.IndexerServerRuntime"
        }
      }

      compiler = service "KastIndexerBackend" {
        #compiler
        technology "IntelliJ PSI + Kotlin K2"
        description "Implements compiler reads and writes inside the indexer."
        metadata {
          fqName "io.github.amichne.kast.idea.backend.KastIndexerBackend"
        }
      }

      admission = contract "Semantic admission" {
        #compiler #proof
        technology "Smart mode + PSI + Analysis API"
        description "Proves modules, classpaths, PSI, and compiler diagnostics."
      }

      refresh = service "Focused compiler refresh" {
        #compiler #trigger
        technology "VFS + Kotlin index + PSI"
        description "Refreshes selected paths and returns current admission evidence."
      }

      diagnostics = service "Compiler diagnostics" {
        #compiler #proof
        technology "PSI + Analysis API"
        description "Returns diagnostics with content and generation evidence."
      }

      projectIndexer = service "IdeaProjectIndexer" {
        #indexing
        technology "Kotlin coroutines"
        description "Builds inventory, then dependency-prioritized declarations and references."
      }

      sourceScanner = service "Identifier inventory scanner" {
        #indexing
        technology "PsiSourceIndexScanner"
        description "Retains identifiers, imports, packages, and Gradle ownership."
      }

      referenceIndexer = service "ReferenceIndexer" {
        #indexing
        technology "Bounded coroutine batches"
        description "Scans outside transactions and serializes successful SQLite writes."
      }

      referenceScanner = service "PSI reference resolver" {
        #compiler #indexing
        technology "PsiReferenceScanner"
        description "Resolves typed reference occurrences to exact declarations."
      }

      declarationScanner = service "PSI declaration scanner" {
        #compiler #indexing
        technology "Kotlin PSI"
        description "Extracts canonical declarations and supertypes."
      }

      graphExtractor = service "Semantic graph extractor" {
        #compiler #indexing
        technology "PSI + K2 Analysis API"
        description "Extracts symbols, types, calls, ownership, and edge occurrences."
      }

      graphWriter = service "SemanticGraphWriter" {
        #indexing
        technology "SQLite transaction"
        description "Replaces selected semantic_files and advances the shared generation."
      }

      snapshotCoordinator = service "Snapshot coordinator" {
        #indexing
        technology "Immutable base + overlay"
        description "Reuses compatible complete main indexes for worktrees."
      }

      refreshStatus = contract "refresh_status evidence" {
        #proof
        description "Per-path admission, diagnostics, counts, coverage, and generation."
      }
    }

    evidence = platform "Evidence and projection" {
      index = platform "SqliteSourceIndexStore" {
        #persisted #proof
        technology "SQLite WAL"
        description "Workspace-scoped inventory, references, graph facts, and snapshots."
        icon tech:sqlite

        writer = service "Serialized SQLite writer" {
          #persisted
          description "Keeps compiler scans outside transactions and serializes commits."
        }

        interning = service "StringInterningCodec cache" {
          #persisted
          technology "Path and FQN interning"
          description "Reloads when PRAGMA main.data_version proves an external commit."
        }

        inventory = datastore "Source inventory" {
          #persisted
          description "Paths, imports, hashes, and Gradle ownership."
        }

        relationships = datastore "Declarations and reference occurrences" {
          #persisted
          description "Canonical declarations, supertypes, and typed occurrences."
        }

        moduleProgress = datastore "Module progress" {
          #persisted #proof
          description "Pending, indexing, and complete state by module."
        }

        semanticGraph = datastore "Semantic graph facts" {
          #persisted #proof
          description "Symbols, types, annotations, and typed edge occurrences."
        }

        generation = datastore "Generation guard" {
          #persisted #proof
          description "Schema version and monotonically advancing generation."
        }

        snapshots = datastore "Repository snapshots" {
          #persisted
          description "Complete reusable main indexes and worktree overlays."
        }
      }

      projection = service "Typed result projection" {
        #proof
        technology "Rust and Kotlin serializers"
        description "Returns data with coverage, limitations, failures, and next actions."
      }
    }
  }

  developer -[call]-> kast.cli "invokes"
  installer -[control]-> kast.control "activates a verified release"
  codexHooks -[call]-> kast.cli "invokes after harness events"
  kast.cli -[call]-> kast.control "requests readiness"
  kast.cli -[call]-> kast.agent "dispatches semantic commands"
  kast.control -[control]-> workspaceState "reads and writes exact-root identity"
  kast.control -[call]-> runtimeLibraries "resolves compatible libraries"
  kast.control -[control]-> kast.indexer.runtime "reuses or creates"
  kast.indexer.runtime -[call]-> runtimeLibraries "loads compatible libraries"
  kast.indexer.runtime -[call]-> kast.indexer.serverRuntime "owns"
  kast.indexer.runtime -[call]-> kast.indexer.admission "settles semantic state"
  kast.indexer.serverRuntime -[call]-> kast.server.dispatcher "binds"
  kast.agent -[transport]-> kast.rpcClient "opens bounded request"
  kast.rpcClient -[transport]-> kast.server.dispatcher "sends JSON-RPC"
  kast.server.dispatcher -[call]-> kast.server.router "dispatches"
  kast.server.router -[call]-> kast.server.orchestrator "routes"
  kast.server.router -[call]-> kast.server.mutation "routes mutations"
  kast.server.mutation -[call]-> kast.server.orchestrator "resolves exact identity"
  kast.server.orchestrator -[call]-> kast.indexer.compiler "requests compiler work"
  kast.server.orchestrator -[refresh]-> kast.indexer.refresh "requests focused refresh"
  kast.server.orchestrator -[refresh]-> kast.indexer.graphExtractor "requests graph refresh"
  kast.indexer.compiler -[call]-> kotlinCompiler.psi "reads and writes PSI"
  kast.indexer.compiler -[call]-> kotlinCompiler.analysisApi "resolves semantics"
  kast.indexer.compiler -[evidence]-> kast.evidence.index "reads indexed facts"
  kast.indexer.compiler -[refresh]-> kast.indexer.refresh "refreshes changed paths"
  kast.indexer.refresh -[call]-> kast.indexer.diagnostics "collects diagnostics"
  kotlinCompiler.analysisApi -[call]-> kotlinCompiler.k2Frontend "runs K2"
  kotlinCompiler.k2Frontend -[call]-> kotlinCompiler.fir "evaluates FIR"
  kast.indexer.runtime -[call]-> kast.indexer.projectIndexer "starts indexing"
  kast.indexer.admission -[call]-> kast.indexer.projectIndexer "admits indexing"
  kast.indexer.projectIndexer -[call]-> kast.indexer.sourceScanner "builds inventory"
  kast.indexer.projectIndexer -[call]-> kast.indexer.referenceIndexer "builds references"
  kast.indexer.referenceIndexer -[call]-> kast.indexer.referenceScanner "resolves occurrences"
  kast.indexer.referenceIndexer -[call]-> kast.indexer.declarationScanner "extracts declarations"
  kast.indexer.projectIndexer -[evidence]-> kast.indexer.refreshStatus "publishes coverage"
  kast.indexer.diagnostics -[evidence]-> kast.indexer.refreshStatus "publishes diagnostics"
  kast.indexer.graphExtractor -[evidence]-> kast.indexer.refreshStatus "publishes graph coverage"
  kast.indexer.graphExtractor -[call]-> kotlinCompiler.analysisApi "extracts graph facts"
  kast.indexer.graphExtractor -[call]-> kast.indexer.graphWriter "submits replacements"
  kast.indexer.sourceScanner -[retain]-> kast.evidence.index.writer "submits inventory"
  kast.indexer.referenceIndexer -[retain]-> kast.evidence.index.writer "submits references"
  kast.indexer.graphWriter -[retain]-> kast.evidence.index.writer "submits graph facts"
  kast.indexer.snapshotCoordinator -[retain]-> kast.evidence.index.snapshots "publishes snapshots"
  kast.evidence.index.snapshots -[retain]-> kast.evidence.index.writer "hydrates state"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.interning "encodes paths and FQNs"
  kast.evidence.index.interning -[evidence]-> kast.evidence.index.generation "checks data version"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.inventory "commits inventory"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.relationships "commits references"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.semanticGraph "commits graph facts"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.moduleProgress "commits module state"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.generation "advances generation"
  kast.server.orchestrator -[evidence]-> kast.evidence.projection "returns typed result"
  kast.evidence.projection -[evidence]-> kast.cli "projects result"
}
