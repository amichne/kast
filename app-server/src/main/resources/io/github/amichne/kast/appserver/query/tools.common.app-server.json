{
  "type": "namespace",
  "name": "kast",
  "description": "Compiler-grounded Kotlin source intelligence from Kast.",
  "tools": [
    {
      "type": "function",
      "name": "query_symbols",
      "description": "Find exact Kotlin declarations with NAME, LOCATION, and SIGNATURE. Select the exact overload before relations or TRACE. Copy issued references unchanged. READ_RESULT and READ_SOURCE preserve original authority and freshness. This session exposes the common query grammar. Start a COMPLETE session for advanced operations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean"
          },
          "request": {
            "$ref": "#/$defs/Action"
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false,
        "$defs": {
          "Directory": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "DIRECTORY"
                ]
              },
              "relativeDirectoryPath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "includeSubdirectories": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "sourceSetNames": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576
                },
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "relativeDirectoryPath"
            ],
            "additionalProperties": false
          },
          "Package": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PACKAGE"
                ]
              },
              "packageName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "includeSubpackages": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "sourceSetNames": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576
                },
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "packageName"
            ],
            "additionalProperties": false
          },
          "Search": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SEARCH_DECLARATIONS"
                ]
              },
              "declarationName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "nameMatch": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "EXACT",
                  "FUZZY",
                  null
                ]
              },
              "declarationKinds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "CLASS",
                    "FUNCTION",
                    "PROPERTY",
                    "TYPE_ALIAS"
                  ]
                },
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true
              },
              "scope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Scope"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "declarationName"
            ],
            "additionalProperties": false
          },
          "ExactRefs": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SYMBOL_REFS"
                ]
              },
              "symbolRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1048576,
                  "pattern": "^exact:v[1-9][0-9]*:"
                },
                "minItems": 1,
                "maxItems": 1000
              }
            },
            "required": [
              "type",
              "symbolRefs"
            ],
            "additionalProperties": false
          },
          "Output": {
            "anyOf": [
              {
                "$ref": "#/$defs/Symbols"
              },
              {
                "$ref": "#/$defs/Occurrences"
              },
              {
                "type": "null"
              }
            ]
          },
          "ReadOutput": {
            "anyOf": [
              {
                "$ref": "#/$defs/Symbols"
              },
              {
                "$ref": "#/$defs/Occurrences"
              },
              {
                "type": "null"
              }
            ]
          },
          "Symbols": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SYMBOLS"
                ]
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "NAME",
                    "LOCATION",
                    "SIGNATURE",
                    "SOURCE"
                  ]
                },
                "minItems": 0,
                "maxItems": 4,
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "fields"
            ],
            "additionalProperties": false
          },
          "Occurrences": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "OCCURRENCES"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "Relation": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "EXPAND_RELATION"
                ]
              },
              "relation": {
                "type": "string",
                "enum": [
                  "REFERENCES",
                  "CALLERS",
                  "CALLEES",
                  "IMPLEMENTATIONS",
                  "INHERITORS",
                  "OVERRIDES",
                  "TYPE_USES"
                ]
              },
              "expansionScope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Expansion"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "relation"
            ],
            "additionalProperties": false
          },
          "ExecutionBudget": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "maxResults": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 2147483647
              },
              "maxReturnedBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807,
                "description": "Query minimum: 4096 UTF-8 bytes."
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "ResultRef": {
            "type": "string",
            "pattern": "^result:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "minLength": 46,
            "maxLength": 46
          },
          "RowCursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000
          },
          "EvidenceCursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000
          },
          "Run": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RUN"
                ]
              },
              "source": {
                "$ref": "#/$defs/Source"
              },
              "steps": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/Step"
                },
                "minItems": 0,
                "maxItems": 1000
              },
              "terminalStep": {
                "$ref": "#/$defs/Terminal"
              },
              "retention": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "DISCARD",
                  "RETAIN",
                  null
                ]
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "executionMode": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionMode"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "source",
              "terminalStep"
            ],
            "additionalProperties": false
          },
          "Resume": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RESUME"
                ]
              },
              "continuation": {
                "$ref": "#/$defs/OutputRef"
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "continuation"
            ],
            "additionalProperties": false
          },
          "ReadResultAction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "READ_RESULT"
                ]
              },
              "result": {
                "$ref": "#/$defs/ResultRef"
              },
              "cursor": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/RowCursor"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ReadOutput"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence_cursor": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/EvidenceCursor"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "detail": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Detail"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "result"
            ],
            "additionalProperties": false
          },
          "OutputRef": {
            "type": "string",
            "pattern": "^query-output:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "minLength": 52,
            "maxLength": 52
          },
          "Location": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "AT_LOCATION"
                ]
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "file",
              "offset"
            ],
            "additionalProperties": false
          },
          "Scope": {
            "anyOf": [
              {
                "$ref": "#/$defs/Directory"
              },
              {
                "$ref": "#/$defs/Package"
              },
              {
                "type": "null"
              }
            ]
          },
          "Source": {
            "anyOf": [
              {
                "$ref": "#/$defs/Search"
              },
              {
                "$ref": "#/$defs/Location"
              },
              {
                "$ref": "#/$defs/ExactRefs"
              }
            ]
          },
          "Step": {
            "anyOf": [
              {
                "$ref": "#/$defs/Relation"
              }
            ]
          },
          "Action": {
            "anyOf": [
              {
                "$ref": "#/$defs/Run"
              },
              {
                "$ref": "#/$defs/Resume"
              },
              {
                "$ref": "#/$defs/ReadResultAction"
              },
              {
                "$ref": "#/$defs/ReadSource"
              }
            ]
          },
          "ImpactWorkspaceDomain": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "WORKSPACE"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "ImpactRetainedDomain": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RETAINED_SEED"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "ImpactSourceDomain": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SOURCE_DOMAIN"
                ]
              },
              "sourceSets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true
              },
              "directory": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 4096
              },
              "includeSubdirectories": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "sourcePolicy": {
                "type": "string",
                "enum": [
                  "PRODUCTION_ONLY",
                  "TEST_ONLY",
                  "PRODUCTION_AND_TEST"
                ]
              },
              "generatedSources": {
                "type": "string",
                "enum": [
                  "EXCLUDE",
                  "INCLUDE"
                ]
              }
            },
            "required": [
              "type",
              "sourceSets",
              "sourcePolicy",
              "generatedSources"
            ],
            "additionalProperties": false
          },
          "Expansion": {
            "anyOf": [
              {
                "$ref": "#/$defs/ImpactWorkspaceDomain"
              },
              {
                "$ref": "#/$defs/ImpactRetainedDomain"
              },
              {
                "$ref": "#/$defs/ImpactSourceDomain"
              }
            ]
          },
          "SourceRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:(?:candidate|exact):(?:v4:[0-9a-f]{64}|v5:[A-Za-z0-9_-]{21}[AQgw]|v[23]:[A-Za-z0-9_-]+:[0-9a-f]{64})|source-selector-v[12]:[A-Za-z0-9_-]+:[0-9a-f]{64})$"
          },
          "ReadSource": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "READ_SOURCE"
                ]
              },
              "candidateRef": {
                "$ref": "#/$defs/SourceRef"
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "ANCHOR",
                  "CALLABLE_BODY",
                  "CLASS_BODY",
                  "FILE",
                  "ENCLOSING_DECLARATION",
                  "ENCLOSING_CALLABLE_BODY",
                  "ENCLOSING_CLASS_BODY",
                  null
                ]
              },
              "text": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Text"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "candidateRef"
            ],
            "additionalProperties": false
          },
          "Terminal": {
            "anyOf": [
              {
                "$ref": "#/$defs/Emit"
              },
              {
                "$ref": "#/$defs/Trace"
              }
            ]
          },
          "Emit": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "EMIT"
                ]
              },
              "output": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Output"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "TraceOutput": {
            "anyOf": [
              {
                "$ref": "#/$defs/Symbols"
              }
            ]
          },
          "Trace": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "TRACE"
                ]
              },
              "expansionScope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Expansion"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TraceOutput"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "FullText": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "COMPLETE"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "NoText": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "NONE"
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "TextWindow": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "WINDOW"
                ]
              },
              "beforeLines": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000
              },
              "afterLines": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "Text": {
            "anyOf": [
              {
                "$ref": "#/$defs/FullText"
              },
              {
                "$ref": "#/$defs/NoText"
              },
              {
                "$ref": "#/$defs/TextWindow"
              },
              {
                "$ref": "#/$defs/TextExcerpt"
              }
            ]
          },
          "TextExcerpt": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "EXCERPT"
                ]
              },
              "maxLines": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 1000
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "ExecutionMode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "RUNNER_CONTROLLED",
              null
            ]
          },
          "Section": {
            "type": "string",
            "enum": [
              "CANONICAL_ENTRY_JSON"
            ]
          },
          "Detail": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "result": {
                "$ref": "#/$defs/ResultRef"
              },
              "section": {
                "$ref": "#/$defs/Section"
              },
              "target": {
                "type": "string",
                "enum": [
                  "ROW",
                  "EVIDENCE"
                ]
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "kind": {
                "type": "string",
                "enum": [
                  "EXACT_SYMBOL",
                  "OCCURRENCE",
                  "REFERENCE_OCCURRENCE",
                  "TRAVERSAL_RECORD",
                  "BINDING_ROW",
                  "VALUE_PATH",
                  "IMPACT_WITNESS",
                  "FAILURE",
                  "OMISSION",
                  "WALK_OBSERVATION",
                  "REFERENCE_OBSERVATION",
                  "DISCOVERY_OBSERVATION",
                  "RELATION_OBSERVATION"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "minLength": 64,
                "maxLength": 64
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "result",
              "section",
              "target",
              "ordinal",
              "kind",
              "sha256",
              "offset"
            ],
            "additionalProperties": false
          }
        }
      },
      "deferLoading": true
    },
    {
      "type": "function",
      "name": "check_diagnostics",
      "description": "Check compiler diagnostics for a file or recursively beneath a directory in the session workspace. Use '.' explicitly for the workspace root. This is not symbol search and does not build the project. Results retain incomplete-coverage evidence; an incomplete empty result does not establish that the scope is clean. Requires the saved, indexed IntelliJ state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean",
            "default": false,
            "description": "Return execution diagnostics and redundant phase detail when true. Omitted or false returns compact semantic results, preserving qualifications, references, continuation and recovery evidence."
          },
          "relativePath": {
            "type": "string",
            "description": "File or directory path relative to the session workspace root, such as src/main/kotlin/orders/OrderService.kt or services/orders. Use '.' for the root. Not a package name, glob, absolute path, or parent traversal.",
            "minLength": 1,
            "maxLength": 1048576
          },
          "maxDiagnostics": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum diagnostic entries to return. Omission or null selects 100. This limits results, not module admission, indexing, or compiler work; incomplete coverage remains explicit.",
            "default": 100
          },
          "continuation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1048576,
            "description": "Opaque same-basis diagnostic continuation. Omit or use null to start. Resume the same relative_path; increase execution_budget if a grant cannot cross the enumeration prefix."
          },
          "executionBudget": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutionBudget"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "relativePath"
        ],
        "additionalProperties": false,
        "$defs": {
          "ExecutionBudget": {
            "type": [
              "object",
              "null"
            ],
            "description": "RUNNER_CONTROLLED has no implicit semantic work or time limit. It accepts an explicit timeout and output page controls. Legacy BOUNDED mode uses configured grants and ceilings.",
            "properties": {
              "maxElapsedMs": {
                "description": "Explicit timeout in milliseconds for RUNNER_CONTROLLED execution, including model capture. Omission adds no timeout. Legacy BOUNDED mode uses KAST_READ_SEMANTIC_MILLIS and host clamps.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maxWorkUnits": {
                "description": "Accounted work allowance. Query omission uses KAST_READ_SEMANTIC_WORK. Time and response size do not change this allowance.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maxResults": {
                "description": "In BOUNDED mode, this caps results. In RUNNER_CONTROLLED mode, this caps each output page.",
                "type": [
                  "integer",
                  "null"
