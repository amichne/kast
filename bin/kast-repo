"""Read declared repository surfaces from any working directory."""

import runpy
import sys
from pathlib import Path

sys.dont_write_bytecode = True

if __name__ == "__main__":
    runpy.run_path(
        str(Path(__file__).resolve().parents[1] / "docs/internal/navigation.py"),
        run_name="__main__",
    )
