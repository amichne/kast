#!/usr/bin/env bash
# shellcheck disable=SC2016 # Quoted commands expand in the later login shell.
set -euo pipefail
set -E

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"
[[ "$(uname -s)" == Linux ]] || { printf 'Orb setup requires Linux.\n' >&2; exit 1; }

step() {
    local label="$1" started=$SECONDS
    shift
    printf '\n[orb setup] %s\n' "$label"
    "$@"
    printf '[orb setup] %s finished in %ss\n' "$label" "$((SECONDS - started))"
}
trap 'printf "[orb setup] failed at line %s after %ss\n" "$LINENO" "$SECONDS" >&2' ERR

install_system_packages() {
    local package
    local -a missing=() elevate=()
    for package in ca-certificates curl git unzip zip build-essential zlib1g-dev pkg-config shellcheck; do
        if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        if ((EUID != 0)); then elevate=(sudo); fi
        "${elevate[@]}" apt-get update -qq
        "${elevate[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
    fi
}
step 'System packages' install_system_packages

export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null; then
    step 'Install mise' bash -c 'curl --fail --silent --show-error --location https://mise.run | sh'
fi
mise_bin="$(command -v mise)"
step 'Trust repository tool pins' "$mise_bin" trust "$repo_root/mise.toml"
# uv follows the CI pin; Java, Native Image, Node and Vale follow mise.toml.
step 'Install pinned tools' "$mise_bin" install uv@0.12.9
step 'Install repository tools' "$mise_bin" install
mise_environment="$("$mise_bin" env --shell bash uv@0.12.9)"
eval "$mise_environment"
step 'Install repository Python' uv python install --default "$(< .python-version)"

# Export the complete mise environment to later Amp and service login shells.
# Keep the hook scoped to this checkout and preserve the existing login profile.
mkdir -p "$HOME/.config/kast"
{
    printf '# Generated by Kast orb setup.\n'
    printf 'kast_orb_root=%q\n' "$repo_root"
    printf 'kast_orb_mise=%q\n' "$mise_bin"
    cat <<'ENVIRONMENT'
if [[ ( "$PWD" == "$kast_orb_root" || "$PWD" == "$kast_orb_root/"* ) && "${kast_orb_activated:-}" != "$kast_orb_root" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
    kast_orb_exports="$("$kast_orb_mise" -C "$kast_orb_root" env --shell bash uv@0.12.9)" || return 1
    eval "$kast_orb_exports"
    # This guard is shell-local: a new login shell must restore its own PATH.
    kast_orb_activated="$kast_orb_root"
    export KAST_ORB_ENV_ACTIVE="$kast_orb_root"
fi
unset kast_orb_root kast_orb_mise kast_orb_exports
ENVIRONMENT
} > "$HOME/.config/kast/orb-env.sh"
if [[ ! -f "$HOME/.bash_profile" ]]; then
    printf '[[ ! -f "$HOME/.profile" ]] || source "$HOME/.profile"\n' > "$HOME/.bash_profile"
fi
profile_hook='source "$HOME/.config/kast/orb-env.sh" # Kast orb environment'
if ! grep -Fqx "$profile_hook" "$HOME/.bash_profile"; then
    printf '\n%s\n' "$profile_hook" >> "$HOME/.bash_profile"
fi

# Use the build-owned environments so later Gradle checks reuse these installs.
step 'Schema test dependencies' python3 packaging/prepare-python-test-environment.py
step 'Documentation Python dependencies' env UV_PROJECT_ENVIRONMENT="$repo_root/build/documentation/python" \
    uv sync --locked --project docs/tooling --python "$(command -v python3)"
step 'Semantic coverage dependencies' uv sync --locked --project config/kotlin-semantic-coverage/tooling \
    --python "$(command -v python3)"
step 'Documentation Markdown dependencies' npm ci --ignore-scripts --engine-strict --prefix docs/tooling/markdown
if ! command -v mint >/dev/null || [[ "$(mint --version)" != 4.2.841 ]]; then
    step 'Mintlify CLI (CI pin)' npm install --global mint@4.2.841
fi

# Resolve external artifacts without building the product or executing tests.
# Project artifacts are excluded: their producers belong to subsequent builds.
dependency_init="$(mktemp --suffix=.gradle)"
trap 'rm -f -- "$dependency_init"' EXIT
cat > "$dependency_init" <<'GRADLE'
import org.gradle.api.artifacts.component.ModuleComponentIdentifier

gradle.projectsEvaluated {
    rootProject.allprojects.each { owner ->
        owner.tasks.register('prepareOrbDependencies') {
            doLast {
                // Warm JVM build/test tools, not unused Kotlin/Native commonizers.
                owner.configurations.findAll {
                    it.canBeResolved && it.name.matches(
                        '.*[cC]ompileClasspath|.*[rR]untimeClasspath|detekt|detektPlugins|' +
                        'kotlinCompiler.*Classpath.*|kotlinBuildTools.*Classpath|.*IdeaDistribution|jsonContractParser'
                    )
                }.each { configuration ->
                    logger.lifecycle("[orb setup] Resolving ${owner.path}:${configuration.name}")
                    configuration.incoming.artifactView {
                        componentFilter { it instanceof ModuleComponentIdentifier }
                    }.files.files
                }
            }
        }
    }
    rootProject.tasks.named('prepareOrbDependencies') {
        dependsOn(rootProject.subprojects.collect { it.tasks.named('prepareOrbDependencies') })
    }
}
GRADLE
step 'Gradle dependencies and IDE compile SDKs' ./gradlew --no-daemon --console=plain \
    --no-configuration-cache --max-workers=2 -Dorg.gradle.jvmargs=-Xmx3g \
    --init-script "$dependency_init" prepareOrbDependencies \
    :workspace:intellij-read:extractWorkspaceReadIdeaDistribution \
    :symbol:intellij:extractSymbolIdeaDistribution :diagnostic:intellij:extractDiagnosticKotlinPlugin \
    :topology:intellij:extractTopologyKotlinPlugin :relation:intellij:extractRelationKotlinPlugin

step 'Verify persisted login environment' env -i HOME="$HOME" USER="$(id -un)" PATH=/usr/bin:/bin \
    /bin/bash -lc 'set -euo pipefail; test "$KAST_ORB_ENV_ACTIVE" = "$PWD"; test "$JAVA_HOME" = "$GRAALVM_HOME"; for tool in java native-image node npm vale uv python3 mint; do command -v "$tool"; done'
printf '\n[orb setup] Ready in %ss. Native macOS installation and IDEA UI acceptance require a Mac.\n' "$SECONDS"
