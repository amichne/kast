{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kast",
  "description": "Compiler-grounded Kotlin search for coding agents.",
  "colors": {
    "primary": "#3154C7",
    "light": "#27439F",
    "dark": "#8FA7FF"
  },
  "fonts": {
    "family": "SUSE"
  },
  "logo": "/images/kast-mark.svg",
  "favicon": "/images/kast-mark.svg",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FBFBF9",
      "dark": "#171816"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Use Kast",
        "groups": [
          {
            "group": "Start here",
            "icon": "rocket",
            "pages": [
              "index",
              "start"
            ]
          },
          {
            "group": "Search",
            "icon": "scan-search",
            "pages": [
              "search"
            ]
          },
          {
            "group": "Integrate",
            "icon": "bot",
            "pages": [
              "agent-harnesses"
            ]
          },
          {
            "group": "Callable reference",
            "icon": "square-function",
            "openapi": "reference/callables.openapi.json"
          },
          {
            "group": "Support",
            "icon": "life-buoy",
            "pages": [
              "troubleshooting",
              "concepts/evidence-boundaries",
              "reference/compatibility",
              "concepts/runtime-integration-validation"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/amichne/kast"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install Kast",
      "href": "/start"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amichne/kast"
    },
    "links": [
      {
        "header": "Use Kast",
        "items": [
          {
            "label": "Install and connect",
            "href": "/start"
          },
          {
            "label": "Agent harnesses",
            "href": "/agent-harnesses"
          }
        ]
      },
      {
        "header": "Support",
        "items": [
          {
            "label": "Troubleshooting",
            "href": "/troubleshooting"
          },
          {
            "label": "Evidence outcomes",
            "href": "/concepts/evidence-boundaries"
          }
        ]
      },
      {
        "header": "Source",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/amichne/kast"
          },
          {
            "label": "Security",
            "href": "https://github.com/amichne/kast/security"
          }
        ]
      }
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "autogenerate": false
    }
  },
  "search": {
    "prompt": "Search setup, harnesses, and errors"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The requested Kast documentation page does not exist. Return to the [documentation home](/)."
    }
  }
}
