 class CheckoutEndpoint(private val pricing: Pricing) {
     fun quote(request: CheckoutRequest): QuoteResult =
         when (request.mode) {
             "home" -> pricing.quote(request.basket, request.destination, DeliveryOption.Home)
+            "locker" -> {
+                val id = request.lockerId
+                val zone = request.lockerZone
+                if (id.isNullOrBlank() || zone == null) {
+                    QuoteResult.Unavailable(QuoteFailure.MISSING_LOCKER)
+                } else {
+                    pricing.quote(request.basket, request.destination, DeliveryOption.Locker(id, zone))
+                }
+            }
             else -> QuoteResult.Unavailable(QuoteFailure.UNSUPPORTED_MODE)
         }
 }
