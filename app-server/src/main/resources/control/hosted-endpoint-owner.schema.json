{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/control/hosted-endpoint-owner/v1",
  "title": "Recorded project endpoint owner",
  "description": "Control-local owner selection only. Protocol, operations, and query schema are structural evidence; this shape never admits their compatibility. Alive owners must pass the complete current hosted endpoint schema and live describe admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol",
    "root",
    "socket",
    "hostPid",
    "operations",
    "host",
    "querySchema"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "KAST_IDE_ENDPOINT"
      ],
      "examples": [
        "KAST_IDE_ENDPOINT"
      ]
    },
    "protocol": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "examples": [
        3
      ]
    },
    "root": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096,
      "examples": [
        "/workspace/project"
      ]
    },
    "socket": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 100,
      "examples": [
        "/home/.kast/ide-hosted/root/host.sock"
      ]
    },
    "hostPid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "examples": [
        123
      ]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "examples": [
          "DESCRIBE"
        ]
      },
      "examples": [
        [
          "DESCRIBE"
        ]
      ]
    },
    "host": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "examples": [
        "00000000-0000-0000-0000-000000000001"
      ]
    },
    "querySchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "examples": [
        "kast.query.run.v7"
      ]
    }
  },
  "examples": [
    {
      "type": "KAST_IDE_ENDPOINT",
      "protocol": 3,
      "root": "/workspace/project",
      "socket": "/home/.kast/ide-hosted/root/host.sock",
      "hostPid": 123,
      "operations": [
        "DESCRIBE"
      ],
      "host": "00000000-0000-0000-0000-000000000001",
      "querySchema": "kast.query.run.v7"
    }
  ]
}
