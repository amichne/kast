global {
  styleGroup semantic-boundaries {
    style element.tag = #public {
      color primary
      border solid
    }
    style element.tag = #compiler {
      color indigo
    }
    style element.tag = #persisted {
      color green
    }
    style element.tag = #proof {
      border dashed
    }
    style element.tag = #live {
      color sky
    }
    style element.tag = #trigger {
      color amber
      border dotted
    }
    style element.tag = #indexing {
      color blue
    }
    style element.tag = #adapter {
      color muted
      opacity 70%
    }
  }
}

views {
  view system-landscape {
    title "Kast system landscape"
    description "Public callers and adapters enter one Kast boundary; compiler and workspace state remain explicit dependencies."
    include *
    global style semantic-boundaries
    style kast {
      color primary
      size xl
    }
    autoLayout LeftRight 140 100
  }

  view runtime-components of kast {
    title "Kast runtime components"
    description "Drill into CLI dispatch, runtime admission, server routing, compiler backend, and proof-carrying output."
    include *
    include kast.server.*
    include kast.backend.*
    include kast.evidence.*
    global style semantic-boundaries
    style kast.server, kast.backend, kast.evidence {
      color secondary
    }
    autoLayout LeftRight 110 70
  }

  view compiler-evidence {
    title "Compiler evidence pipeline"
    description "Exact request path from the public CLI to compiler semantics, persisted facts, and typed result projection."
    include developer
    include kast.cli
    include kast.agent
    include kast.rpcClient
    include kast.server.dispatcher
    include kast.server.router
    include kast.server.orchestrator
    include kast.backend.api
    include kast.backend.headless
    include kast.backend.idea
    include kotlinCompiler
    include kast.evidence.index
    include kast.evidence.projection
    global style semantic-boundaries
    style kast.backend.api, kast.backend.headless, kast.backend.idea, kotlinCompiler {
      color indigo
    }
    style kast.evidence.index, kast.evidence.projection {
      color green
    }
    autoLayout LeftRight 90 60
  }

  view public-entrypoints {
    title "Public entry points"
    description "The installer and Codex hooks are adapters; `kast` remains the only public command contract."
    include developer
    include installer
    include codexHooks
    include kast.cli
    include kast.control
    include kast.agent
    global style semantic-boundaries
    autoLayout LeftRight 120 80
  }

  view indexing-landscape {
    title "Indexing / Landscape"
    description "Private headless IntelliJ and Kotlin state feeds two independently refreshed, generation-bound SQLite products."
    include developer
    include codexHooks
    include kast.cli
    include kast.control
    include kast.backend.headless
    include kast.backend.idea
    include ideaPlatform
    include kotlinCompiler
    include kast.indexing
    include kast.evidence.index
    exclude kast.backend.idea -> kast.evidence.index
    global style semantic-boundaries
    style ideaPlatform, kotlinCompiler, kast.backend.headless, kast.backend.idea {
      color indigo
    }
    style kast.indexing {
      color blue
      size xl
    }
    style kast.evidence.index {
      color green
      size xl
    }
    autoLayout LeftRight 120 80
  }

  dynamic view indexing-guide {
    title "Indexing / Explore the pipelines"
    description "Start high-level, then follow the interaction into exact headless bootstrap, SQLite, or refresh sequence."

    kast.control -> kast.indexing.projectOpen "starts exact-root headless indexing" {
      navigateTo reference-indexing
    }
    kast.agent -> kast.evidence.index "queries retained generation-bound evidence" {
      navigateTo sqlite-pipeline
    }
    codexHooks -> kast.cli "refreshes focused Kotlin evidence after a successful write" {
      navigateTo refresh-lifecycle
    }
  }

  view headless-semantic-pipeline {
    title "Headless / Live semantic pipeline"
    description "Private headless IntelliJ admission reaches PSI, the Analysis API, K2, and FIR; consumers retain provider-neutral facts, never compiler objects."

    include kast.backend.headless
    include kast.backend.idea
    include kast.backend.ideaAdmission
    include kast.backend.ideaRefresh
    include kast.backend.ideaDiagnostics
    include ideaPlatform.*
    include kotlinCompiler.*
    include kast.indexing.referenceScanner
    include kast.indexing.declarationScanner
    include kast.indexing.graphExtractor
    include kast.indexing.refreshStatus

    global style semantic-boundaries
    style ideaPlatform.*, kotlinCompiler.* {
      color indigo
    }
    style kast.indexing.referenceScanner, kast.indexing.declarationScanner, kast.indexing.graphExtractor {
      color blue
    }
    autoLayout LeftRight 100 70
  }

  view retained-evidence {
    title "SQLite / Retained evidence"
    description "One WAL database stores separately refreshed inventory, references, semantic graph facts, generations, and reusable snapshots."

    include kast.indexing.sourceScanner
    include kast.indexing.referenceIndexer
    include kast.indexing.graphWriter
    include kast.indexing.snapshotCoordinator
    include kast.evidence.index.writer
    include kast.evidence.index.interning
    include kast.evidence.index.inventory
    include kast.evidence.index.relationships
    include kast.evidence.index.moduleProgress
    include kast.evidence.index.semanticGraph
    include kast.evidence.index.generation
    include kast.evidence.index.snapshots
    include kast.indexing.referenceLookup
    include kotlinCompiler.psi
    include kast.evidence.projection

    global style semantic-boundaries
    style kast.evidence.index.* {
      color green
    }
    style kast.indexing.sourceScanner, kast.indexing.referenceIndexer, kast.indexing.graphWriter {
      color blue
    }
    style kotlinCompiler.psi {
      color indigo
    }
    autoLayout LeftRight 105 70
  }
}
