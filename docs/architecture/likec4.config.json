{
  "$schema": "https://likec4.dev/schemas/config.json",
  "name": "kast-architecture",
  "title": "Kast Architecture",
  "metadata": {
    "owner": "Kast maintainers",
    "domain": "compiler-backed Kotlin tooling"
  },
  "styles": {
    "theme": {
      "colors": {
        "primary": "#2563EB",
        "secondary": "#7C3AED",
        "indigo": "#4F46E5",
        "green": "#059669",
        "amber": "#D97706",
        "muted": "#64748B"
      }
    },
    "defaults": {
      "group": {
        "color": "slate",
        "opacity": 8,
        "border": "solid"
      },
      "relationship": {
        "color": "slate",
        "line": "solid",
        "arrow": "vee"
      }
    }
  },
  "implicitViews": true,
  "landingPage": {
    "include": [
      "system-landscape",
      "runtime-components",
      "compiler-evidence",
      "indexing-landscape",
      "indexing-guide",
      "indexer-pipeline",
      "retained-evidence",
      "indexer-runtime",
      "indexer-admission",
      "compiler-read",
      "semantic-mutation",
      "reference-indexing",
      "sqlite-pipeline",
      "refresh-lifecycle"
    ]
  }
}
