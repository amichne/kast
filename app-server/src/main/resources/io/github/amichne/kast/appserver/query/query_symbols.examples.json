{
  "examples": {
    "runByName": {
      "summary": "Find declarations by exact name.",
      "value": {
        "request": {
          "type": "RUN",
          "source": {
            "type": "SEARCH_DECLARATIONS",
            "declarationName": "Order"
          }
        }
      }
    },
    "scopedExactDeclaration": {
      "summary": "Find a class by exact simple name in one package and source set, including its committed source context.",
      "value": {
        "request": {
          "type": "RUN",
          "source": {
            "type": "SEARCH_DECLARATIONS",
            "declarationName": "OrderService",
            "declarationKinds": [
              "CLASS"
            ],
            "scope": {
              "type": "PACKAGE",
              "packageName": "com.example.orders",
              "includeSubpackages": false,
              "sourceSetNames": [
                "main"
              ]
            }
          },
          "output": {
            "type": "SYMBOLS",
            "fields": [
              "NAME",
              "LOCATION",
              "SIGNATURE",
              "SOURCE"
            ]
          },
          "executionBudget": {
            "maxResults": 20
          }
        }
      }
    },
    "publicFunctionInventory": {
      "summary": "List public functions with a known name prefix in one module directory; strict execution proves the full answer before returning a bounded presentation.",
      "value": {
        "request": {
          "type": "RUN",
          "source": {
            "type": "ALL_DECLARATIONS",
            "declarationKinds": [
              "FUNCTION"
            ],
            "scope": {
              "type": "DIRECTORY",
              "relativeDirectoryPath": "services/orders",
              "includeSubdirectories": true,
              "sourceSetNames": [
                "main"
              ]
            }
          },
          "steps": [
            {
              "type": "WHERE",
              "predicate": {
                "type": "VISIBILITY",
                "values": [
                  "PUBLIC"
                ]
              }
            },
            {
              "type": "WHERE",
              "predicate": {
                "type": "PRIMITIVE",
                "field": "NAME",
                "operator": "STARTS_WITH",
                "value": "create"
              }
            }
          ],
          "output": {
            "type": "SYMBOLS",
            "fields": [
              "NAME",
              "LOCATION",
              "SIGNATURE"
            ]
          },
          "executionBudget": {
            "maxResults": 50
          }
        }
      }
    },
