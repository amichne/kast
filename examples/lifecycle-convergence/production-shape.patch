@@
+    // Before IntelliJ project/Gradle networking is initialized:
+    // 1. parse effective Gradle TLS/proxy configuration using a closed property set;
+    // 2. discover admitted donor JVM + IntelliJ certificate stores;
+    // 3. materialize a cache-owned certificate-only PKCS12 store;
+    // 4. install resolved JSSE/proxy System properties once;
+    // 5. retain typed provenance for startup diagnostics without secrets.
+    val network = InstalledNetworkBootstrap.prepare(...)
+    when (network) {
+        is InstalledNetworkBootstrap.Prepared -> network.install()
+        is InstalledNetworkBootstrap.Rejected -> rejectBootstrap(network.failure)
+    }

# Gradle Tooling API documents that client system properties are propagated to the build by default.
# This deliberately uses that channel rather than JAVA_TOOL_OPTIONS/JDK_JAVA_OPTIONS. If effective
# Gradle configuration explicitly declares a truststore, the resolver uses that authority and does
# not overwrite it with a derived store.

