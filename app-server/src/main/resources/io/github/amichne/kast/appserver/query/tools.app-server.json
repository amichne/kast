{
  "type": "namespace",
  "name": "kast",
  "description": "Compiler-grounded Kotlin source intelligence from Kast.",
  "tools": [
    {
      "type": "function",
      "name": "query_symbols",
      "description": "Run, resume, and read one compositional compiler-grounded Kotlin symbol query. For exact name search, use {\"request\":{\"type\":\"RUN\",\"source\":{\"type\":\"SEARCH_DECLARATIONS\",\"declarationName\":\"Order\"}}}; source is directly inside request. For one-hop references, add \"steps\":[{\"type\":\"WALK\",\"relation\":\"REFERENCES\",\"maximumDepth\":1}] inside RUN. To keep the result, set request.retention to RETAIN; then page its returned reference with request.type READ_RESULT and request.result. Resume execution with request.type RESUME and its exact continuation. Apply structured predicates, relation expansion, bounded walk, set composition, and retained binding projection and joins. Join preserves both named output cells and occurrence evidence; anti-join requires complete right coverage. Choose symbol, occurrence, traversal record, or binding row output. Retained results preserve qualification and omissions; execution continuation and result presentation cursor remain distinct.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean",
            "default": false,
            "description": "Return execution diagnostics and redundant phase detail when true. Omitted or false returns compact semantic results, preserving qualifications, references, continuation and recovery evidence."
          },
          "request": {
            "$ref": "#/$defs/Action",
            "description": "Exactly one closed query action: run, resume, or read_result."
          }
        },
        "required": [
          "request"
        ],
        "additionalProperties": false,
        "$defs": {
          "DirectoryScope": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "DIRECTORY"
                ],
                "default": "DIRECTORY"
              },
              "relativeDirectoryPath": {
                "type": "string",
                "description": "Directory relative to the session workspace root, such as services/orders. Use '.' for the root. Not a file path, absolute path, glob, or package name. Parent traversal and non-canonical paths are rejected by server admission.",
                "minLength": 1,
                "maxLength": 1048576
              },
              "includeSubdirectories": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "true includes the named directory and nested directories; false selects only the named directory.",
                "default": true
              },
              "sourceSetNames": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "description": "Exact imported Gradle source-set name, such as main, integrationTest, or commonMain.",
                  "minLength": 1,
                  "maxLength": 1048576
                },
                "minItems": 1,
                "maxItems": 1000,
                "description": "Omission or null selects the names main and test. Otherwise use exact imported Gradle source-set names, not paths, globs, or production/test categories. Empty and duplicate lists are rejected by server admission.",
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "relativeDirectoryPath"
            ],
            "additionalProperties": false
          },
          "PackageScope": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PACKAGE"
                ],
                "default": "PACKAGE"
              },
              "packageName": {
                "type": "string",
                "description": "Semantic Kotlin package name, such as com.example.orders. Not a filesystem path. Uses Kast's supported package-name grammar.",
                "minLength": 1,
                "maxLength": 1048576
              },
              "includeSubpackages": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "true includes the named package and subpackages; false selects only the named package.",
                "default": true
              },
              "sourceSetNames": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "description": "Exact imported Gradle source-set name, such as main, integrationTest, or commonMain.",
                  "minLength": 1,
                  "maxLength": 1048576
                },
                "minItems": 1,
                "maxItems": 1000,
                "description": "Omission or null selects the names main and test. Otherwise use exact imported Gradle source-set names, not paths, globs, or production/test categories. Empty and duplicate lists are rejected by server admission.",
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "packageName"
            ],
            "additionalProperties": false
          },
          "SearchSource": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SEARCH_DECLARATIONS"
                ],
                "default": "SEARCH_DECLARATIONS"
              },
              "declarationName": {
                "type": "string",
                "description": "Simple declaration name. Not a signature, source-text query, or qualified name.",
                "minLength": 1,
                "maxLength": 256
              },
              "nameMatch": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "EXACT",
                  "FUZZY",
                  null
                ],
                "description": "Omission or null means exact, case-sensitive declaration-name matching. Exact matching returns every matching overload; it does not select one overload. Fuzzy matching requires explicit opt-in."
              },
              "declarationKinds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "CLASS",
                    "FUNCTION",
                    "PROPERTY",
                    "TYPE_ALIAS"
                  ]
                },
                "minItems": 1,
                "maxItems": 4,
                "description": "null includes all four supported declaration families. Supply a non-empty, non-duplicate list to restrict them. The class family means Kast's supported class-like declarations. Constructors are not included.",
                "uniqueItems": true
              },
              "scope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Scope",
                    "description": "Omission or null searches the session workspace recursively in source sets main and test. Otherwise choose one directory scope or one package scope. Source-set restrictions intersect with the chosen scope."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "declarationName"
            ],
            "additionalProperties": false,
            "description": "Find declarations and establish exact symbol identities. Source scope restricts discovery only, not later expansion destinations."
          },
          "AllSource": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ALL_DECLARATIONS"
                ],
                "default": "ALL_DECLARATIONS"
              },
              "declarationKinds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "enum": [
                    "CLASS",
                    "FUNCTION",
                    "PROPERTY",
                    "TYPE_ALIAS"
                  ]
                },
                "minItems": 1,
                "maxItems": 4,
                "description": "null includes all four supported declaration families. Supply a non-empty, non-duplicate list to restrict them. The class family means Kast's supported class-like declarations. Constructors are not included.",
                "uniqueItems": true
              },
              "scope": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Scope",
                    "description": "Omission or null searches the session workspace recursively in source sets main and test. Otherwise choose one directory scope or one package scope. Source-set restrictions intersect with the chosen scope."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Enumerate declarations under existing bounded execution. All does not mean unlimited work or guaranteed complete coverage."
          },
          "ReferenceSource": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SYMBOL_REFS"
                ],
                "default": "SYMBOL_REFS"
              },
              "symbolRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Opaque exact-symbol reference returned by Kast. Copy the token verbatim; do not construct, edit, or substitute a candidate reference.",
                  "minLength": 1,
                  "maxLength": 1048576
                },
                "minItems": 1,
                "maxItems": 1000
              }
            },
            "required": [
              "type",
              "symbolRefs"
            ],
            "additionalProperties": false
          },
          "Output": {
            "anyOf": [
              {
                "$ref": "#/$defs/SymbolsOutput"
              },
              {
                "$ref": "#/$defs/OccurrencesOutput"
              },
              {
                "$ref": "#/$defs/TraversalRecordsOutput"
              },
              {
                "$ref": "#/$defs/BindingRowsOutput"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omission or null returns symbols with name and location. Choose occurrences, traversal_records, or binding_rows for their typed established evidence."
          },
          "ReadResultOutput": {
            "anyOf": [
              {
                "$ref": "#/$defs/SymbolsOutput"
              },
              {
                "$ref": "#/$defs/BindingRowsOutput"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present retained symbols or typed binding rows without rerunning stages. Omission or null selects symbol fields and rejects a retained binding-row result."
          },
          "SymbolsOutput": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SYMBOLS"
                ],
                "default": "SYMBOLS"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "NAME",
                    "LOCATION",
                    "SIGNATURE",
                    "SOURCE"
                  ]
                },
                "minItems": 0,
                "maxItems": 4,
                "uniqueItems": true,
                "description": "[] requests mandatory identity and kind only. Source adds a committed bounded source window."
              }
            },
            "required": [
              "type",
              "fields"
            ],
            "additionalProperties": false
          },
          "OccurrencesOutput": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "OCCURRENCES"
                ],
                "default": "OCCURRENCES"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "TraversalRecordsOutput": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "TRAVERSAL_RECORDS"
                ],
                "default": "TRAVERSAL_RECORDS"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Present each compiler-confirmed walk record with its hop depth and relation fact."
          },
          "Predicate": {
            "anyOf": [
              {
                "$ref": "#/$defs/VisibilityPredicate"
              },
              {
                "$ref": "#/$defs/PrimitivePredicate"
              }
            ],
            "description": "A closed predicate over compiler-grounded symbol facts."
          },
          "VisibilityPredicate": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "VISIBILITY"
                ],
                "default": "VISIBILITY"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "PUBLIC",
                    "PROTECTED",
                    "INTERNAL",
                    "PRIVATE",
                    "LOCAL"
                  ]
                },
                "minItems": 1,
                "maxItems": 5,
                "description": "Keep symbols with one of these compiler-established visibilities. Duplicate values are rejected by server admission.",
                "uniqueItems": true
              }
            },
            "required": [
              "type",
              "values"
            ],
            "additionalProperties": false
          },
          "PrimitivePredicate": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PRIMITIVE"
                ],
                "default": "PRIMITIVE"
              },
              "field": {
                "type": "string",
                "enum": [
                  "NAME",
                  "KIND",
                  "FILE"
                ],
                "description": "Compiler-grounded name, declaration kind, or stable file identity."
              },
              "operator": {
                "type": "string",
                "enum": [
                  "EQUALS",
                  "NOT_EQUALS",
                  "STARTS_WITH",
                  "ENDS_WITH"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "[\\s\\S]*\\S[\\s\\S]*",
                "minLength": 1,
                "maxLength": 512,
                "description": "Nonblank literal compared with the selected compiler-grounded field."
              }
            },
            "required": [
              "type",
              "field",
              "operator",
              "value"
            ],
            "additionalProperties": false
          },
          "Where": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "WHERE"
                ],
                "default": "WHERE"
              },
              "predicate": {
                "$ref": "#/$defs/Predicate"
              }
            },
            "required": [
              "type",
              "predicate"
            ],
            "additionalProperties": false,
            "description": "Keep symbols satisfying one structured compiler-grounded predicate."
          },
          "ExpandRelation": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "EXPAND_RELATION"
                ],
                "default": "EXPAND_RELATION"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "REFERENCES",
                  "CALLERS",
                  "CALLEES",
                  "IMPLEMENTATIONS",
                  "INHERITORS",
                  "OVERRIDES",
                  "TYPE_USES"
                ],
                "description": "One semantic hop. callers means declarations calling the current symbols; callees means declarations called by them. Choose output type occurrences to return individual relation facts, including repeated use sites."
              }
            },
            "required": [
              "type",
              "relation"
            ],
            "additionalProperties": false
          },
          "WalkDepth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum semantic hop depth; each walk remains bounded by the hosted traversal ceiling.",
            "default": 1
          },
          "WalkStrategy": {
            "anyOf": [
              {
                "$ref": "#/$defs/BreadthFirstStrategy"
              },
              {
                "$ref": "#/$defs/BoundedFanOutStrategy"
              },
              {
                "type": "null"
              }
            ],
            "description": "Omission or null uses breadth-first exploration. Bounded fan-out keeps representative deeper paths and qualifies truncated coverage."
          },
          "BreadthFirstStrategy": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "BREADTH_FIRST"
                ],
                "default": "BREADTH_FIRST"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "BoundedFanOutStrategy": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "BOUNDED_FAN_OUT"
                ],
                "default": "BOUNDED_FAN_OUT"
              },
              "maximumEdgesPerNode": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 1000,
                "default": 32
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "Walk": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "WALK"
                ],
                "default": "WALK"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "REFERENCES",
                  "CALLERS",
                  "CALLEES",
                  "IMPLEMENTATIONS",
                  "INHERITORS",
                  "OVERRIDES",
                  "TYPE_USES"
                ]
              },
              "maximumDepth": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/WalkDepth"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "strategy": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/WalkStrategy"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "relation"
            ],
            "additionalProperties": false,
            "description": "Traverse each input symbol through compiler-confirmed relations up to the requested depth. Existing traversal execution retains frontier, progress, strategy and partial-expansion evidence."
          },
          "DistinctSymbols": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "DISTINCT_SYMBOLS"
                ],
                "default": "DISTINCT_SYMBOLS"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Keep the first row and its evidence for each canonical symbol identity at this position."
          },
          "ProjectBinding": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PROJECT_BINDING"
                ],
                "default": "PROJECT_BINDING"
              },
              "name": {
                "$ref": "#/$defs/BindingName"
              }
            },
            "required": [
              "type",
              "name"
            ],
            "additionalProperties": false,
            "description": "Select one named symbol cell from each retained or newly joined binding row before symbol stages continue."
          },
          "ExecutionBudget": {
            "type": [
              "object",
              "null"
            ],
            "description": "Optional execution allowances. Null or omitted dimensions use configured defaults; positive values are independently clamped to operator and transport ceilings. These controls do not alter query take, scope, or projection.",
            "properties": {
              "maxElapsedMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maxWorkUnits": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maxResults": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 2147483647
              },
              "maxReturnedBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "required": [],
            "additionalProperties": false,
            "default": {}
          },
          "Concat": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "CONCAT"
                ],
                "default": "CONCAT"
              },
              "input": {
                "$ref": "#/$defs/CompositionInput",
                "description": "Append exact-symbol references or selected rows from one retained result, preserving stream order and multiplicity."
              }
            },
            "required": [
              "type",
              "input"
            ],
            "additionalProperties": false,
            "description": "Concatenate a typed input at this pipeline position. Later steps transform both streams."
          },
          "Intersect": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "INTERSECT"
                ],
                "default": "INTERSECT"
              },
              "right": {
                "$ref": "#/$defs/RetainedInput"
              }
            },
            "required": [
              "type",
              "right"
            ],
            "additionalProperties": false,
            "description": "Keep left rows whose canonical semantic identity occurs in the retained right result."
          },
          "Union": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "UNION"
                ],
                "default": "UNION"
              },
              "right": {
                "$ref": "#/$defs/RetainedInput"
              }
            },
            "required": [
              "type",
              "right"
            ],
            "additionalProperties": false,
            "description": "Form a set union by canonical semantic identity while retaining source qualification."
          },
          "Difference": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "DIFFERENCE"
                ],
                "default": "DIFFERENCE"
              },
              "right": {
                "$ref": "#/$defs/RetainedInput"
              }
            },
            "required": [
              "type",
              "right"
            ],
            "additionalProperties": false,
            "description": "Exclude right-hand canonical identities only when retained right coverage establishes absence."
          },
          "ResultReference": {
            "type": "string",
            "pattern": "^result:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "minLength": 46,
            "maxLength": 46,
            "description": "Opaque retained-result reference returned by Kast. It is separate from an exact-symbol reference and an execution continuation."
          },
          "ResultRowReference": {
            "type": "string",
            "pattern": "^result-row:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "minLength": 50,
            "maxLength": 50,
            "description": "Issued identity of one row in one retained result. Supply it with its owning result reference; restoration checks ownership."
          },
          "ResultCursor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000,
            "description": "Optional presentation offset in the immutable retained result. Omission or null starts at zero; this cursor does not resume semantic execution."
          },
          "ResultSource": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RESULT"
                ],
                "default": "RESULT"
              },
              "result": {
                "$ref": "#/$defs/ResultReference"
              },
              "rowIds": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/ResultRowReference"
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true,
                "description": "Omission or null selects all rows. [] selects no rows. Otherwise select these issued rows, in order, from this result; a subset keeps its source qualification and cannot prove coverage of omitted rows."
              }
            },
            "required": [
              "type",
              "result"
            ],
            "additionalProperties": false,
            "description": "Seed a new pipeline from a retained immutable result or selected issued rows. The same semantic basis is checked when Kast restores it, including empty selections and incomplete-coverage qualification."
          },
          "RunAction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RUN"
                ],
                "default": "RUN"
              },
              "source": {
                "$ref": "#/$defs/Source",
                "description": "Starting declaration search, containing named declaration at file offset, exact-symbol references, or one retained result."
              },
              "steps": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/Step"
                },
                "minItems": 0,
                "maxItems": 1000,
                "description": "Ordered transformations executed left to right. null and [] mean no transformations. A join reads its right side from a retained symbol result. Inner join yields binding rows with named left and right cells; project_binding selects one named cell before symbol stages continue. Semi and anti joins retain symbol rows; anti requires complete right coverage.",
                "default": []
              },
              "output": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Output"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retention": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "DISCARD",
                  "RETAIN",
                  null
                ],
                "description": "Omission or null discards the completed result after returning it. retain publishes an immutable bounded same-basis result reference; publication failure is reported without erasing the query result."
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "source"
            ],
            "additionalProperties": false,
            "description": "Run a query from the supplied source and ordered steps. Retain the completed result only when requested."
          },
          "ResumeAction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "RESUME"
                ],
                "default": "RESUME"
              },
              "continuation": {
                "$ref": "#/$defs/ExecutionContinuation"
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "continuation"
            ],
            "additionalProperties": false,
            "description": "Continue the saved query execution without resending or rediscovering its completed prefix."
          },
          "ReadResultAction": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "READ_RESULT"
                ],
                "default": "READ_RESULT"
              },
              "result": {
                "$ref": "#/$defs/ResultReference"
              },
              "cursor": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ResultCursor"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ReadResultOutput"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "executionBudget": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ExecutionBudget"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "result"
            ],
            "additionalProperties": false,
            "description": "Present an immutable retained result, starting at the supplied result cursor; this performs no query evaluation."
          },
          "ExecutionContinuation": {
            "type": "string",
            "pattern": "^(?:query|query-output):v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "minLength": 45,
            "maxLength": 52,
            "description": "Issued execution continuation for an unfinished query pipeline or retained transport output. Copy verbatim. A retained-result reference cannot resume execution."
          },
          "BindingName": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
            "minLength": 1,
            "maxLength": 64,
            "description": "One bounded name for a cell in a binding row. Inner joins name their left and right cells; project_binding selects a cell by its name."
          },
          "InnerJoinMode": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "INNER"
                ],
                "default": "INNER"
              },
              "leftName": {
                "$ref": "#/$defs/BindingName"
              },
              "rightName": {
                "$ref": "#/$defs/BindingName"
              }
            },
            "required": [
              "type",
              "leftName",
              "rightName"
            ],
            "additionalProperties": false,
            "description": "Emit one typed binding row per matching pair. The two output column names must differ."
          },
          "SemiJoinMode": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "SEMI"
                ],
                "default": "SEMI"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Keep left symbol rows with a matching right identity, preserving left multiplicity and evidence."
          },
          "AntiJoinMode": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ANTI"
                ],
                "default": "ANTI"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Keep left symbol rows only when complete right coverage proves no matching identity."
          },
          "Join": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "JOIN"
                ],
                "default": "JOIN"
              },
              "mode": {
                "$ref": "#/$defs/JoinMode"
              },
              "right": {
                "$ref": "#/$defs/RetainedInput",
                "description": "Immutable retained symbol rows. A retained binding-row result is not a symbol right input."
              }
            },
            "required": [
              "type",
              "mode",
              "right"
            ],
            "additionalProperties": false,
            "description": "Join on canonical symbol identity. Inner emits typed paired rows; semi keeps proven matches; anti requires complete right coverage to establish absence."
          },
          "BindingRowsOutput": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "BINDING_ROWS"
                ],
                "default": "BINDING_ROWS"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "description": "Present both named symbol or exact-occurrence bindings in each inner-join pair, preserving multiplicity and evidence."
          },
          "LocationSource": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "AT_LOCATION"
                ],
                "default": "AT_LOCATION"
              },
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576,
                "description": "Canonical workspace-relative file path containing the offset."
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "description": "UTF-16 offset inside the named declaration."
              }
            },
            "required": [
              "type",
              "file",
              "offset"
            ],
            "additionalProperties": false,
            "description": "Find the nearest named declaration containing this offset, then return its exact compiler-grounded symbol."
          },
          "Scope": {
            "anyOf": [
              {
                "$ref": "#/$defs/DirectoryScope"
              },
              {
                "$ref": "#/$defs/PackageScope"
              },
              {
                "type": "null"
              }
            ]
          },
          "CompositionInput": {
            "anyOf": [
              {
                "$ref": "#/$defs/ReferenceSource"
              },
              {
                "$ref": "#/$defs/ResultSource"
              }
            ]
          },
          "Source": {
            "anyOf": [
              {
                "$ref": "#/$defs/SearchSource"
              },
              {
                "$ref": "#/$defs/AllSource"
              },
              {
                "$ref": "#/$defs/LocationSource"
              },
              {
                "$ref": "#/$defs/ReferenceSource"
              },
              {
                "$ref": "#/$defs/ResultSource"
              }
            ]
          },
          "Step": {
            "anyOf": [
              {
                "$ref": "#/$defs/Where"
              },
              {
                "$ref": "#/$defs/ExpandRelation"
              },
              {
                "$ref": "#/$defs/Walk"
              },
              {
                "$ref": "#/$defs/DistinctSymbols"
              },
              {
                "$ref": "#/$defs/ProjectBinding"
              },
              {
                "$ref": "#/$defs/Concat"
              },
              {
                "$ref": "#/$defs/Intersect"
              },
              {
                "$ref": "#/$defs/Union"
              },
              {
                "$ref": "#/$defs/Difference"
              },
              {
                "$ref": "#/$defs/Join"
              }
            ]
          },
          "JoinMode": {
            "anyOf": [
              {
                "$ref": "#/$defs/InnerJoinMode"
              },
              {
                "$ref": "#/$defs/SemiJoinMode"
              },
              {
                "$ref": "#/$defs/AntiJoinMode"
              }
            ]
          },
          "Action": {
            "anyOf": [
              {
                "$ref": "#/$defs/RunAction"
              },
              {
                "$ref": "#/$defs/ResumeAction"
              },
              {
                "$ref": "#/$defs/ReadResultAction"
              }
            ]
          },
          "RetainedInput": {
            "anyOf": [
              {
                "$ref": "#/$defs/ResultSource"
              }
            ]
          }
        }
      },
      "deferLoading": false
    },
    {
      "type": "function",
      "name": "check_diagnostics",
      "description": "Check compiler diagnostics for a file or recursively beneath a directory in the session workspace. Use '.' explicitly for the workspace root. This is not symbol search and does not build the project. Results retain incomplete-coverage evidence; an incomplete empty result does not establish that the scope is clean. Requires the saved, indexed IntelliJ state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean",
            "default": false,
            "description": "Return execution diagnostics and redundant phase detail when true. Omitted or false returns compact semantic results, preserving qualifications, references, continuation and recovery evidence."
          },
          "relativePath": {
            "type": "string",
            "description": "File or directory path relative to the session workspace root, such as src/main/kotlin/orders/OrderService.kt or services/orders. Use '.' for the root. Not a package name, glob, absolute path, or parent traversal.",
            "minLength": 1,
            "maxLength": 1048576
          },
          "maxDiagnostics": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum diagnostic entries to return. Omission or null selects 100. This limits results, not module admission, indexing, or compiler work; incomplete coverage remains explicit.",
            "default": 100
          },
          "continuation": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1048576,
            "description": "Opaque same-basis diagnostic continuation. Omit or use null to start. Resume the same relative_path; increase execution_budget if a grant cannot cross the enumeration prefix."
          },
          "executionBudget": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExecutionBudget"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "relativePath"
        ],
        "additionalProperties": false,
        "$defs": {
          "ExecutionBudget": {
            "type": [
              "object",
              "null"
            ],
            "description": "Optional execution allowances. Null or omitted dimensions use configured defaults; positive values are independently clamped to operator and transport ceilings. These controls do not alter query take, scope, or projection.",
            "properties": {
              "maxElapsedMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maxWorkUnits": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maxResults": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 2147483647
              },
              "maxReturnedBytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "required": [],
            "additionalProperties": false,
            "default": {}
          }
        }
      },
      "deferLoading": false
    },
    {
      "type": "function",
      "name": "add_declaration",
      "description": "Add one declaration to an existing Kotlin source file selected by an exact Kast symbol reference. Kast plans, applies, verifies, and reports a verified receipt or finite failure with recovery evidence. Preserve the returned result; a cancelled or missing response does not prove no write occurred.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean",
            "default": false,
            "description": "Return execution diagnostics and redundant phase detail when true. Omitted or false returns compact semantic results, preserving qualifications, references, continuation and recovery evidence."
          },
          "exactTarget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576,
            "description": "Opaque exact-symbol reference returned by Kast. Copy it unchanged."
          },
          "declaration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576,
            "description": "Kotlin declaration text to add at the exact target."
          }
        },
        "required": [
          "exactTarget",
          "declaration"
        ],
        "additionalProperties": false
      },
      "deferLoading": true
    },
    {
      "type": "function",
      "name": "replace_body",
      "description": "Replace only the block body of one existing, non-inline named Kotlin function selected by an exact Kast symbol reference. Kast plans, applies, verifies, and reports a verified receipt or finite failure with recovery evidence. The signature and surrounding source are preserved.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "verbose": {
            "type": "boolean",
            "default": false,
            "description": "Return execution diagnostics and redundant phase detail when true. Omitted or false returns compact semantic results, preserving qualifications, references, continuation and recovery evidence."
          },
          "exactTarget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576,
            "description": "Opaque exact-symbol reference returned by Kast. Copy it unchanged."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1048576,
            "description": "One complete Kotlin block body, including braces. Syntax errors and trailing input are rejected."
          }
        },
        "required": [
          "exactTarget",
          "body"
        ],
        "additionalProperties": false
      },
      "deferLoading": true
    }
  ]
}
