{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/schemas/management/connection-configuration.schema.json",
  "title": "Kast saved connection directories",
  "description": "User preferences, distinct from installation ownership. Each connection retains one absolute normalized directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "connections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ],
      "examples": [
        1
      ]
    },
    "connections": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/connection"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "type": {
                "enum": [
                  "CODEX_MCP"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "type": {
                "enum": [
                  "CODEX_APP_SERVER"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ],
      "examples": [
        [
          {
            "type": "CODEX_MCP",
            "directory": "/Users/developer/.codex"
          }
        ]
      ]
    }
  },
  "$defs": {
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "directory"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CODEX_MCP",
            "CODEX_APP_SERVER"
          ],
          "examples": [
            "CODEX_MCP",
            "CODEX_APP_SERVER"
          ]
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/(?:((?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f]+)(?:/((?!\\.{1,2}(?:/|$))[^/\\u0000-\\u001f]+))*)?$",
          "description": "Codex MCP home or the Codex App Server launcher directory.",
          "examples": [
            "/Users/developer/.codex",
            "/Users/developer/.local/bin"
          ]
        }
      },
      "examples": [
        {
          "type": "CODEX_MCP",
          "directory": "/Users/developer/.codex"
        }
      ]
    }
  },
  "examples": [
    {
      "schemaVersion": 1,
      "connections": [
        {
          "type": "CODEX_MCP",
          "directory": "/Users/developer/.codex"
        },
        {
          "type": "CODEX_APP_SERVER",
          "directory": "/Users/developer/.local/bin"
        }
      ]
    }
  ]
}
