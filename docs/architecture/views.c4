global {
  styleGroup semantic-boundaries {
    style element.tag = #public {
      color primary
      border solid
    }
    style element.tag = #compiler {
      color indigo
    }
    style element.tag = #persisted {
      color green
    }
    style element.tag = #proof {
      border dashed
    }
    style element.tag = #live {
      color sky
    }
    style element.tag = #trigger {
      color amber
      border dotted
    }
    style element.tag = #indexing {
      color blue
    }
    style element.tag = #adapter {
      color muted
      opacity 70%
    }
  }
}

views {
  view system-landscape {
    title "Kast system landscape"
    description "Public callers enter one Kast boundary; compiler libraries and workspace state remain explicit dependencies."
    include *
    global style semantic-boundaries
    style kast {
      color primary
      size xl
    }
    autoLayout LeftRight 140 100
  }

  view runtime-components of kast {
    title "Kast runtime components"
    description "CLI dispatch, exact-root admission, one indexer, and proof-carrying output."
    include *
    include kast.server.*
    include kast.indexer.*
    include kast.evidence.*
    global style semantic-boundaries
    style kast.server, kast.indexer, kast.evidence {
      color secondary
    }
    autoLayout LeftRight 110 70
  }

  view compiler-evidence {
    title "Compiler evidence pipeline"
    description "Exact request path from the CLI to compiler semantics, persisted facts, and typed projection."
    include developer
    include kast.cli
    include kast.agent
    include kast.rpcClient
    include kast.server.dispatcher
    include kast.server.router
    include kast.server.orchestrator
    include kast.indexer.compiler
    include kotlinCompiler
    include kast.evidence.index
    include kast.evidence.projection
    global style semantic-boundaries
    style kast.indexer.compiler, kotlinCompiler {
      color indigo
    }
    style kast.evidence.index, kast.evidence.projection {
      color green
    }
    autoLayout LeftRight 90 60
  }

  view public-entrypoints {
    title "Public entry points"
    description "The installer and harness hooks are adapters; kast remains the public command contract."
    include developer
    include installer
    include codexHooks
    include kast.cli
    include kast.control
    include kast.agent
    global style semantic-boundaries
    autoLayout LeftRight 120 80
  }

  view indexing-landscape {
    title "Indexing landscape"
    description "One indexer turns Gradle and compiler state into generation-bound SQLite evidence."
    include developer
    include codexHooks
    include kast.cli
    include kast.control
    include kast.indexer
    include runtimeLibraries
    include kotlinCompiler
    include kast.evidence.index
    global style semantic-boundaries
    style runtimeLibraries, kotlinCompiler, kast.indexer {
      color indigo
    }
    style kast.evidence.index {
      color green
      size xl
    }
    autoLayout LeftRight 120 80
  }

  dynamic view indexing-guide {
    title "Explore indexing pipelines"
    description "Follow indexer admission, retained SQLite evidence, or focused refresh."

    kast.control -> kast.indexer.runtime "admits exact-root indexer" {
      navigateTo reference-indexing
    }
    kast.indexer.compiler -> kast.evidence.index "reads indexed facts" {
      navigateTo sqlite-pipeline
    }
    codexHooks -> kast.cli "refreshes changed Kotlin evidence" {
      navigateTo refresh-lifecycle
    }
  }

  view indexer-pipeline {
    title "Live indexer pipeline"
    description "The isolated indexer reaches PSI and K2, then retains provider-neutral facts."
    include kast.indexer.runtime
    include kast.indexer.serverRuntime
    include kast.indexer.compiler
    include kast.indexer.admission
    include kast.indexer.refresh
    include kast.indexer.diagnostics
    include runtimeLibraries
    include kotlinCompiler.*
    include kast.indexer.referenceScanner
    include kast.indexer.declarationScanner
    include kast.indexer.graphExtractor
    include kast.indexer.refreshStatus
    global style semantic-boundaries
    style runtimeLibraries, kotlinCompiler.* {
      color indigo
    }
    style kast.indexer.referenceScanner, kast.indexer.declarationScanner, kast.indexer.graphExtractor {
      color blue
    }
    autoLayout LeftRight 100 70
  }

  view retained-evidence {
    title "Retained evidence"
    description "One WAL database stores inventory, references, graph facts, generations, and snapshots."
    include kast.indexer.sourceScanner
    include kast.indexer.referenceIndexer
    include kast.indexer.graphWriter
    include kast.indexer.snapshotCoordinator
    include kast.evidence.index.*
    include kotlinCompiler.psi
    include kast.evidence.projection
    global style semantic-boundaries
    style kast.evidence.index.* {
      color green
    }
    style kast.indexer.sourceScanner, kast.indexer.referenceIndexer, kast.indexer.graphWriter {
      color blue
    }
    autoLayout LeftRight 105 70
  }
}
