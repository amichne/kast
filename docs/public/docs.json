{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kast",
  "description": "Compiler-grounded Kotlin tools: find declarations, read evidence, and make approved changes.",
  "colors": {
    "primary": "#3154C7",
    "light": "#8FA7FF",
    "dark": "#27439F"
  },
  "fonts": {
    "family": "SUSE"
  },
  "logo": "/images/kast-mark.svg",
  "favicon": "/images/kast-mark.svg",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FBFBF9",
      "dark": "#171816"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Use Kast",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "start"
            ]
          },
          {
            "group": "Work with Kotlin",
            "pages": [
              "search",
              "query-pipelines",
              "change"
            ]
          },
          {
            "group": "Interpret an answer",
            "pages": [
              "reference/responses",
              "reference/symbols",
              "concepts/evidence-boundaries"
            ]
          }
        ]
      },
      {
        "tab": "Tool contracts",
        "openapi": "reference/callables.openapi.json",
        "groups": [
          {
            "group": "Integration",
            "pages": [
              "agent-harnesses"
            ]
          },
          {
            "group": "Search and diagnostics",
            "pages": [
              "POST /callables/search_classes",
              "POST /callables/search_functions",
              "POST /callables/search_declarations",
              "POST /callables/check_diagnostics"
            ]
          },
          {
            "group": "Read and explore",
            "pages": [
              "POST /callables/query_symbols",
              "POST /callables/source_read",
              "POST /callables/semantic_query",
              "POST /callables/impact_analyze"
            ]
          },
          {
            "group": "Change source",
            "pages": [
              "POST /callables/change_plan",
              "POST /callables/change_apply",
              "POST /callables/change_recover"
            ]
          },
          {
            "group": "Compiler models",
            "pages": [
              "reference/models/query-item",
              "reference/models/relation-fact",
              "reference/models/diagnostic",
              "reference/models/live-evidence"
            ]
          },
          {
            "group": "Candidate tools (opt-in)",
            "pages": [
              "POST /callables/symbol_lookup",
              "POST /callables/symbol_inspect"
            ]
          }
        ]
      },
      {
        "tab": "Operate Kast",
        "groups": [
          {
            "group": "Support",
            "pages": [
              "troubleshooting",
              "reference/compatibility",
              "concepts/runtime-integration-validation"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/amichne/kast"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install Kast",
      "href": "/start"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amichne/kast"
    },
    "links": [
      {
        "header": "Use Kast",
        "items": [
          {
            "label": "Install and connect",
            "href": "/start"
          },
          {
            "label": "Agent harnesses",
            "href": "/agent-harnesses"
          }
        ]
      },
      {
        "header": "Support",
        "items": [
          {
            "label": "Troubleshooting",
            "href": "/troubleshooting"
          },
          {
            "label": "Evidence outcomes",
            "href": "/concepts/evidence-boundaries"
          }
        ]
      },
      {
        "header": "Source",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/amichne/kast"
          },
          {
            "label": "Security",
            "href": "https://github.com/amichne/kast/security"
          }
        ]
      }
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "autogenerate": false
    }
  },
  "search": {
    "prompt": "Search docs"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The requested Kast documentation page does not exist. Return to the [documentation home](/)."
    }
  }
}
