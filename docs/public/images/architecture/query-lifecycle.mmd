flowchart TD
  Q["Admitted question<br/>source, scope, and grant"] --> W["Prepare exact workspace<br/>join its current operation"]
  W --> L["Acquire semantic lane<br/>bind current read authority"]
  L --> S["Resolve exact source<br/>advance semantic tasks"]
  S --> P{"Completion proof met?"}
  P -->|Yes| A(["Complete answer"])
  P -->|No| R["Typed rejection<br/>available evidence"]
  A --> D["Fit and publish<br/>produced output"]
  R --> D
  D --> O["READ_RESULT or output RESUME<br/>no semantic replay"]
  class L proof
  class R stop
  class A result
