#!/bin/bash
# Generated by packaging/generate_bootstrap.py. Edit that owner and this template.
set -euo pipefail
readonly INSTALL_DOWNLOAD_RETRIES=5
readonly INSTALL_DOWNLOAD_RETRY_DELAY_MILLIS=2000
fail() { printf 'kast: %s\n' "$*" >&2; exit 1; }
arguments=()
selection=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)
      printf '%s\n' 'Usage: install.sh [--channel stable|preview|main | --version X.Y.Z | --commit SHA] [--dry-run] [--json]' \
        'Installs one complete private-runtime product. No Python, uv, or IDEA installation is required.'
      exit 0 ;;
    --developer-latest)
      [[ "$selection" == 0 ]] || fail 'select exactly one build'
      selection=1; arguments+=(--channel preview); shift ;;
    --channel|--version|--commit)
      [[ "$selection" == 0 && $# -ge 2 ]] || fail 'select exactly one build with a value'
      case "$1:$2" in
        --channel:stable|--channel:preview|--channel:main) ;;
        --version:*) [[ "$2" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail 'invalid version' ;;
        --commit:*) [[ "$2" =~ ^[0-9a-f]{7,40}$ ]] || fail 'invalid commit' ;;
        *) fail 'unsupported channel' ;;
      esac
      selection=1; arguments+=("$1" "$2"); shift 2 ;;
    --dry-run|--json|--recover-only) arguments+=("$1"); shift ;;
    --skip-codex-plugin) shift ;; # Historical public command; no harness is installed implicitly.
    *) fail "unsupported product installation option: $1" ;;
  esac
done
[[ -n "${HOME:-}" && "$HOME" == /* ]] || fail 'an absolute HOME is required'
for retired in KAST_VERSION KAST_HOST_VERSION KAST_INSTALL_ASSETS_DIRECTORY KAST_RELEASE_BASE_URL KAST_INSTALL_IDEA_HOME KAST_INSTALL_ROOT KAST_RUNTIME_STORE KAST_RUNTIME_ARCHIVE; do
  [[ -z "${!retired+x}" ]] || fail "$retired is not a public product input; use an explicit build selector"
done
# Platform admission precedes downloads, temporary storage, or installation effects.
case "$(uname -s):$(uname -m)" in
  Darwin:arm64|Darwin:aarch64)
    python_url='@MAC_URL@'; python_sha='@MAC_SHA@'; hasher=(shasum -a 256) ;;
  Linux:x86_64|Linux:amd64)
    python_url='@LINUX_URL@'; python_sha='@LINUX_SHA@'; hasher=(sha256sum) ;;
  *) fail 'supported complete products: macOS ARM64 and Linux x86-64' ;;
esac
for tool in curl tar mktemp mkdir rm "${hasher[0]}"; do
  command -v "$tool" >/dev/null 2>&1 || fail "required system tool unavailable: $tool"
done
temporary="$(mktemp -d "${TMPDIR:-/tmp}/kast-bootstrap.XXXXXX")"
temporary="$(cd -- "$temporary" && pwd -P)"
trap 'rm -rf -- "$temporary"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
fetch() {
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --retry "$INSTALL_DOWNLOAD_RETRIES" --retry-delay "$((INSTALL_DOWNLOAD_RETRY_DELAY_MILLIS / 1000))" \
    --connect-timeout 30 --max-time 300 --output "$2" "$1"
}
verify() {
  local actual
  actual="$("${hasher[@]}" "$1")"
  [[ "${actual%% *}" == "$2" ]] || fail 'bootstrap artifact digest mismatch'
}
fetch "$python_url" "$temporary/python.tar.gz"
verify "$temporary/python.tar.gz" "$python_sha"
fetch '@DEPENDENCY_URL@' "$temporary/defusedxml.whl"
verify "$temporary/defusedxml.whl" '@DEPENDENCY_SHA@'
tar -xzf "$temporary/python.tar.gz" -C "$temporary"
mkdir "$temporary/engine"
# Base85 keeps the embedded engine below the command-size limit without a PATH decoder.
"$temporary/python/bin/python3.12" -I -B -c \
  'import base64,hashlib,io,sys,tarfile
payload = base64.b85decode(sys.stdin.buffer.read().strip())
if hashlib.sha256(payload).hexdigest() != sys.argv[1]:
    sys.exit("kast: bootstrap engine digest mismatch")
tarfile.open(fileobj=io.BytesIO(payload), mode="r:bz2").extractall(sys.argv[2], filter="data")' \
  '@ENGINE_SHA@' "$temporary/engine" <<'KAST_ENGINE'
@ENGINE@
KAST_ENGINE
# The dependency wheel is imported directly, without pip, uv, or dependency resolution.
"$temporary/python/bin/python3.12" -I -B -c \
  'import shutil,sys; shutil.copyfile(sys.argv[1], sys.argv[2])' \
  "$temporary/defusedxml.whl" "$temporary/engine/defusedxml.whl"
"$temporary/python/bin/python3.12" -I -B "$temporary/engine/bootstrap_entry.py" \
  --private-python-archive "$temporary/python.tar.gz" --private-dependency "$temporary/defusedxml.whl" \
  ${arguments[@]+"${arguments[@]}"}
