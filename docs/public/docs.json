{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kast",
  "description": "Install Kast, query Kotlin in IntelliJ IDEA, and inspect its tool contracts.",
  "colors": {
    "primary": "#3154C7",
    "light": "#8FA7FF",
    "dark": "#27439F"
  },
  "fonts": {
    "family": "SUSE"
  },
  "logo": "/images/kast-mark.svg",
  "favicon": "/images/kast-mark.svg",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FBFBF9",
      "dark": "#171816"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Use Kast",
        "pages": [
          "index",
          "start",
          "search"
        ]
      },
      {
        "tab": "How Kast works",
        "pages": [
          "concepts/architecture"
        ]
      },
      {
        "tab": "API / RPC",
        "openapi": "reference/callables.openapi.json",
        "groups": [
          {
            "group": "Transport contracts",
            "pages": [
              "reference/mcp-catalog",
              "reference/rpc-catalog",
              "reference/models/mcp-tool-call-result",
              "reference/models/mcp-read-result",
              "reference/models/mcp-investigation-result",
              "reference/models/mcp-change-result",
              "reference/models/tool-rpc-reply"
            ]
          },
          {
            "group": "Semantic tools",
            "pages": [
              "POST /callables/query_symbols",
              "POST /callables/source_read",
              "POST /callables/check_diagnostics"
            ]
          },
          {
            "group": "Other tools",
            "pages": [
              "POST /callables/change",
              "POST /callables/symbol_lookup",
              "POST /callables/symbol_inspect",
              "POST /callables/workspace_lifecycle"
            ]
          },
          {
            "group": "Result models",
            "pages": [
              "reference/models/query-item",
              "reference/models/relation-fact",
              "reference/models/diagnostic",
              "reference/models/live-evidence"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/amichne/kast"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install Kast",
      "href": "/start"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amichne/kast"
    },
    "links": [
      {
        "header": "Learn",
        "items": [
          {
            "label": "Install",
            "href": "/start"
          },
          {
            "label": "Query",
            "href": "/search"
          },
          {
            "label": "How it works",
            "href": "/concepts/architecture"
          }
        ]
      },
      {
        "header": "Reference",
        "items": [
          {
            "label": "MCP",
            "href": "/reference/mcp-catalog"
          },
          {
            "label": "Tool RPC",
            "href": "/reference/rpc-catalog"
          }
        ]
      },
      {
        "header": "Source",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/amichne/kast"
          },
          {
            "label": "Security",
            "href": "https://github.com/amichne/kast/security"
          }
        ]
      }
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "autogenerate": false
    }
  },
  "search": {
    "prompt": "Search docs"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The requested Kast documentation page does not exist. Return to the [documentation home](/)."
    }
  },
  "redirects": [
    {
      "source": "/concepts/runtime-integration-validation",
      "destination": "/concepts/architecture",
      "permanent": true
    }
  ]
}
