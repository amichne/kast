views {
  dynamic view indexer-admission {
    title "Exact-root indexer admission"
    description "Kast reuses one eligible exact-root process or creates an isolated indexer."

    developer -> kast.cli "requests semantic readiness"
    kast.cli -> kast.control "resolves canonical workspace"
    alt {
      when "eligible exact-root indexer exists" {
        kast.control -> kast.indexer.runtime "reuses admitted identity"
      }
      else "no eligible indexer exists" {
        kast.control -> runtimeLibraries "resolves compatible libraries"
        kast.control -> kast.indexer.runtime "creates isolated indexer"
      }
    }
    kast.control -> workspaceState "persists owned descriptor"
    developer <- kast.cli "returns typed INDEXING or READY evidence"
  }

  dynamic view compiler-read {
    variant sequence
    title "Compiler-backed read"
    description "A bounded request crosses the local indexer boundary and returns explicit coverage."

    developer -> kast.cli "requests exact Kotlin evidence"
    kast.cli -> kast.agent "normalizes command"
    kast.agent -> kast.rpcClient "opens exact-root request" {
      navigateTo indexer-admission
    }
    kast.rpcClient -> kast.server.dispatcher "sends JSON-RPC"
    kast.server.dispatcher -> kast.server.router "validates envelope"
    kast.server.router -> kast.server.orchestrator "routes semantic read"
    kast.server.orchestrator -> kast.indexer.compiler "requests compiler work"

    parallel {
      kast.indexer.compiler -> kotlinCompiler.analysisApi "resolves identity and diagnostics"
      kast.indexer.compiler -> kast.evidence.index "reads indexed facts"
    }

    kast.server.orchestrator <- kast.indexer.compiler "returns typed evidence"
    kast.server.orchestrator -> kast.evidence.projection "adds limits and next actions"
    kast.cli <- kast.evidence.projection "projects compact result"
    developer <- kast.cli "receives proof-carrying evidence"
  }

  dynamic view semantic-mutation {
    variant sequence
    title "Semantic mutation"
    description "A mutation resolves exact identity, applies through the indexer, and returns validation evidence."

    developer -> kast.cli "requests typed mutation"
    kast.cli -> kast.agent "checks exact-root admission"
    kast.agent -> kast.rpcClient "opens reusable session"
    kast.rpcClient -> kast.server.dispatcher "sends request"
    kast.server.dispatcher -> kast.server.router "dispatches"
    kast.server.router -> kast.server.mutation "routes mutation"

    try "plan and apply" {
      kast.server.mutation -> kast.server.orchestrator "resolves selector identity"
      kast.server.orchestrator -> kast.indexer.compiler "applies in write action"
      kast.indexer.compiler -> kotlinCompiler.psi "updates PSI and imports"
      kast.server.orchestrator <- kast.indexer.compiler "returns apply evidence"
    } catch "typed failure" {
      kast.server.mutation -> kast.evidence.projection "preserves failure"
    } finally "refresh compiler evidence" {
      kast.indexer.compiler -> kast.indexer.refresh "refreshes affected paths"
      kast.indexer.refresh -> kast.indexer.diagnostics "validates diagnostics"
    }

    kast.server.mutation -> kast.evidence.projection "returns terminal result"
    kast.cli <- kast.evidence.projection "projects apply evidence"
    developer <- kast.cli "receives success or typed failure"
  }

  dynamic view reference-indexing {
    variant sequence
    title "Reference indexing"
    description "Inventory precedes dependency-prioritized declaration and reference batches."

    kast.control -> kast.indexer.runtime "admits exact-root indexer"
    kast.indexer.runtime -> runtimeLibraries "loads compatible libraries"
    kast.indexer.runtime -> kast.indexer.admission "settles Gradle and compiler state"
    kast.indexer.admission -> kast.indexer.projectIndexer "starts full indexing"

    opt "compatible repository snapshot exists" {
      kast.indexer.snapshotCoordinator -> kast.evidence.index.snapshots "selects base and overlay"
      kast.evidence.index.snapshots -> kast.evidence.index.writer "hydrates retained state"
    }

    kast.indexer.projectIndexer -> kast.indexer.sourceScanner "builds source inventory"
    kast.indexer.sourceScanner -> kast.evidence.index.writer "submits inventory"
    kast.evidence.index.writer -> kast.evidence.index.inventory "commits inventory"

    kast.indexer.projectIndexer -> kast.indexer.referenceIndexer "orders modules"
    loop "each module in bounded batches" {
      parallel {
        kast.indexer.referenceIndexer -> kast.indexer.referenceScanner "resolves references"
        kast.indexer.referenceIndexer -> kast.indexer.declarationScanner "extracts declarations"
      }
      kast.indexer.referenceIndexer -> kast.evidence.index.writer "submits successful batch"
      kast.evidence.index.writer -> kast.evidence.index.relationships "replaces occurrences"
      kast.evidence.index.writer -> kast.evidence.index.moduleProgress "advances module state"
    }

    kast.indexer.projectIndexer -> kast.indexer.refreshStatus "publishes coverage and generation"
  }

  dynamic view sqlite-pipeline {
    variant sequence
    title "SQLite retention"
    description "Compiler scans stay outside transactions; one writer serializes retained products."

    parallel {
      kast.indexer.sourceScanner -> kast.evidence.index.writer "submits inventory"
      kast.indexer.referenceIndexer -> kast.evidence.index.writer "submits reference batch"
      kast.indexer.graphWriter -> kast.evidence.index.writer "submits graph replacement"
    }

    kast.evidence.index.writer -> kast.evidence.index.interning "encodes paths and FQNs"
    kast.evidence.index.interning -> kast.evidence.index.generation "checks data version"
    parallel {
      kast.evidence.index.writer -> kast.evidence.index.inventory "retains inventory"
      kast.evidence.index.writer -> kast.evidence.index.relationships "retains references"
      kast.evidence.index.writer -> kast.evidence.index.semanticGraph "retains graph facts"
    }
    kast.evidence.index.writer -> kast.evidence.index.generation "commits one generation"
    kast.indexer.snapshotCoordinator -> kast.evidence.index.snapshots "publishes complete snapshot"
  }

  dynamic view refresh-lifecycle {
    variant sequence
    title "Refresh routing"
    description "One typed route selects focused compiler refresh or semantic graph replacement."

    developer -> kast.cli "requests focused or graph refresh"
    kast.cli -> kast.agent "normalizes exact scope"
    kast.agent -> kast.rpcClient "sends typed refresh request"
    kast.rpcClient -> kast.server.dispatcher "opens request"
    kast.server.dispatcher -> kast.server.router "routes refresh request"
    kast.server.router -> kast.server.orchestrator "dispatches typed refresh"
    alt {
      when "focused source refresh" {
        kast.server.orchestrator -> kast.indexer.refresh "refreshes VFS and PSI"
        kast.indexer.refresh -> kast.indexer.diagnostics "collects diagnostics"
        kast.indexer.diagnostics -> kast.indexer.refreshStatus "returns admission evidence"
      }
      else "semantic graph refresh" {
        kast.server.orchestrator -> kast.indexer.graphExtractor "extracts selected facts"
        kast.indexer.graphExtractor -> kast.indexer.graphWriter "submits replacement"
        kast.indexer.graphWriter -> kast.evidence.index.writer "commits selected files"
        kast.indexer.graphExtractor -> kast.indexer.refreshStatus "returns coverage"
      }
    }

    kast.cli <- kast.indexer.refreshStatus "projects typed refresh evidence"
    developer <- kast.cli "receives readiness or limitation"
    autoLayout RightLeft
  }
}
