{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "KAST_AGENT_PROVIDER=codex KAST_AGENT_RESOURCE_ROOT=\"${PLUGIN_ROOT}\" \"${KAST_HOME:-${HOME}/.local/share/kast}/current/libexec/kastctl\" developer agent-hook session-start",
            "commandWindows": "$env:KAST_AGENT_PROVIDER='codex'; $env:KAST_AGENT_RESOURCE_ROOT=$env:PLUGIN_ROOT; $kastHome=if ($env:KAST_HOME) { $env:KAST_HOME } else { Join-Path $HOME '.local/share/kast' }; & (Join-Path $kastHome 'current/libexec/kastctl') developer agent-hook session-start",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  }
}
