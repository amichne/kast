{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"${HOME}/.local/bin:${PATH}\" kast --internal-entrypoint=query hook session-start --host codex",
            "timeout": 90,
            "statusMessage": "Read passive Kast session context"
          }
        ]
      }
    ]
  }
}
