{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/experimental/hosted-endpoint/v3",
  "oneOf": [
    {
      "$ref": "#/$defs/descriptor"
    },
    {
      "$ref": "#/$defs/host"
    },
    {
      "$ref": "#/$defs/rejected"
    }
  ],
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 4096
    },
    "operations": {
      "type": "array",
      "const": [
        "DESCRIBE",
        "CLASS_LOOKUP",
        "DIRECT_SUPERTYPE",
        "QUERY_RUN",
        "SYMBOL_DISCOVER",
        "SYMBOL_INSPECT",
        "SOURCE_READ",
        "RELATION_READ",
        "TRAVERSAL_RUN",
        "DIAGNOSTIC_CHECK",
        "CHANGE_PLAN",
        "CHANGE_APPROVAL_PREPARE",
        "CHANGE_APPLY",
        "CHANGE_RECOVER"
      ]
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "root",
        "socket",
        "hostPid",
        "operations",
        "host",
        "querySchema"
      ],
      "properties": {
        "type": {
          "const": "KAST_IDE_ENDPOINT"
        },
        "protocol": {
          "const": 3
        },
        "root": {
          "$ref": "#/$defs/root"
        },
        "socket": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 100
        },
        "hostPid": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "$ref": "#/$defs/operations"
        },
        "host": {
          "$ref": "#/$defs/hostLifetime"
        },
        "querySchema": {
          "const": "kast.query.run.v2"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "root",
        "hostPid",
        "operations",
        "indexAuthority",
        "host",
        "querySchema"
      ],
      "properties": {
        "type": {
          "const": "KAST_IDE_HOST"
        },
        "protocol": {
          "const": 3
        },
        "root": {
          "$ref": "#/$defs/root"
        },
        "hostPid": {
          "type": "integer",
          "minimum": 1
        },
        "operations": {
          "$ref": "#/$defs/operations"
        },
        "indexAuthority": {
          "const": "existing_ide_kotlin_stub_index"
        },
        "host": {
          "$ref": "#/$defs/hostLifetime"
        },
        "querySchema": {
          "const": "kast.query.run.v2"
        },
        "readiness": {
          "$ref": "#/$defs/readiness"
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "failure"
      ],
      "properties": {
        "type": {
          "const": "HOST_REJECTED"
        },
        "failure": {
          "enum": [
            "ADMISSION_CAPACITY_EXCEEDED",
            "ADMISSION_DEADLINE_EXCEEDED",
            "INVALID_REQUEST",
            "REQUEST_TOO_LARGE",
            "REQUEST_INCOMPLETE",
            "IO_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "WRONG_ROOT",
            "OWNERSHIP_CONFLICT",
            "DIRECTORY_REJECTED",
            "SOCKET_UNAVAILABLE",
            "PLATFORM_UNAVAILABLE",
            "RESPONSE_REJECTED",
            "RESULT_TOO_LARGE",
            "APPROVAL_UNAVAILABLE",
            "APPROVAL_REJECTED",
            "CHANGE_STORAGE_REJECTED",
            "CHANGE_PLANNING_EVIDENCE_REJECTED"
          ]
        },
        "detail": {
          "$ref": "#/$defs/changeFailure"
        },
        "execution_budget": {
          "$ref": "#/$defs/executionBudget"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "failure": {
                "enum": [
                  "CHANGE_STORAGE_REJECTED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "STATE_ROOT",
                      "LOCATION",
                      "DATABASE",
                      "PLANS",
                      "RECEIPTS",
                      "PLAN_LOOKUP"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "PLAN_MISSING"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "INVALID_REQUEST"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "STATE_ROOT",
                      "LOCATION",
                      "DATABASE",
                      "PLANS",
                      "RECEIPTS",
                      "PLAN_LOOKUP"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "CHANGE_STORAGE_REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "INVALID_REQUEST"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "INVALID_REQUEST"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "REQUEST_TOO_LARGE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "REQUEST_TOO_LARGE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "REQUEST_INCOMPLETE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "REQUEST_INCOMPLETE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "IO_UNAVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "IO_UNAVAILABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "DEADLINE_EXCEEDED"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "DEADLINE_EXCEEDED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "WRONG_ROOT"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "WRONG_ROOT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "OWNERSHIP_CONFLICT"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "OWNERSHIP_CONFLICT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "DIRECTORY_REJECTED"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "DIRECTORY_REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "SOCKET_UNAVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "SOCKET_UNAVAILABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "PLATFORM_UNAVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "PLATFORM_UNAVAILABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "RESPONSE_REJECTED"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "RESPONSE_REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "RESULT_TOO_LARGE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "RESULT_TOO_LARGE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "APPROVAL_UNAVAILABLE"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "APPROVAL_UNAVAILABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "enum": [
                      "ENDPOINT"
                    ]
                  },
                  "cause": {
                    "enum": [
                      "APPROVAL_REJECTED"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "enum": [
                  "APPROVAL_REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "failure": {
                "const": "CHANGE_PLANNING_EVIDENCE_REJECTED"
              }
            }
          },
          "then": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "const": "PLANNING_EVIDENCE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "detail"
            ],
            "properties": {
              "detail": {
                "properties": {
                  "type": {
                    "const": "PLANNING_EVIDENCE"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "const": "CHANGE_PLANNING_EVIDENCE_REJECTED"
              }
            }
          }
        }
      ]
    },
    "hostLifetime": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "changeFailure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "STATE_ROOT"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "BLANK",
                "NOT_ABSOLUTE",
                "NOT_NORMALIZED",
                "CONTAINS_NUL",
                "TOO_LONG"
              ]
            }
          },
          "examples": [
            {
              "type": "STATE_ROOT",
              "cause": "BLANK"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "LOCATION"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "LOCATION_TOO_LONG"
              ]
            }
          },
          "examples": [
            {
              "type": "LOCATION",
              "cause": "LOCATION_TOO_LONG"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "DATABASE"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "NOT_CANONICAL_ABSOLUTE",
                "PARENT_NOT_DIRECTORY",
                "SYMLINK_NOT_ALLOWED",
                "EXISTING_PATH_NOT_REGULAR_FILE",
                "STORAGE_UNAVAILABLE"
              ]
            }
          },
          "examples": [
            {
              "type": "DATABASE",
              "cause": "NOT_CANONICAL_ABSOLUTE"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "PLANS"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "STORAGE_UNAVAILABLE",
                "IDENTITY_COLLISION",
                "CORRUPT_RECORD",
                "VERSION_UNSUPPORTED"
              ]
            }
          },
          "examples": [
            {
              "type": "PLANS",
              "cause": "STORAGE_UNAVAILABLE"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RECEIPTS"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "STORAGE_UNAVAILABLE",
                "IDENTITY_COLLISION",
                "CORRUPT_RECORD",
                "VERSION_UNSUPPORTED"
              ]
            }
          },
          "examples": [
            {
              "type": "RECEIPTS",
              "cause": "STORAGE_UNAVAILABLE"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "PLAN_LOOKUP"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "STORAGE_UNAVAILABLE",
                "IDENTITY_COLLISION",
                "CORRUPT_RECORD",
                "VERSION_UNSUPPORTED"
              ]
            }
          },
          "examples": [
            {
              "type": "PLAN_LOOKUP",
              "cause": "STORAGE_UNAVAILABLE"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "PLAN_MISSING"
              ]
            }
          },
          "examples": [
            {
              "type": "PLAN_MISSING"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ENDPOINT"
              ]
            },
            "cause": {
              "type": "string",
              "enum": [
                "ADMISSION_CAPACITY_EXCEEDED",
                "ADMISSION_DEADLINE_EXCEEDED",
                "INVALID_REQUEST",
                "REQUEST_TOO_LARGE",
                "REQUEST_INCOMPLETE",
                "IO_UNAVAILABLE",
                "DEADLINE_EXCEEDED",
                "WRONG_ROOT",
                "OWNERSHIP_CONFLICT",
                "DIRECTORY_REJECTED",
                "SOCKET_UNAVAILABLE",
                "PLATFORM_UNAVAILABLE",
                "RESPONSE_REJECTED",
                "RESULT_TOO_LARGE",
                "APPROVAL_UNAVAILABLE",
                "APPROVAL_REJECTED"
              ]
            }
          },
          "examples": [
            {
              "type": "ENDPOINT",
              "cause": "INVALID_REQUEST"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cause"
          ],
          "properties": {
            "type": {
              "const": "PLANNING_EVIDENCE"
            },
            "cause": {
              "$ref": "#/$defs/planningEvidenceFailure"
            }
          }
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Bounded change admission failure. No path, source payload or diagnostic text crosses this boundary."
    },
    "transportRejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "failure"
      ],
      "properties": {
        "type": {
          "const": "HOST_REJECTED"
        },
        "failure": {
          "enum": [
            "ADMISSION_CAPACITY_EXCEEDED",
            "ADMISSION_DEADLINE_EXCEEDED",
            "INVALID_REQUEST",
            "REQUEST_TOO_LARGE",
            "REQUEST_INCOMPLETE",
            "IO_UNAVAILABLE",
            "DEADLINE_EXCEEDED",
            "WRONG_ROOT",
            "OWNERSHIP_CONFLICT",
            "DIRECTORY_REJECTED",
            "SOCKET_UNAVAILABLE",
            "PLATFORM_UNAVAILABLE",
            "RESPONSE_REJECTED",
            "RESULT_TOO_LARGE",
            "APPROVAL_UNAVAILABLE",
            "APPROVAL_REJECTED"
          ]
        },
        "execution_budget": {
          "$ref": "#/$defs/executionBudget"
        }
      }
    },
    "readiness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "admission_ready"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "rejection"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "rejection": {
              "$ref": "#/$defs/readinessRejection"
            }
          }
        }
      ]
    },
    "readinessRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "outcome",
        "failure",
        "detail",
        "stage"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "outcome": {
          "const": "rejected"
        },
        "failure": {
          "enum": [
            "RETIRED",
            "WRONG_ENDPOINT",
            "WRONG_PROJECT",
            "BUSY",
            "STALE_REQUEST",
            "INVALID_SELECTION",
            "DECLARATION_NOT_FOUND",
            "AMBIGUOUS_DECLARATION",
            "DECLARATION_IDENTITY_MISMATCH",
            "PROJECT_UNAVAILABLE",
            "INDEXING",
            "WRONG_THREAD",
            "DIRTY_DOCUMENTS",
            "UNCOMMITTED_DOCUMENTS",
            "CONTENT_MOVED",
            "MODEL_MOVED",
            "UNSUPPORTED_MODEL",
            "UNSUPPORTED_DECLARATION",
            "UNRESOLVED_SUPERTYPE",
            "FILE_UNAVAILABLE",
            "FILE_TOO_LARGE",
            "OUTSIDE_SCOPE",
            "AMBIGUOUS_SCOPE",
            "READ_PREEMPTED",
            "CANCELLED",
            "BUDGET_EXCEEDED",
            "PLATFORM_FAILURE",
            "PROJECT_ADMISSION_REJECTED",
            "MODEL_CAPTURE_REJECTED",
            "READ_EPOCH_REJECTED",
            "FRESHNESS_REJECTED",
            "RESULT_LIMIT_EXCEEDED",
            "LIVE_AUTHORITY_REJECTED",
            "NAMED_SOURCE_SCOPE_REJECTED",
            "CONFIGURATION_REJECTED"
          ]
        },
        "detail": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
