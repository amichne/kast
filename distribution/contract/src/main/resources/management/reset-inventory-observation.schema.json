{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.michne.com/schemas/reset-inventory-observation.schema.json",
  "title": "Kast reset process inventory observation",
  "type": "object",
  "required": ["outcome", "type"],
  "additionalProperties": false,
  "properties": {
    "type": {"const": "PROCESS_INVENTORY"},
    "outcome": {
      "oneOf": [
        {
          "type": "object", "required": ["type", "count"], "additionalProperties": false,
          "properties": {"type": {"const": "OBSERVED"}, "count": {"type": "integer", "minimum": 0, "maximum": 16384}}
        },
        {
          "type": "object", "required": ["type", "pid", "reason"], "additionalProperties": false,
          "properties": {
            "type": {"const": "REJECTED"},
            "pid": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
            "reason": {"enum": ["CURRENT_USER_UNAVAILABLE", "OWNER_UNAVAILABLE", "COMMAND_UNAVAILABLE", "ARGUMENTS_UNAVAILABLE", "CAPACITY_EXCEEDED", "EFFECT_UNAVAILABLE"]}
          }
        }
      ]
    }
  }
}
