<idea-plugin>
    <id>io.github.amichne.kast.indexer</id>
    <name>Kast Indexer</name>
    <vendor url="https://github.com/amichne/kast">amichne</vendor>
    <description>Private compiler-backed runtime for the installed Kast product.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.gradle</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="false" supportsK2="true"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <appStarter
            id="kast-indexer"
            implementation="io.github.amichne.kast.indexer.KastIndexerApplicationStarter"/>
    </extensions>
</idea-plugin>
