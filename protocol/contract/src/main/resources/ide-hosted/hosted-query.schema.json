{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual hosted Kotlin query result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "outcome",
        "failure",
        "detail",
        "stage"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "outcome": {
          "const": "rejected"
        },
        "failure": {
          "enum": [
            "RETIRED",
            "WRONG_ENDPOINT",
            "WRONG_PROJECT",
            "BUSY",
            "STALE_REQUEST",
            "INVALID_SELECTION",
            "DECLARATION_NOT_FOUND",
            "AMBIGUOUS_DECLARATION",
            "DECLARATION_IDENTITY_MISMATCH",
            "PROJECT_UNAVAILABLE",
            "INDEXING",
            "WRONG_THREAD",
            "DIRTY_DOCUMENTS",
            "UNCOMMITTED_DOCUMENTS",
            "CONTENT_MOVED",
            "MODEL_MOVED",
            "UNSUPPORTED_MODEL",
            "UNSUPPORTED_DECLARATION",
            "UNRESOLVED_SUPERTYPE",
            "FILE_UNAVAILABLE",
            "FILE_TOO_LARGE",
            "OUTSIDE_SCOPE",
            "AMBIGUOUS_SCOPE",
            "READ_PREEMPTED",
            "CANCELLED",
            "BUDGET_EXCEEDED",
            "PLATFORM_FAILURE",
            "PROJECT_ADMISSION_REJECTED",
            "MODEL_CAPTURE_REJECTED",
            "READ_EPOCH_REJECTED",
            "FRESHNESS_REJECTED",
            "RESULT_LIMIT_EXCEEDED",
            "LIVE_AUTHORITY_REJECTED",
            "NAMED_SOURCE_SCOPE_REJECTED",
            "CONFIGURATION_REJECTED"
          ]
        },
        "detail": {},
        "stage": {
          "enum": [
            "REQUEST_ADMISSION",
            "PROJECT_ADMISSION",
            "EPOCH_OBSERVATION",
            "MODEL_CAPTURE",
            "SEMANTIC_READ",
            "CONTENT_REVALIDATION",
            "RESULT_DETACHED"
          ]
        },
        "recovery": {
          "$ref": "#/$defs/readRecovery"
        },
        "execution_budget": {
          "$ref": "#/$defs/executionBudget"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "failure": {
                "const": "CONFIGURATION_REJECTED"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "$ref": "#/$defs/configurationFailure"
              }
            }
          },
          "else": {
            "properties": {
              "detail": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 128
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "stage": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "cause": {
                        "enum": [
                          "OBSERVATION_FAILED",
                          "RUNTIME",
                          "LINKAGE"
                        ]
                      },
                      "field": {
                        "type": "string",
                        "maxLength": 64
                      }
                    }
                  },
                  {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  },
                  {
                    "$ref": "#/$defs/namedSourceScopeFailure"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "outcome",
        "publication",
        "content",
        "scope",
        "kind",
        "supertype",
        "inheritor",
        "stage",
        "workspaceRoot",
        "host"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "outcome": {
          "const": "published"
        },
        "publication": {
          "const": "request_local_same_source_epoch"
        },
        "content": {
          "const": "saved_committed_ide_vfs"
        },
        "scope": {
          "const": "cached_gradle_source_folders"
        },
        "kind": {
          "const": "inheritors"
        },
        "supertype": {
          "$ref": "#/$defs/declaration"
        },
        "inheritor": {
          "$ref": "#/$defs/declaration"
        },
        "stage": {
          "enum": [
            "REQUEST_ADMISSION",
            "PROJECT_ADMISSION",
            "EPOCH_OBSERVATION",
            "MODEL_CAPTURE",
            "SEMANTIC_READ",
            "CONTENT_REVALIDATION",
            "RESULT_DETACHED"
          ]
        },
        "workspaceRoot": {
          "type": "string",
          "maxLength": 4096
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ideBuild",
            "kotlinBuild"
          ],
          "properties": {
            "ideBuild": {
              "type": "string",
              "maxLength": 128
            },
            "kotlinBuild": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "outcome",
        "publication",
        "content",
        "scope",
        "kind",
        "stage",
        "workspaceRoot",
        "host",
        "name",
        "indexAuthority",
        "declarations"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "outcome": {
          "const": "published"
        },
        "publication": {
          "const": "request_local_same_source_epoch"
        },
        "content": {
          "const": "saved_committed_ide_vfs"
        },
        "scope": {
          "const": "cached_gradle_source_folders"
        },
        "kind": {
          "const": "classes"
        },
        "stage": {
          "enum": [
            "REQUEST_ADMISSION",
            "PROJECT_ADMISSION",
            "EPOCH_OBSERVATION",
            "MODEL_CAPTURE",
            "SEMANTIC_READ",
            "CONTENT_REVALIDATION",
            "RESULT_DETACHED"
          ]
        },
        "workspaceRoot": {
          "type": "string",
          "maxLength": 4096
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ideBuild",
            "kotlinBuild"
          ],
          "properties": {
            "ideBuild": {
              "type": "string",
              "maxLength": 128
            },
            "kotlinBuild": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "indexAuthority": {
          "const": "existing_ide_kotlin_stub_index"
        },
        "declarations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/declaration"
          }
        }
      }
    }
  ],
  "$defs": {
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "compilerIdentity",
        "signature",
        "canonicalSignature",
        "documentStamp",
        "vfsStamp",
        "module",
        "gradleBuildRoot",
        "gradleProject",
        "sourceRoot",
        "sourceKind",
        "provenanceAuthority"
      ],
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 4096
        },
        "compilerIdentity": {
          "type": "string",
          "pattern": "^canonical-signature-sha256-v1\\|[a-f0-9]{64}$"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "qualifiedIdentity"
          ],
          "properties": {
            "kind": {
              "const": "class_like"
            },
            "qualifiedIdentity": {
              "type": "string",
              "maxLength": 4096
            }
          }
        },
        "canonicalSignature": {
          "type": "string",
          "maxLength": 8192
        },
        "documentStamp": {
          "type": "integer"
        },
        "vfsStamp": {
          "type": "integer"
        },
        "module": {
          "type": "string",
          "maxLength": 4096
        },
        "gradleBuildRoot": {
          "type": "string",
          "maxLength": 4096
        },
        "gradleProject": {
          "type": "string",
          "maxLength": 4096
        },
        "sourceRoot": {
          "type": "string",
          "maxLength": 4096
        },
        "sourceKind": {
          "enum": [
            "PRODUCTION",
            "TEST"
          ]
        },
        "provenanceAuthority": {
          "const": "cached_source_folder_flag"
        }
      }
    },
    "moduleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "truncated"
      ],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 512
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "sourceRootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "truncated"
      ],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 8192
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "rootClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provenance"
      ],
      "properties": {
        "kind": {
          "enum": [
            "PRODUCTION",
            "TEST",
            "UNKNOWN"
          ]
        },
        "provenance": {
          "enum": [
            "AUTHORED",
            "GENERATED",
            "UNKNOWN"
          ]
        }
      }
    },
    "namedSourceScopeFailure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause",
            "module",
            "root",
            "reason"
          ],
          "properties": {
            "cause": {
              "const": "IDE_ROOT_UNMAPPED"
            },
            "module": {
              "$ref": "#/$defs/moduleIdentity"
            },
            "root": {
              "$ref": "#/$defs/sourceRootIdentity"
            },
            "reason": {
              "enum": [
                "SOURCE_FOLDER_UNAVAILABLE",
                "SOURCE_FOLDER_OBSERVATION_FAILED",
                "GRADLE_OWNER_MISSING"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause",
            "module",
            "root",
            "reason"
          ],
          "properties": {
            "cause": {
              "const": "IDE_ROOT_INCOHERENT"
            },
            "module": {
              "$ref": "#/$defs/moduleIdentity"
            },
            "root": {
              "$ref": "#/$defs/sourceRootIdentity"
            },
            "reason": {
              "enum": [
                "UNSUPPORTED_ROOT_TYPE",
                "SOURCE_PROPERTIES_UNAVAILABLE"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause",
            "module",
            "root",
            "ide",
            "gradle"
          ],
          "properties": {
            "cause": {
              "const": "ROOT_CLASSIFICATION_MISMATCH"
            },
            "module": {
              "$ref": "#/$defs/moduleIdentity"
            },
            "root": {
              "$ref": "#/$defs/sourceRootIdentity"
            },
            "ide": {
              "$ref": "#/$defs/rootClassification"
            },
            "gradle": {
              "$ref": "#/$defs/rootClassification"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause",
            "module",
            "reason"
          ],
          "properties": {
            "cause": {
              "const": "OWNER_UNAVAILABLE"
            },
            "module": {
              "$ref": "#/$defs/moduleIdentity"
            },
            "reason": {
              "enum": [
                "GRADLE_OWNER_UNAVAILABLE",
                "BUILD_ROOT_UNAVAILABLE",
                "BUILD_ROOT_MALFORMED",
                "MODULE_IDENTITY_MALFORMED",
                "PROJECT_PATH_UNAVAILABLE",
                "PROJECT_PATH_MALFORMED",
                "CACHED_PROJECT_UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "readRecovery": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "check",
            "required",
            "remediation"
          ],
          "properties": {
            "kind": {
              "const": "after_state_change"
            },
            "check": {
              "const": "IDE_STATUS"
            },
            "required": {
              "const": "CACHED_GRADLE_MODEL_COMPLETE"
            },
            "remediation": {
              "const": "OBSERVE_IDE_GRADLE_MODEL"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "check",
            "required",
            "remediation"
          ],
          "properties": {
            "kind": {
              "const": "after_indexing"
            },
            "check": {
              "const": "IDE_STATUS"
            },
            "required": {
              "const": "SMART_MODE"
            },
            "remediation": {
              "const": "WAIT_FOR_IDE_INDEXING"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "review_failure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instruction"
          ],
          "properties": {
            "kind": {
              "const": "reduce_read_work"
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instruction"
          ],
          "properties": {
            "kind": {
              "const": "cancelled"
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instruction"
          ],
          "properties": {
            "kind": {
              "const": "save_source"
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instruction"
          ],
          "properties": {
            "kind": {
              "const": "wait_for_capacity"
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instruction"
          ],
          "properties": {
            "kind": {
              "const": "restart_read"
            },
            "instruction": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    },
    "executionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_elapsed_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "configured_default",
                "caller"
              ]
            },
            "requested": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "configuredDefault": {
              "type": "integer",
              "minimum": 1
            },
            "operatorCeiling": {
              "type": "integer",
              "minimum": 1
            },
            "effective": {
              "type": "integer",
              "minimum": 1
            },
            "clamping": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "operator_ceiling",
                  "transport_capacity",
                  "deadline_remaining"
                ]
              }
            }
          },
          "required": [
            "selection",
            "requested",
            "configuredDefault",
            "operatorCeiling",
            "effective",
            "clamping"
          ]
        },
        "max_work_units": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "configured_default",
                "caller"
              ]
            },
            "requested": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "configuredDefault": {
              "type": "integer",
              "minimum": 1
            },
            "operatorCeiling": {
              "type": "integer",
              "minimum": 1
            },
            "effective": {
              "type": "integer",
              "minimum": 1
            },
            "clamping": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "operator_ceiling",
                  "transport_capacity",
                  "deadline_remaining"
                ]
              }
            }
          },
          "required": [
            "selection",
            "requested",
            "configuredDefault",
            "operatorCeiling",
            "effective",
            "clamping"
          ]
        },
        "max_results": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "configured_default",
                "caller"
              ]
            },
            "requested": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "configuredDefault": {
              "type": "integer",
              "minimum": 1
            },
            "operatorCeiling": {
              "type": "integer",
              "minimum": 1
            },
            "effective": {
              "type": "integer",
              "minimum": 1
            },
            "clamping": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "operator_ceiling",
                  "transport_capacity",
                  "deadline_remaining"
                ]
              }
            }
          },
          "required": [
            "selection",
            "requested",
            "configuredDefault",
            "operatorCeiling",
            "effective",
            "clamping"
          ]
        },
        "max_returned_bytes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selection": {
              "type": "string",
              "enum": [
                "configured_default",
                "caller"
              ]
            },
            "requested": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "configuredDefault": {
              "type": "integer",
              "minimum": 1
            },
            "operatorCeiling": {
              "type": "integer",
              "minimum": 1
            },
            "effective": {
              "type": "integer",
              "minimum": 1
            },
            "clamping": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "operator_ceiling",
                  "transport_capacity",
                  "deadline_remaining"
                ]
              }
            }
          },
          "required": [
            "selection",
            "requested",
            "configuredDefault",
            "operatorCeiling",
            "effective",
            "clamping"
          ]
        }
      },
      "required": [
        "max_elapsed_ms",
        "max_work_units",
        "max_results",
        "max_returned_bytes"
      ]
    },
    "configurationFailure": {
      "oneOf": [
        {
          "properties": {
            "cause": {
              "enum": [
                "UNKNOWN_PARAMETER"
              ]
            }
          },
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause"
          ]
        },
        {
          "required": [
            "cause",
            "parameter"
          ],
          "properties": {
            "cause": {
              "enum": [
                "INVALID_NUMBER",
                "OUT_OF_RANGE"
              ]
            },
            "parameter": {
              "$ref": "#/$defs/readLimitParameter"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        {
          "required": [
            "cause",
            "inner",
            "outer"
          ],
          "properties": {
            "cause": {
              "enum": [
                "INCONSISTENT_BOUNDS"
              ]
            },
            "inner": {
              "$ref": "#/$defs/readLimitParameter"
            },
            "outer": {
              "$ref": "#/$defs/readLimitParameter"
            }
          },
          "type": "object",
          "additionalProperties": false
        }
      ]
    },
    "readLimitParameter": {
      "enum": [
        "KAST_READ_MODEL_CACHED_GRADLE_MODELS",
        "KAST_READ_MODEL_MODULES",
        "KAST_READ_MODEL_SOURCE_ROOTS_PER_MODULE",
        "KAST_READ_MODEL_CLASSPATH_ENTRIES_PER_MODULE",
        "KAST_READ_MODEL_IDENTITY_CHARACTERS",
        "KAST_READ_MODEL_PATH_CHARACTERS",
        "KAST_READ_MODEL_CLASSPATH_URL_CHARACTERS",
        "KAST_READ_EPOCH_CACHED_GRADLE_MODELS",
        "KAST_READ_EPOCH_VFS_EVENTS",
        "KAST_READ_EPOCH_PATH_CHARACTERS",
        "KAST_READ_EPOCH_PATH_BYTES",
        "KAST_READ_HOST_QUERY_MILLIS",
        "KAST_READ_SEMANTIC_MILLIS",
        "KAST_READ_EXECUTION_MAX_MILLIS",
        "KAST_READ_EXECUTION_MAX_WORK",
        "KAST_READ_EXECUTION_MAX_RESULTS",
        "KAST_READ_EXECUTION_MAX_RETURNED_BYTES",
        "KAST_READ_SEMANTIC_WORK",
        "KAST_READ_SEMANTIC_RESULTS",
        "KAST_READ_SEMANTIC_RETURNED_BYTES",
        "KAST_READ_QUERY_CHECKPOINT_BYTES",
        "KAST_READ_QUERY_CONTINUATION_ENTRIES",
        "KAST_READ_QUERY_CONTINUATION_BYTES",
        "KAST_READ_QUERY_CONTINUATION_TTL_MILLIS",
        "KAST_READ_DISCOVERY_FILES",
        "KAST_READ_DISCOVERY_NAMES",
        "KAST_READ_DISCOVERY_CANDIDATES",
        "KAST_READ_RELATION_CANDIDATES",
        "KAST_READ_SOURCE_ENTITY_WORK",
        "KAST_READ_SOURCE_CONTINUATIONS",
        "KAST_READ_SOURCE_CONTINUATION_BYTES",
        "KAST_READ_SOURCE_CONTINUATION_TTL_MILLIS",
        "KAST_READ_SOURCE_ENTITIES",
        "KAST_READ_SOURCE_RETURNED_BYTES",
        "KAST_READ_TRAVERSAL_DEPTH",
        "KAST_READ_TRAVERSAL_FRONTIER",
        "KAST_READ_HOST_REFERENCE_ENTRIES",
        "KAST_READ_HOST_REFERENCE_BYTES",
        "KAST_READ_HOST_REQUEST_BYTES",
        "KAST_READ_HOST_RESPONSE_BYTES",
        "KAST_READ_HOST_DESCRIPTOR_BYTES",
        "KAST_READ_HOST_ACCEPT_BACKLOG",
        "KAST_READ_HOST_CONNECTIONS",
