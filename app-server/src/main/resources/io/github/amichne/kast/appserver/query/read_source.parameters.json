{
  "type": "object",
  "properties": {
    "symbolRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "description": "Exact Kast symbol reference. Copy the token unchanged."
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DECLARATION",
        "FILE",
        "CLASS_BODY",
        "CALLABLE_BODY",
        null
      ],
      "description": "Omission or null selects the declaration."
    },
    "text": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceText"
        },
        {
          "type": "null"
        }
      ]
    },
    "entities": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceEntities"
        },
        {
          "type": "null"
        }
      ]
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcePage"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionBudget": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionBudget"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "symbolRef"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExecutionBudget": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional execution allowances. Null or omitted dimensions use configured defaults; positive values are independently clamped to operator and transport ceilings. These controls do not alter query take, scope, or projection.",
      "properties": {
        "maxElapsedMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "maxWorkUnits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "maxResults": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxReturnedBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    },
    "SourceTextComplete": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMPLETE"
          ],
          "default": "COMPLETE"
        },
        "maxBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1048576,
          "default": 65536
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceTextNone": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NONE"
          ],
          "default": "NONE"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceTextWindow": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "WINDOW"
          ],
          "default": "WINDOW"
        },
        "beforeLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        },
        "afterLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        },
        "maxBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1048576,
          "default": 65536
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceTextComplete"
        },
        {
          "$ref": "#/$defs/SourceTextNone"
        },
        {
          "$ref": "#/$defs/SourceTextWindow"
        }
      ]
    },
    "SourceFilterDeclarations": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DECLARATIONS"
          ],
          "default": "DECLARATIONS"
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CLASSLIKE",
              "CONSTRUCTOR",
              "FUNCTION",
              "PROPERTY",
              "TYPE_ALIAS"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "visibilities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PROTECTED",
              "INTERNAL",
              "PRIVATE",
              "LOCAL"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "kinds"
      ],
      "additionalProperties": false
    },
    "SourceFilterParameters": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PARAMETERS"
          ],
          "default": "PARAMETERS"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceFilterCalls": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CALLS"
          ],
          "default": "CALLS"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceFilterReferences": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "REFERENCES"
          ],
          "default": "REFERENCES"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceFilter": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceFilterDeclarations"
        },
        {
          "$ref": "#/$defs/SourceFilterParameters"
        },
        {
          "$ref": "#/$defs/SourceFilterCalls"
        },
        {
          "$ref": "#/$defs/SourceFilterReferences"
        }
      ]
    },
    "SourceEntitiesNone": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NONE"
          ],
          "default": "NONE"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceEntitiesMatching": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MATCHING"
          ],
          "default": "MATCHING"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceFilter"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "containment": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DIRECT",
            "DESCENDANTS",
            null
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000,
          "default": 250
        }
      },
      "required": [
        "type",
        "filters"
      ],
      "additionalProperties": false
    },
    "SourceEntities": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceEntitiesNone"
        },
        {
          "$ref": "#/$defs/SourceEntitiesMatching"
        }
      ]
    },
    "SourcePageFirst": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FIRST"
          ],
          "default": "FIRST"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourcePageContinue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "CONTINUE"
          ],
          "default": "CONTINUE"
        },
        "continuation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "type",
        "continuation"
      ],
      "additionalProperties": false
    },
    "SourcePage": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcePageFirst"
        },
        {
          "$ref": "#/$defs/SourcePageContinue"
        }
      ]
    }
  }
}
