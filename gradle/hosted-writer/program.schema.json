{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/schemas/hosted-writer/program.schema.json",
  "title": "Kast hosted-writer fixed program",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tasks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "goal", "dependencies", "allowedReads", "allowedWrites",
        "command", "expectedProof", "forbiddenWork", "reviewBoundary"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonBlank" },
        "title": { "$ref": "#/$defs/nonBlank" },
        "goal": { "$ref": "#/$defs/nonBlank" },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        },
        "allowedReads": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        },
        "allowedWrites": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        },
        "command": { "$ref": "#/$defs/nonBlank" },
        "expectedProof": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        },
        "forbiddenWork": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" },
          "uniqueItems": true
        },
        "reviewBoundary": { "$ref": "#/$defs/nonBlank" }
      }
    }
  }
}
