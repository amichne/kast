{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.michne.com/schemas/query.schema.json",
  "type": "object",
  "description": "Agent-facing query syntax. Defaults are fixed by this contract, not by the environment. This schema does not confer compiler authority.",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "QUERY"
      ],
      "description": "Shape discriminator.",
      "examples": [
        "QUERY"
      ]
    },
    "from": {
      "$ref": "#/$defs/Source"
    },
    "steps": {
      "$ref": "#/$defs/Steps"
    },
    "select": {
      "$ref": "#/$defs/Selection"
    }
  },
  "required": [
    "type",
    "from"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "QUERY",
      "from": {
        "type": "SEARCH",
        "query": "OrderService"
      }
    }
  ],
  "$defs": {
    "QueryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "[\\s\\S]*\\S[\\s\\S]*",
      "description": "Declaration name to match. Blank text is rejected; use ALL for enumeration. At most 256 UTF-16 code units at canonical admission.",
      "examples": [
        "OrderService"
      ]
    },
    "ExactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^exact:v[23]:[\\s\\S]+$",
      "description": "Copy items[].ref.token from an exact-symbol result verbatim. This prefix check is syntax only; Kast still validates workspace, read authority and compiler identity.",
      "examples": [
        "exact:v3:EXAMPLE_NOT_ISSUED"
      ]
    },
    "DirectoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*(?:^|/)\\s*(?:/|$))[^\\x00-\\x1F\\x7F-\\x9F]+)$",
      "description": "Canonical path relative to the workspace root. A single dot means the root. Absolute paths, backslashes, empty segments, embedded dot segments and parent traversal are rejected; spelling is preserved.",
      "examples": [
        ".",
        "services/orders"
      ],
      "x-kotlin-type": "WorkspaceRelativePath"
    },
    "PackageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^(?!.*\\.(?:[0-9.]|$))[A-Za-z_][A-Za-z0-9_.]*$",
      "description": "Semantic Kotlin package name; not a path. Uses the currently supported ASCII package-name grammar.",
      "examples": [
        "com.example.orders"
      ],
      "x-kotlin-type": "PublicQueryPackageName"
    },
    "Match": {
      "type": "string",
      "enum": [
        "EXACT",
        "FUZZY"
      ],
      "description": "Omitted means exact declaration-name matching. Exact does not select one overload. Fuzzy matching requires explicit opt-in.",
      "examples": [
        "EXACT"
      ],
      "default": "EXACT"
    },
    "DeclarationKind": {
      "type": "string",
      "enum": [
        "CLASS",
        "FUNCTION",
        "PROPERTY",
        "TYPE_ALIAS"
      ],
      "description": "Supported discovery family. Class includes the existing class-like family; constructors are not discoverable through this source.",
      "examples": [
        "FUNCTION"
      ]
    },
    "SourceSet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "[\\s\\S]*\\S[\\s\\S]*",
      "description": "Exact Gradle source-set name from the imported model, including custom and multiplatform names. Not a production/test category or filesystem glob.",
      "examples": [
        "main",
        "integrationTest",
        "commonMain"
      ]
    },
    "Containment": {
      "type": "string",
      "enum": [
        "DIRECT",
        "RECURSIVE"
      ],
      "description": "Omitted searches recursively, including this directory or package and all nested directories or subpackages. DIRECT selects only this directory or package.",
      "examples": [
        "RECURSIVE"
      ],
      "default": "RECURSIVE"
    },
    "Visibility": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "PROTECTED",
        "INTERNAL",
        "PRIVATE",
        "LOCAL"
      ],
      "description": "Compiler-established declaration visibility.",
      "examples": [
        "PUBLIC"
      ]
    },
    "Relation": {
      "type": "string",
      "enum": [
        "REFERENCES",
        "CALLERS",
        "CALLEES",
        "IMPLEMENTATIONS",
        "INHERITORS",
        "OVERRIDES",
        "TYPE_USES"
      ],
      "description": "One compiler-confirmed semantic hop. Callers returns calling declarations; callees returns called declarations.",
      "examples": [
        "CALLERS"
      ]
    },
    "Field": {
      "type": "string",
      "enum": [
        "NAME",
        "LOCATION",
        "SIGNATURE"
      ],
      "description": "Optional result projection. Existing ref and kind fields are always retained.",
      "examples": [
        "NAME"
      ]
    },
    "Kinds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeclarationKind"
      },
      "minItems": 1,
      "maxItems": 4,
      "description": "Omitted includes every supported discovery family. Empty and duplicate lists are rejected.",
      "examples": [
        [
          "FUNCTION"
        ]
      ],
      "uniqueItems": true,
      "default": [
        "CLASS",
        "FUNCTION",
        "PROPERTY",
        "TYPE_ALIAS"
      ]
    },
    "SourceSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SourceSet"
      },
      "minItems": 1,
      "maxItems": 1000,
      "description": "Omitted selects names main and test. Explicit names intersect with directory and package restrictions; names with no matching roots contribute no declarations.",
      "examples": [
        [
          "main"
        ],
        [
          "integrationTest",
          "commonMain",
          "jvmTest"
        ]
      ],
      "uniqueItems": true,
      "default": [
        "main",
        "test"
      ]
    },
    "Selection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Field"
      },
      "minItems": 0,
      "maxItems": 3,
      "description": "Omitted returns name and location. Empty requests ref and kind only; it does not restore defaults.",
      "examples": [
        [
          "NAME",
          "LOCATION"
        ]
      ],
      "uniqueItems": true,
      "default": [
        "NAME",
        "LOCATION"
      ]
    },
    "Steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 0,
      "maxItems": 1000,
      "description": "Ordered left-to-right transformations. Omitted means no steps. Never reorder filters around expansion.",
      "examples": [
        []
      ],
      "default": []
    },
    "RefsList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "minItems": 1,
      "maxItems": 1000,
      "description": "Non-empty returned exact-symbol tokens. No candidate promotion, guessing or alias lookup.",
      "examples": [
        [
          "exact:v3:EXAMPLE_NOT_ISSUED"
        ]
      ]
    },
    "VisibilityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Visibility"
      },
      "minItems": 1,
      "maxItems": 5,
      "description": "Non-empty set of accepted visibilities; unproved predicates remain incomplete evidence, never a negative match.",
      "examples": [
        [
          "PUBLIC"
        ]
      ],
      "uniqueItems": true
    },
    "Scope": {
      "type": "object",
      "description": "Exactly one directory or package target. Source-set restrictions intersect with the target. Containment applies to either target. Scope does not restrict later expansion destinations.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DIRECTORY",
            "PACKAGE"
          ],
          "description": "Selects the grammar and meaning of value.",
          "examples": [
            "DIRECTORY",
            "PACKAGE"
          ]
        },
        "value": {
          "$ref": "#/$defs/ScopeValue"
        },
        "containment": {
          "$ref": "#/$defs/Containment"
        },
        "sourceSets": {
          "$ref": "#/$defs/SourceSets"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "DIRECTORY",
          "value": "services/orders"
        },
        {
          "type": "PACKAGE",
          "value": "com.example.orders",
          "containment": "DIRECT"
        }
      ],
      "default": {
        "type": "DIRECTORY",
        "value": "."
      },
      "x-kotlin-variants": {
        "DIRECTORY": "DirectoryPath",
        "PACKAGE": "PackageName"
      }
    },
    "Search": {
      "type": "object",
      "description": "Find matching declarations and establish exact compiler identities. Multiple overloads remain separate symbols.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SEARCH"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "SEARCH"
          ]
        },
        "query": {
          "$ref": "#/$defs/QueryText"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "kinds": {
          "$ref": "#/$defs/Kinds"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "type",
        "query"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "SEARCH",
          "query": "OrderService"
        }
      ]
    },
    "All": {
      "type": "object",
      "description": "Explicit bounded enumeration. Budget exhaustion remains partial coverage; ALL never implies unbounded work.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ALL"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "ALL"
          ]
        },
        "kinds": {
          "$ref": "#/$defs/Kinds"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "ALL",
          "kinds": [
            "CLASS"
          ]
        }
      ]
    },
    "Refs": {
      "type": "object",
      "description": "Start from exact-symbol references previously returned by Kast.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "REFS"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "REFS"
          ]
        },
        "refs": {
          "$ref": "#/$defs/RefsList"
        }
      },
      "required": [
        "type",
        "refs"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "REFS",
          "refs": [
            "exact:v3:EXAMPLE_NOT_ISSUED"
          ]
        }
      ]
    },
    "Source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Search"
        },
        {
          "$ref": "#/$defs/All"
        },
        {
          "$ref": "#/$defs/Refs"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Every source yields exact symbols or explicit incomplete/rejected evidence. Candidates are internal to Kast.",
      "examples": [
        {
          "type": "SEARCH",
          "query": "OrderService"
        },
        {
          "type": "ALL",
          "kinds": [
            "CLASS"
          ]
        },
        {
          "type": "REFS",
          "refs": [
            "exact:v3:EXAMPLE_NOT_ISSUED"
          ]
        }
      ]
    },
    "Filter": {
      "type": "object",
      "description": "Filter the current symbol stream by compiler-established visibility.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FILTER"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "FILTER"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityList"
        }
      },
      "required": [
        "type",
        "visibility"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "FILTER",
          "visibility": [
            "PUBLIC"
          ]
        }
      ]
    },
    "Expand": {
      "type": "object",
      "description": "Expand the current symbols by exactly one semantic hop, retaining relation evidence.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EXPAND"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "EXPAND"
          ]
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        }
      },
      "required": [
        "type",
        "relation"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "EXPAND",
          "relation": "CALLERS"
        }
      ]
    },
    "Distinct": {
      "type": "object",
      "description": "Deduplicate exact symbols using the existing engine operation, preserving contributing relation evidence.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DISTINCT"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "DISTINCT"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "DISTINCT"
        }
      ]
    },
    "Step": {
      "anyOf": [
        {
          "$ref": "#/$defs/Filter"
        },
        {
          "$ref": "#/$defs/Expand"
        },
        {
          "$ref": "#/$defs/Distinct"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Closed symbol-to-symbol transformations. INSPECT is intentionally not public.",
      "examples": [
        {
          "type": "FILTER",
          "visibility": [
            "PUBLIC"
          ]
        },
        {
          "type": "EXPAND",
          "relation": "CALLERS"
        },
        {
          "type": "DISTINCT"
        }
      ]
    },
    "ScopeValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "[\\s\\S]*\\S[\\s\\S]*",
      "description": "DIRECTORY: canonical workspace-relative path, with . for the root. PACKAGE: dotted Kotlin package name. The typed parser validates the grammar selected by type.",
      "examples": [
        ".",
        "services/orders",
        "com.example.orders"
      ]
    }
  }
}
