{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "jsonrpc": {
      "enum": [
        "2.0"
      ],
      "type": "string"
    },
    "method": {
      "enum": [
        "repository/query"
      ],
      "type": "string"
    },
    "params": {
      "additionalProperties": false,
      "properties": {
        "evidenceContinuation": {
          "additionalProperties": false,
          "properties": {
            "afterOccurrenceId": {
              "type": "integer"
            },
            "context": {
              "type": "string"
            },
            "derived": {
              "type": "boolean"
            },
            "kind": {
              "enum": [
                "CALLS",
                "CASE_OF",
                "CONTAINS",
                "DELEGATES",
                "IMPLEMENTS",
                "INHERITS",
                "METHOD",
                "OVERRIDES",
                "REFERENCES",
                "SEALED_MEMBER"
              ],
              "type": "string"
            },
            "sourceKey": {
              "type": "string"
            },
            "targetKey": {
              "type": "string"
            }
          },
          "required": [
            "sourceKey",
            "targetKey",
            "kind",
            "context",
            "derived",
            "afterOccurrenceId"
          ],
          "type": "object"
        },
        "intent": {
          "enum": [
            "resolve",
            "path",
            "incoming_impact",
            "outgoing_impact"
          ],
          "type": "string"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "depth": {
              "type": "integer"
            },
            "evidence": {
              "type": "integer"
            },
            "results": {
              "type": "integer"
            }
          },
          "required": [
            "depth",
            "results",
            "evidence"
          ],
          "type": "object"
        },
        "question": {
          "type": "string"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": [
                "INCOMING",
                "OUTGOING"
              ],
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "maxDepth": {
              "type": "integer"
            },
            "module": {
              "type": "string"
            },
            "relations": {
              "items": {
                "enum": [
                  "CALLS",
                  "CASE_OF",
                  "CONTAINS",
                  "DELEGATES",
                  "IMPLEMENTS",
                  "INHERITS",
                  "METHOD",
                  "OVERRIDES",
                  "REFERENCES",
                  "SEALED_MEMBER"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "sourceSet": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "workspaceRoot": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "question",
        "intent",
        "limits"
      ],
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "params",
    "id"
  ],
  "title": "Kast repository/query JSON-RPC request",
  "type": "object"
}
