model {
  developer = person "User or coding agent" {
    #public
    description "Invokes Kast and consumes typed compiler evidence."
    metadata {
      boundary "public"
      trust "caller"
    }
  }

  installer = adapter "install.sh bootstrap" {
    #adapter
    description "Downloads or opens a bundle, then delegates persistent installation to `kast setup`."
    link https://github.com/amichne/kast/blob/main/install.sh "Source"
  }

  codexHooks = adapter "Codex hooks" {
    #adapter
    description "Translate session-start and successful Kotlin write events into Kast CLI commands."
    link https://github.com/amichne/kast/blob/main/cli-rs/src/interface/codex/hook/runtime.rs "Source"
  }

  ideaPlatform = platform "IntelliJ Platform" {
    #compiler
    description "Private IntelliJ platform inside Kast's isolated exact-root headless process."
    icon tech:intellij-idea
    metadata {
      supportedBuilds ["IDEA 262", "Android Studio 261"]
      readiness ["INDEXING", "READY"]
    }

    gradleModel = service "Gradle project model" {
      #live
      description "Linked builds, imported modules, source roots, SDKs, and source-set ownership."
      metadata {
        retention "live isolated headless project state"
      }
    }

    smartMode = contract "Smart mode gate" {
      #live #proof
      description "DumbService gate that delays compiler admission and indexing until IntelliJ indexes settle."
    }

    vfs = service "Virtual File System" {
      #live
      description "Discovers and refreshes workspace files before PSI admission."
    }

    kotlinIndex = service "Kotlin file index" {
      #live
      description "FileTypeIndex evidence that a VirtualFile is admitted as Kotlin."
    }
  }

  kotlinCompiler = platform "Kotlin compiler stack" {
    #compiler
    description "Live PSI and K2 semantic state queried through the Kotlin Analysis API."
    icon tech:kotlin

    psi = service "PSI" {
      #compiler #live
      description "KtFile syntax trees, declarations, references, and edit state. PSI objects are never retained in SQLite."
      technology "IntelliJ PSI"
    }

    analysisApi = contract "Analysis API" {
      #compiler #live
      description "KaSession boundary for compiler-owned symbols, types, calls, and diagnostics."
      technology "Kotlin Analysis API"
    }

    k2Frontend = service "K2 Frontend" {
      #compiler #live
      description "Kotlin semantic analysis, call resolution, and type inference used by the IDE."
      technology "K2"
    }

    fir = service "FIR semantic model" {
      #compiler #live
      description "Compiler-internal Frontend Intermediate Representation below the Analysis API; Kast does not retain or call FIR directly."
      technology "FIR"
    }
  }

  workspaceState = datastore "Workspace state" {
    #persisted
    description "Active release receipt, exact-root descriptors, configuration, and local caches."
    metadata {
      identity "canonical workspace root"
      authority "active installation receipt"
    }
  }

  kast = platform "Kast" {
    #public #proof
    description """
      One typed command-line boundary for compiler-backed Kotlin discovery,
      runtime lifecycle, evidence, and semantic mutation.
    """
    link https://github.com/amichne/kast "Repository"

    cli = executable "kast CLI" {
      #public
      technology "Rust + Clap"
      description "Parses public commands and dispatches typed command families."
      metadata {
        source "cli-rs/src/interface/cli/root.rs"
        output ["human", "TOON", "JSON compatibility"]
      }
      link https://github.com/amichne/kast/blob/main/cli-rs/src/interface/cli/root.rs "Source"
    }

    control = service "Local control and runtime admission" {
      technology "Rust"
      description "Owns setup, configuration, exact-root backend selection, readiness, and lifecycle."
      metadata {
        source "cli-rs/src/execution/runtime/backend/workspace.rs"
        invariant "exact semantic workspace"
      }
      link https://github.com/amichne/kast/blob/main/cli-rs/src/execution/runtime/backend/workspace.rs "Source"
    }

    agent = service "Agent command dispatch" {
      #public
      technology "Rust"
      description "Normalizes agent commands into bounded requests with coverage and next-action evidence."
      metadata {
        source "cli-rs/src/agent/core/dispatch/commands.rs"
        request "AgentEnvelope"
      }
      link https://github.com/amichne/kast/blob/main/cli-rs/src/agent/core/dispatch/commands.rs "Source"
    }

    rpcClient = service "Runtime client" {
      technology "Rust + local socket"
      description "Validates the internal command catalog and exchanges typed JSON-RPC messages."
      metadata {
        transport "Unix domain socket or local runtime transport"
        scope "exact workspace"
      }
    }

    server = platform "Analysis server" {
      dispatcher = service "RpcAnalysisDispatcher" {
        technology "Kotlin coroutines"
        description "Validates JSON-RPC envelopes and applies bounded request timeouts."
        metadata {
          fqName "io.github.amichne.kast.server.dispatch.RpcAnalysisDispatcher"
          source "analysis-server/src/main/kotlin/io/github/amichne/kast/server/dispatch/RpcAnalysisDispatcher.kt"
        }
        link https://github.com/amichne/kast/blob/main/analysis-server/src/main/kotlin/io/github/amichne/kast/server/dispatch/RpcAnalysisDispatcher.kt "Source"
      }

      router = service "RpcMethodRouter" {
        technology "Kotlin"
        description "Checks advertised capabilities and routes raw, skill, lifecycle, and mutation methods."
        metadata {
          fqName "io.github.amichne.kast.server.dispatch.RpcMethodRouter"
          kastEvidence "compiler-resolved"
        }
        link https://github.com/amichne/kast/blob/main/analysis-server/src/main/kotlin/io/github/amichne/kast/server/dispatch/RpcMethodRouter.kt "Source"
      }

      orchestrator = service "SkillRpcOrchestrator" {
        technology "Kotlin"
        description "Owns compiler-backed discovery, navigation, diagnostics, and semantic workflows."
        metadata {
          fqName "io.github.amichne.kast.server.SkillRpcOrchestrator"
          source "analysis-server/src/main/kotlin/io/github/amichne/kast/server/skill/SkillRpcOrchestrator.kt"
        }
        link https://github.com/amichne/kast/blob/main/analysis-server/src/main/kotlin/io/github/amichne/kast/server/skill/SkillRpcOrchestrator.kt "Source"
      }

      mutation = service "MutationExecutionService" {
        technology "Kotlin"
        description "Plans and applies semantic mutations while preserving terminal validation evidence."
        link https://github.com/amichne/kast/blob/main/analysis-server/src/main/kotlin/io/github/amichne/kast/server/mutation/MutationExecutionService.kt "Source"
      }
    }

    backend = platform "Compiler backend" {
      api = contract "AnalysisBackend" {
        #compiler
        technology "Kotlin interface"
        description "Shared typed boundary implemented by compiler-backed hosts."
        metadata {
          fqName "io.github.amichne.kast.api.contract.backend.AnalysisBackend"
          source "analysis-api/src/main/kotlin/io/github/amichne/kast/api/contract/backend/AnalysisBackend.kt"
        }
        link https://github.com/amichne/kast/blob/main/analysis-api/src/main/kotlin/io/github/amichne/kast/api/contract/backend/AnalysisBackend.kt "Source"
      }

      idea = service "Private compiler implementation" {
        #compiler
        technology "IntelliJ PSI + Kotlin K2"
        description "Executes reads and writes inside the isolated IntelliJ runtime. It is not a foreground plugin service."
        metadata {
          fqName "io.github.amichne.kast.idea.backend.KastPluginBackend"
          kastEvidence "compiler-resolved"
        }
        link https://github.com/amichne/kast/blob/main/backend-idea/src/main/kotlin/io/github/amichne/kast/idea/backend/KastPluginBackend.kt "Source"
      }

      ideaAdmission = contract "Headless semantic admission" {
        #compiler #proof
        technology "DumbService + PSI + Analysis API"
        description "Proves smart mode, Kotlin modules and classpaths, PSI availability, and Analysis API diagnostics."
        metadata {
          fqName "io.github.amichne.kast.idea.IdeaIndexSemanticAdmission"
          retention "typed readiness evidence only"
        }
        link https://github.com/amichne/kast/blob/main/backend-idea/src/main/kotlin/io/github/amichne/kast/idea/IdeaIndexSemanticAdmission.kt "Source"
      }

      ideaRefresh = service "Focused compiler refresh" {
        #compiler #trigger
        technology "VFS + FileTypeIndex + PSI"
        description "Refreshes selected paths through VFS and Kotlin admission. It does not rebuild references or semantic graph rows."
        link https://github.com/amichne/kast/blob/main/backend-idea/src/main/kotlin/io/github/amichne/kast/idea/backend/mutation/MutationOperations.kt "Source"
      }

      ideaDiagnostics = service "Compiler diagnostics" {
        #compiler #proof
        technology "PSI + Analysis API"
        description "Captures compiler diagnostics with a PSI generation and current content hash."
        link https://github.com/amichne/kast/blob/main/backend-idea/src/main/kotlin/io/github/amichne/kast/idea/backend/diagnostics/DiagnosticOperations.kt "Source"
      }

      headless = service "HeadlessRuntime bootstrap" {
        technology "IntelliJ headless runtime"
        description "Starts the only production semantic runtime on every supported host."
        metadata {
          fqName "io.github.amichne.kast.headless.runtime.HeadlessRuntime"
          source "backend-headless/src/main/kotlin/io/github/amichne/kast/headless/runtime/HeadlessRuntime.kt"
        }
        link https://github.com/amichne/kast/blob/main/backend-headless/src/main/kotlin/io/github/amichne/kast/headless/runtime/HeadlessRuntime.kt "Source"
      }
    }

    indexing = platform "Indexing and refresh pipelines" {
      #indexing
      description "Headless-bootstrap reference indexing and explicit semantic graph refresh remain separate retained products."

      projectOpen = service "Headless bootstrap index trigger" {
        #trigger
        technology "HeadlessRuntime"
        description "Runs after isolated exact-root open and Gradle import; the production trigger for full source and relationship indexing."
        link https://github.com/amichne/kast/blob/main/backend-headless/src/main/kotlin/io/github/amichne/kast/headless/runtime/HeadlessRuntime.kt "Source"
      }

      projectIndexer = service "IdeaProjectIndexer" {
        #indexing
        technology "Kotlin coroutines"
        description "Builds the complete identifier inventory, then dependency-prioritized declarations and references."
        metadata {
          fqName "io.github.amichne.kast.idea.IdeaProjectIndexer"
          trigger "headless bootstrap, explicit demand, or configuration reload"
        }
        link https://github.com/amichne/kast/blob/main/backend-idea/src/main/kotlin/io/github/amichne/kast/idea/workspace/indexing/IdeaProjectIndexer.kt "Source"
      }

      sourceScanner = service "Identifier inventory scanner" {
        #indexing
        technology "PsiSourceIndexScanner"
        description "Reads eligible Kotlin text and retains identifiers, imports, package evidence, and Gradle ownership."
        link https://github.com/amichne/kast/blob/main/backend-shared/src/main/kotlin/io/github/amichne/kast/shared/analysis/PsiSourceIndexScanner.kt "Source"
      }

      referenceIndexer = service "ReferenceIndexer" {
        #indexing
        technology "Bounded coroutine batches"
        description "Lazily batches module-prioritized files, scans outside transactions, and serializes successful SQLite writes."
        metadata {
          fqName "io.github.amichne.kast.indexstore.indexing.ReferenceIndexer"
          incrementalCallers "none in production"
        }
        link https://github.com/amichne/kast/blob/main/index-store/src/main/kotlin/io/github/amichne/kast/indexstore/indexing/ReferenceIndexer.kt "Source"
      }

      referenceScanner = service "PSI reference resolver" {
        #compiler #indexing
        technology "PsiReferenceScanner"
        description "Walks PSI, resolves references to KtNamedDeclaration targets, and classifies typed reference occurrences."
        link https://github.com/amichne/kast/blob/main/backend-shared/src/main/kotlin/io/github/amichne/kast/shared/analysis/PsiReferenceScanner.kt "Source"
      }

      declarationScanner = service "PSI declaration scanner" {
        #compiler #indexing
        technology "Kotlin PSI"
        description "Extracts canonical declarations and supertypes for retained exact-reference identity."
      }

      graphExtractor = service "Scoped semantic graph extractor" {
        #compiler #indexing
        technology "PSI + K2 Analysis API"
        description "Diagnostic-gated extraction of symbols, types, calls, ownership, and typed edge occurrences."
        link https://github.com/amichne/kast/blob/main/backend-idea/src/main/kotlin/io/github/amichne/kast/idea/backend/semantic/SemanticGraphExtraction.kt "Source"
      }

      graphWriter = service "SemanticGraphWriter" {
        #indexing
        technology "SQLite transaction"
        description "Atomically replaces selected semantic files, deletes removals, and advances the shared generation."
        metadata {
          fqName "io.github.amichne.kast.indexstore.store.sqlite.semantic.SemanticGraphWriter"
        }
        link https://github.com/amichne/kast/blob/main/index-store/src/main/kotlin/io/github/amichne/kast/indexstore/store/sqlite/semantic/SemanticGraphWriter.kt "Source"
      }

      referenceLookup = service "Exact reference lookup" {
        #proof
        technology "SQLite first, PSI fallback"
        description "Binds FQN, target path, declaration offset, and generation; rehydrates rows in PSI or falls back to bounded live search."
      }

      snapshotCoordinator = service "Repository snapshot coordinator" {
        #indexing
        technology "Immutable base + worktree overlay"
        description "Hydrates compatible retained state and publishes only stable, complete main indexes."
      }

      refreshStatus = contract "refresh_status evidence" {
        #proof
        description "Per-path admission, content hash, diagnostics, omissions, symbol and edge counts, scope fingerprint, and generation."
      }
    }

    evidence = platform "Evidence and projection" {
      index = platform "SqliteSourceIndexStore" {
        #persisted #proof
        technology "SQLite WAL"
        description "One workspace-scoped source-index.db with independently refreshed reference and semantic graph partitions."
        icon tech:sqlite
        metadata {
          fqName "io.github.amichne.kast.indexstore.store.SqliteSourceIndexStore"
          kastEvidence "compiler-resolved"
          pragmas ["journal_mode=WAL", "synchronous=NORMAL", "busy_timeout=5000"]
        }
        link https://github.com/amichne/kast/blob/main/index-store/src/main/kotlin/io/github/amichne/kast/indexstore/store/SqliteSourceIndexStore.kt "Source"

        writer = service "Serialized SQLite writer" {
          #persisted
          technology "SqliteSourceIndexStoreState.writeLock"
          description "Keeps parallel compiler scans outside transactions and serializes each retained batch."
        }

        interning = service "StringInterningCodec cache" {
          #persisted
          technology "Path prefix and FQN interning"
          description "Hydrates in-memory codecs once and reloads them when PRAGMA main.data_version proves an external commit."
          link https://github.com/amichne/kast/blob/main/index-store/src/main/kotlin/io/github/amichne/kast/indexstore/store/StringInterningCodec.kt "Source"
        }

        inventory = datastore "Source inventory and manifest" {
          #persisted
          description "Identifier paths, imports, packages, file hashes, and Gradle project/source-set ownership."
        }

        relationships = datastore "Declarations and reference occurrences" {
          #persisted
          description "Canonical declarations, supertypes, and typed symbol reference occurrences."
        }

        moduleProgress = datastore "Module progress" {
          #persisted #proof
          description "PENDING, INDEXING, and COMPLETE relationship-index state by module."
        }

        semanticGraph = datastore "semantic_files and graph facts" {
          #persisted #proof
          description "Selected file hashes and diagnostics, symbols, types, annotations, and edge occurrences."
        }

        generation = datastore "Schema and generation guard" {
          #persisted #proof
          description "Schema version plus the monotonically advancing generation used to invalidate stale continuations."
        }

        snapshots = datastore "Immutable repository snapshots" {
          #persisted
          description "Complete main-index snapshots reusable as an immutable base with worktree overlays and tombstones."
        }
      }

      projection = service "Typed result projection" {
        #proof
        technology "Rust and Kotlin serializers"
        description "Returns data together with coverage, limitations, typed failures, and next actions."
        metadata {
          formats ["human", "TOON", "JSON compatibility"]
          invariant "data is not completeness"
        }
      }
    }
  }

  developer -[call]-> kast.cli "invokes"
  installer -[call]-> kast.cli "delegates setup"
  codexHooks -[call]-> kast.cli "invokes lifecycle or diagnostics"
  kast.cli -[call]-> kast.control "dispatches local and lifecycle commands"
  kast.cli -[call]-> kast.agent "dispatches agent commands"
  kast.control -[control]-> workspaceState "reads and updates owned state"
  kast.control -[control]-> kast.rpcClient "controls an admitted runtime"
  kast.control -[control]-> kast.backend.headless "admits, starts, or reuses the exact-root runtime"
  kast.agent -[evidence]-> kast.evidence.index "queries persisted evidence locally"
  kast.agent -[transport]-> kast.rpcClient "opens a bounded compiler request"
  kast.rpcClient -[transport]-> kast.server.dispatcher "sends JSON-RPC"
  kast.server.dispatcher -[call]-> kast.server.router "dispatches a validated envelope"
  kast.server.router -[call]-> kast.server.orchestrator "routes semantic reads"
  kast.server.router -[call]-> kast.server.mutation "routes semantic writes"
  kast.server.mutation -[call]-> kast.server.orchestrator "reuses typed semantic operations"
  kast.server.orchestrator -[call]-> kast.backend.api "calls the shared backend contract"
  kast.backend.api -[implement]-> kast.backend.idea "is implemented by"
  kast.backend.headless -[control]-> ideaPlatform "owns the isolated host"
  kast.backend.headless -[control]-> kast.backend.idea "boots the private compiler implementation"
  kast.backend.idea -[call]-> ideaPlatform "runs only inside the headless host"
  kast.backend.idea -[call]-> kotlinCompiler "resolves PSI and compiler semantics"
  kast.backend.idea -[call]-> kast.backend.ideaAdmission "gates indexing and semantic work"
  kast.backend.idea -[call]-> kast.backend.ideaRefresh "refreshes focused workspace paths"
  kast.backend.idea -[call]-> kast.backend.ideaDiagnostics "collects compiler diagnostics"
  kast.backend.idea -[call]-> kast.indexing "drives headless-bootstrap and explicit indexing"
  kast.backend.idea -[evidence]-> kast.evidence.index "reads and writes indexed facts"
  kast.indexing -[retain]-> kast.evidence.index "retains independently refreshed products"
  kast.server.orchestrator -[evidence]-> kast.evidence.index "combines persisted evidence"
  kast.server.orchestrator -[evidence]-> kast.evidence.projection "returns typed reads"
  kast.server.mutation -[evidence]-> kast.evidence.projection "returns apply and validation evidence"
  kast.evidence.projection -[evidence]-> kast.cli "projects the result"

  ideaPlatform.gradleModel -[control]-> ideaPlatform.smartMode "settles imported project state"
  ideaPlatform.vfs -[call]-> ideaPlatform.kotlinIndex "discovers admitted Kotlin files"
  ideaPlatform.kotlinIndex -[call]-> kotlinCompiler.psi "opens KtFile syntax trees"
  kotlinCompiler.psi -[call]-> kotlinCompiler.analysisApi "supplies the analysis context"
  kotlinCompiler.analysisApi -[implement]-> kotlinCompiler.k2Frontend "queries K2 semantics"
  kotlinCompiler.k2Frontend -[implement]-> kotlinCompiler.fir "builds and resolves FIR internally"

  kast.backend.ideaAdmission -[call]-> ideaPlatform.smartMode "awaits smart mode"
  kast.backend.ideaAdmission -[call]-> kotlinCompiler.psi "proves Kotlin PSI"
  kast.backend.ideaAdmission -[call]-> kotlinCompiler.analysisApi "proves compiler diagnostics"
  kast.backend.ideaRefresh -[refresh]-> ideaPlatform.vfs "refreshes selected paths"
  kast.backend.ideaRefresh -[call]-> ideaPlatform.kotlinIndex "checks Kotlin admission"
  kast.backend.ideaRefresh -[call]-> kotlinCompiler.psi "checks KtFile availability"
  kast.backend.ideaRefresh -[call]-> kotlinCompiler.analysisApi "checks semantic admission"
  kast.backend.ideaDiagnostics -[call]-> kotlinCompiler.psi "captures PSI generation and content"
  kast.backend.ideaDiagnostics -[call]-> kotlinCompiler.analysisApi "collects diagnostics"
  kast.backend.ideaRefresh -[evidence]-> kast.indexing.refreshStatus "returns per-path admission"
  kast.backend.ideaDiagnostics -[evidence]-> kast.indexing.refreshStatus "returns diagnostics proof"

  kast.indexing.projectOpen -[control]-> ideaPlatform.gradleModel "waits for Gradle import"
  kast.indexing.projectOpen -[call]-> kast.indexing.projectIndexer "starts the full reference index"
  kast.indexing.projectIndexer -[call]-> kast.backend.ideaAdmission "gates on compiler readiness"
  kast.indexing.projectIndexer -[call]-> kast.indexing.sourceScanner "builds identifier inventory"
  kast.indexing.projectIndexer -[call]-> kast.indexing.referenceIndexer "indexes dependency-prioritized modules"
  kast.indexing.sourceScanner -[call]-> ideaPlatform.vfs "discovers eligible Kotlin paths"
  kast.indexing.sourceScanner -[call]-> kotlinCompiler.psi "reads text and package evidence"
  kast.indexing.sourceScanner -[retain]-> kast.evidence.index.writer "replaces the full inventory"
  kast.indexing.referenceIndexer -[call]-> kast.indexing.referenceScanner "scans reference batches"
  kast.indexing.referenceIndexer -[call]-> kast.indexing.declarationScanner "scans declaration batches"
  kast.indexing.referenceScanner -[call]-> kotlinCompiler.psi "resolves KtNamedDeclaration targets"
  kast.indexing.declarationScanner -[call]-> kotlinCompiler.psi "extracts declarations and supertypes"
  kast.indexing.referenceIndexer -[retain]-> kast.evidence.index.writer "serializes successful batches"
  kast.indexing.graphExtractor -[call]-> kotlinCompiler.analysisApi "extracts selected compiler facts"
  kast.indexing.graphExtractor -[call]-> kast.indexing.graphWriter "passes provider-neutral facts"
  kast.indexing.graphWriter -[retain]-> kast.evidence.index.writer "atomically replaces semantic files"
  kast.indexing.referenceLookup -[evidence]-> kast.evidence.index.relationships "queries exact generation-bound rows"
  kast.indexing.referenceLookup -[call]-> kotlinCompiler.psi "rehydrates rows or falls back to live search"
  kast.indexing.referenceLookup -[evidence]-> kast.evidence.projection "returns rows with coverage"
  kast.indexing.snapshotCoordinator -[retain]-> kast.evidence.index.snapshots "hydrates or publishes compatible state"

  kast.evidence.index.writer -[call]-> kast.evidence.index.interning "encodes path prefixes and FQNs"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.inventory "stores inventory and ownership"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.relationships "stores declarations and references"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.moduleProgress "updates module completion"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.semanticGraph "stores selected graph facts"
  kast.evidence.index.writer -[retain]-> kast.evidence.index.generation "advances generation"
  kast.evidence.index.interning -[evidence]-> kast.evidence.index.generation "checks data_version before cache reuse"
  kast.evidence.index.snapshots -[evidence]-> kast.evidence.index.writer "hydrates a compatible immutable base"
}
