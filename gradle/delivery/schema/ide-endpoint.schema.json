{"$id":"https://kast.michne.com/schema/ide-endpoint-v2.json", "$schema":"https://json-schema.org/draft/2020-12/schema", "additionalProperties":false, "properties":{"canonicalRoot":{"maxLength":4096, "minLength":1, "pattern":"^(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))/(?:[^/\\u0000]+(?:/[^/\\u0000]+)*)?$", "type":"string"}, "capabilities":{"const":["workspace.inspect", "symbol.discover", "symbol.resolve", "symbol.describe"], "type":"array"}, "framing":{"const":"length-prefixed-json-v1", "type":"string"}, "hostKind":{"const":"IDE_PROJECT", "type":"string"}, "ideBuild":{"pattern":"^[0-9]{3}\\.[0-9]+\\.[0-9]+$", "type":"string"}, "kastPluginVersion":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9]+-g[0-9a-f]{7,40})?$", "type":"string"}, "kotlinPluginBuild":{"pattern":"^[0-9]{3}\\.[0-9]+\\.[0-9]+-IJ$", "type":"string"}, "operationRegistryDigest":{"pattern":"^sha256:[0-9a-f]{64}$", "type":"string"}, "processId":{"minimum":1, "type":"integer"}, "runtimeEpoch":{"minimum":0, "type":"integer"}, "runtimeProtocolIdentity":{"pattern":"^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.v[1-9][0-9]*$", "type":"string"}, "schema":{"const":"kast.ide.endpoint.v2", "type":"string"}, "socketPath":{"maxLength":103, "minLength":1, "pattern":"^(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))/(?:[^/\\u0000]+(?:/[^/\\u0000]+)*)?$", "type":"string"}, "wireSchemaDigest":{"pattern":"^sha256:[0-9a-f]{64}$", "type":"string"}}, "required":["schema", "canonicalRoot", "hostKind", "processId", "ideBuild", "kotlinPluginBuild", "kastPluginVersion", "runtimeProtocolIdentity", "operationRegistryDigest", "wireSchemaDigest", "socketPath", "framing", "runtimeEpoch", "capabilities"], "title":"Kast IDE project endpoint v2", "type":"object"}
