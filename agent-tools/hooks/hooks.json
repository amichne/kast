{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"${HOME}/.local/bin:${PATH}\" kast hook session-start",
            "timeout": 3780,
            "statusMessage": "Prepare the Kast workspace"
          }
        ]
      }
    ]
  }
}
