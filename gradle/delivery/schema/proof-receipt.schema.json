{"$id":"https://kast.michne.com/schema/proof-receipt-v2.json", "$schema":"https://json-schema.org/draft/2020-12/schema", "additionalProperties":false, "properties":{"commandDigest":{"pattern":"^[0-9a-f]{64}$", "type":"string"}, "completeObservations":{"additionalProperties":{"type":"string"}, "minProperties":1, "type":"object"}, "dependencyReceiptDigests":{"additionalProperties":{"pattern":"^[0-9a-f]{64}$", "type":"string"}, "type":"object"}, "headPolicy":{"pattern":"^(CONTENT_SCOPED|EXACT_HEAD)$", "type":"string"}, "observedRepositoryHead":{"pattern":"^[0-9a-f]{40}$", "type":"string"}, "outputDigests":{"additionalProperties":{"pattern":"^[0-9a-f]{64}$", "type":"string"}, "type":"object"}, "programVersion":{"pattern":"^[a-z0-9][a-z0-9.-]+$", "type":"string"}, "receiptDigest":{"pattern":"^[0-9a-f]{64}$", "type":"string"}, "receiptId":{"pattern":"^KVP-[0-9]{3}-COMPLETE$", "type":"string"}, "recordedAtUtc":{"format":"date-time", "type":"string"}, "relevantInputDigest":{"pattern":"^[0-9a-f]{64}$", "type":"string"}, "schemaVersion":{"const":2}, "taskDefinitionDigest":{"pattern":"^[0-9a-f]{64}$", "type":"string"}, "taskId":{"pattern":"^KVP-[0-9]{3}$", "type":"string"}, "toolchainDigest":{"pattern":"^[0-9a-f]{64}$", "type":"string"}}, "required":["schemaVersion", "programVersion", "receiptId", "taskId", "taskDefinitionDigest", "dependencyReceiptDigests", "relevantInputDigest", "commandDigest", "toolchainDigest", "completeObservations", "outputDigests", "headPolicy", "observedRepositoryHead", "recordedAtUtc", "receiptDigest"], "title":"Kast proof receipt", "type":"object"}
