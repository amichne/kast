{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kast",
  "description": "Compiler-grounded evidence for exact Kotlin repositories.",
  "colors": {
    "primary": "#B45309",
    "light": "#92400E",
    "dark": "#F59E0B"
  },
  "logo": "/images/kast-mark.svg",
  "favicon": "/images/kast-mark.svg",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FAF7F2",
      "dark": "#11100E"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "index",
          "start"
        ]
      },
      {
        "group": "Guides",
        "icon": "compass",
        "pages": [
          "questions/workspace-readiness",
          "questions/declaration-identity",
          "questions/code-connections",
          "questions/semantic-validity",
          "questions/safe-change"
        ]
      },
      {
        "group": "Concepts",
        "icon": "shield-check",
        "pages": [
          "concepts/evidence-boundaries",
          "explanation/how-kast-works"
        ]
      },
      {
        "group": "Technical specification",
        "icon": "network",
        "pages": [
          "technical-specification/index",
          "technical-specification/runtime-boundary",
          "technical-specification/protocol-and-dispatch",
          "technical-specification/semantic-services",
          "technical-specification/change-and-evidence",
          "technical-specification/module-architecture",
          "technical-specification/verification-and-contribution"
        ]
      },
      {
        "group": "Reference",
        "icon": "terminal",
        "pages": [
          "reference/cli"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/amichne/kast"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/start"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amichne/kast"
    },
    "links": [
      {
        "header": "Use Kast",
        "items": [
          {
            "label": "Quickstart",
            "href": "/start"
          },
          {
            "label": "CLI reference",
            "href": "/reference/cli"
          }
        ]
      },
      {
        "header": "Understand Kast",
        "items": [
          {
            "label": "Trust the evidence",
            "href": "/concepts/evidence-boundaries"
          },
          {
            "label": "Technical specification",
            "href": "/technical-specification"
          }
        ]
      },
      {
        "header": "Source",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/amichne/kast"
          },
          {
            "label": "MIT license",
            "href": "https://github.com/amichne/kast/blob/main/LICENSE"
          }
        ]
      }
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ],
    "display": "header"
  },
  "search": {
    "prompt": "Search operations, evidence boundaries, and implementation authorities"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The requested Kast documentation page does not exist. Return to the [documentation home](/)."
    }
  }
}
