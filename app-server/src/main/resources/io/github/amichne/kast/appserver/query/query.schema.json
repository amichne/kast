{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.michne.com/schemas/query.schema.json",
  "type": "object",
  "description": "Agent-facing query syntax. Defaults are fixed by this contract, not by the environment. This schema does not confer compiler authority.",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "QUERY"
      ],
      "description": "Shape discriminator.",
      "examples": [
        "QUERY"
      ]
    },
    "from": {
      "$ref": "#/$defs/Source"
    },
    "steps": {
      "$ref": "#/$defs/Steps"
    },
    "select": {
      "$ref": "#/$defs/Selection"
    }
  },
  "required": [
    "type",
    "from"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "type": "QUERY",
      "from": {
        "type": "SEARCH",
        "query": "OrderService"
      }
    }
  ],
  "$defs": {
    "QueryText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "[\\s\\S]*\\S[\\s\\S]*",
      "description": "Declaration name to match. Blank text is rejected; use ALL for enumeration. At most 256 UTF-16 code units at canonical admission.",
      "examples": [
        "OrderService"
      ]
    },
    "ExactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^exact:v2:[\\s\\S]+$",
      "description": "Copy items[].ref.token from an exact-symbol result verbatim. This prefix check is syntax only; Kast still validates workspace, generation and compiler identity.",
      "examples": [
        "exact:v2:EXAMPLE_NOT_ISSUED"
      ]
    },
    "DirectoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*(?:^|/)\\s*(?:/|$))[^\\x00-\\x1F\\x7F]+$",
      "description": "Workspace-relative directory without empty, dot or parent segments. Use null scope for the workspace root. Do not trim or rewrite paths.",
      "examples": [
        "services/orders"
      ]
    },
    "PackageName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
      "description": "Semantic Kotlin package name; not a path. Uses the currently supported ASCII package-name grammar.",
      "examples": [
        "com.example.orders"
      ]
    },
    "Match": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "exact",
        "fuzzy",
        null
      ],
      "description": "Omitted or null means exact declaration-name matching. Exact does not select one overload. Fuzzy matching requires explicit opt-in.",
      "examples": [
        "exact"
      ],
      "default": "exact"
    },
    "DeclarationKind": {
      "type": "string",
      "enum": [
        "class",
        "function",
        "property",
        "type-alias"
      ],
      "description": "Supported discovery family. Class includes the existing class-like family; constructors are not discoverable through this source.",
      "examples": [
        "function"
      ]
    },
    "SourceSet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "[\\s\\S]*\\S[\\s\\S]*",
      "description": "Exact Gradle source-set name from the imported model, including custom and multiplatform names. Not a production/test category or filesystem glob.",
      "examples": [
        "main",
        "integrationTest",
        "commonMain"
      ]
    },
    "Containment": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "direct",
        "recursive",
        null
      ],
      "description": "Omitted or null searches recursively, including this directory or package and all nested directories or subpackages. Direct selects only this directory or package.",
      "examples": [
        "recursive"
      ],
      "default": "recursive"
    },
    "Visibility": {
      "type": "string",
      "enum": [
        "public",
        "protected",
        "internal",
        "private",
        "local"
      ],
      "description": "Compiler-established declaration visibility.",
      "examples": [
        "public"
      ]
    },
    "Relation": {
      "type": "string",
      "enum": [
        "references",
        "callers",
        "callees",
        "implementations",
        "inheritors",
        "overrides",
        "type-uses"
      ],
      "description": "One compiler-confirmed semantic hop. Callers returns calling declarations; callees returns called declarations.",
      "examples": [
        "callers"
      ]
    },
    "Field": {
      "type": "string",
      "enum": [
        "name",
        "location",
        "signature"
      ],
      "description": "Optional result projection. Existing ref and kind fields are always retained.",
      "examples": [
        "name"
      ]
    },
    "Kinds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DeclarationKind"
      },
      "minItems": 1,
      "maxItems": 4,
      "description": "Omitted or null includes every supported discovery family. Empty and duplicate lists are rejected.",
      "examples": [
        [
          "function"
        ]
      ],
      "uniqueItems": true,
      "default": [
        "class",
        "function",
        "property",
        "type-alias"
      ]
    },
    "SourceSets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/SourceSet"
      },
      "minItems": 1,
      "maxItems": 1000,
      "description": "Omitted or null selects names main and test. Explicit names intersect with directory and package restrictions; names with no matching roots contribute no declarations.",
      "examples": [
        [
          "main"
        ],
        [
          "integrationTest",
          "commonMain",
          "jvmTest"
        ]
      ],
      "uniqueItems": true,
      "default": [
        "main",
        "test"
      ]
    },
    "Selection": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Field"
      },
      "minItems": 0,
      "maxItems": 3,
      "description": "Omitted or null returns name and location. Empty requests ref and kind only; it does not restore defaults.",
      "examples": [
        [
          "name",
          "location"
        ]
      ],
      "uniqueItems": true,
      "default": [
        "name",
        "location"
      ]
    },
    "Steps": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 0,
      "maxItems": 1000,
      "description": "Ordered left-to-right transformations. Omitted or null means no steps. Never reorder filters around expansion.",
      "examples": [
        []
      ],
      "default": []
    },
    "RefsList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExactRef"
      },
      "minItems": 1,
      "maxItems": 1000,
      "description": "Non-empty returned exact-symbol tokens. No candidate promotion, guessing or alias lookup.",
      "examples": [
        [
          "exact:v2:EXAMPLE_NOT_ISSUED"
        ]
      ]
    },
    "VisibilityList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Visibility"
      },
      "minItems": 1,
      "maxItems": 5,
      "description": "Non-empty set of accepted visibilities; unproved predicates remain incomplete evidence, never a negative match.",
      "examples": [
        [
          "public"
        ]
      ],
      "uniqueItems": true
    },
    "Directory": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional discovery directory restriction. Null means no directory restriction.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DIRECTORY"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "DIRECTORY"
          ]
        },
        "path": {
          "$ref": "#/$defs/DirectoryPath"
        },
        "containment": {
          "$ref": "#/$defs/Containment"
        }
      },
      "required": [
        "type",
        "path"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "DIRECTORY",
          "path": "services/orders"
        }
      ]
    },
    "Package": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional semantic package restriction. Null means no package restriction.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PACKAGE"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "PACKAGE"
          ]
        },
        "name": {
          "$ref": "#/$defs/PackageName"
        },
        "containment": {
          "$ref": "#/$defs/Containment"
        }
      },
      "required": [
        "type",
        "name"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "PACKAGE",
          "name": "com.example.orders"
        }
      ]
    },
    "Scope": {
      "type": [
        "object",
        "null"
      ],
      "description": "Discovery restrictions intersect. Null means the supported main and test workspace domain. Scope does not silently restrict later expansion destinations.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SCOPE"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "SCOPE"
          ]
        },
        "sourceSets": {
          "$ref": "#/$defs/SourceSets"
        },
        "directory": {
          "$ref": "#/$defs/Directory"
        },
        "package": {
          "$ref": "#/$defs/Package"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "SCOPE",
          "sourceSets": [
            "main"
          ]
        }
      ]
    },
    "Search": {
      "type": "object",
      "description": "Find matching declarations and establish exact compiler identities. Multiple overloads remain separate symbols.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SEARCH"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "SEARCH"
          ]
        },
        "query": {
          "$ref": "#/$defs/QueryText"
        },
        "match": {
          "$ref": "#/$defs/Match"
        },
        "kinds": {
          "$ref": "#/$defs/Kinds"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "type",
        "query"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "SEARCH",
          "query": "OrderService"
        }
      ]
    },
    "All": {
      "type": "object",
      "description": "Explicit bounded enumeration. Budget exhaustion remains partial coverage; ALL never implies unbounded work.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ALL"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "ALL"
          ]
        },
        "kinds": {
          "$ref": "#/$defs/Kinds"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "ALL",
          "kinds": [
            "class"
          ]
        }
      ]
    },
    "Refs": {
      "type": "object",
      "description": "Start from exact-symbol references previously returned by Kast.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "REFS"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "REFS"
          ]
        },
        "refs": {
          "$ref": "#/$defs/RefsList"
        }
      },
      "required": [
        "type",
        "refs"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "REFS",
          "refs": [
            "exact:v2:EXAMPLE_NOT_ISSUED"
          ]
        }
      ]
    },
    "Source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Search"
        },
        {
          "$ref": "#/$defs/All"
        },
        {
          "$ref": "#/$defs/Refs"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Every source yields exact symbols or explicit incomplete/rejected evidence. Candidates are internal to Kast.",
      "examples": [
        {
          "type": "SEARCH",
          "query": "OrderService"
        },
        {
          "type": "ALL",
          "kinds": [
            "class"
          ]
        },
        {
          "type": "REFS",
          "refs": [
            "exact:v2:EXAMPLE_NOT_ISSUED"
          ]
        }
      ]
    },
    "Filter": {
      "type": "object",
      "description": "Filter the current symbol stream by compiler-established visibility.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FILTER"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "FILTER"
          ]
        },
        "visibility": {
          "$ref": "#/$defs/VisibilityList"
        }
      },
      "required": [
        "type",
        "visibility"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "FILTER",
          "visibility": [
            "public"
          ]
        }
      ]
    },
    "Expand": {
      "type": "object",
      "description": "Expand the current symbols by exactly one semantic hop, retaining relation evidence.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EXPAND"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "EXPAND"
          ]
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        }
      },
      "required": [
        "type",
        "relation"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "EXPAND",
          "relation": "callers"
        }
      ]
    },
    "Distinct": {
      "type": "object",
      "description": "Deduplicate exact symbols using the existing engine operation, preserving contributing relation evidence.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DISTINCT"
          ],
          "description": "Shape discriminator.",
          "examples": [
            "DISTINCT"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "examples": [
        {
          "type": "DISTINCT"
        }
      ]
    },
    "Step": {
      "anyOf": [
        {
          "$ref": "#/$defs/Filter"
        },
        {
          "$ref": "#/$defs/Expand"
        },
        {
          "$ref": "#/$defs/Distinct"
        }
      ],
      "discriminator": {
        "propertyName": "type"
      },
      "description": "Closed symbol-to-symbol transformations. INSPECT is intentionally not public.",
      "examples": [
        {
          "type": "FILTER",
          "visibility": [
            "public"
          ]
        },
        {
          "type": "EXPAND",
          "relation": "callers"
        },
        {
          "type": "DISTINCT"
        }
      ]
    }
  }
}
