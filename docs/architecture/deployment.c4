deployment {
  environment exactRoot {
    title "Exact-root Kast indexer"
    metadata {
      processKind "indexer"
      readiness "INDEXING then READY"
      foregroundEditor "not an authority"
    }

    process cliProcess {
      cli = instanceOf kast.cli
      control = instanceOf kast.control
      agent = instanceOf kast.agent
      rpcClient = instanceOf kast.rpcClient
    }

    process indexerProcess {
      runtime = instanceOf kast.indexer.runtime
      serverRuntime = instanceOf kast.indexer.serverRuntime
      compiler = instanceOf kast.indexer.compiler
      dispatcher = instanceOf kast.server.dispatcher
      router = instanceOf kast.server.router
      orchestrator = instanceOf kast.server.orchestrator
      mutation = instanceOf kast.server.mutation
    }

    dataVolume localState {
      sourceIndex = instanceOf kast.evidence.index
      workspace = instanceOf workspaceState
    }
  }
}

views {
  deployment view indexer-runtime {
    title "Exact-root Kast indexer"
    description "Kast reuses an eligible exact-root process or creates one isolated indexer."
    include exactRoot.**
    style exactRoot.indexerProcess {
      color secondary
    }
    style exactRoot.localState {
      color green
    }
    autoLayout LeftRight 120 80
  }
}
