#!/usr/bin/env bash
set -euo pipefail
unset JAVA_OPTS _JAVA_OPTIONS JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
main_class="io.github.amichne.kast.indexer.KastIndexerMainKt"
runtime_libs_dir="${script_dir}/runtime-libs"

if [[ ! -d "${runtime_libs_dir}" ]]; then
  echo "kast-indexer: runtime-libs directory not found: ${runtime_libs_dir}" >&2
  exit 70
fi
classpath_file="${runtime_libs_dir}/classpath.txt"
if [[ ! -f "${classpath_file}" ]]; then
  echo "kast-indexer: classpath.txt not found in ${runtime_libs_dir}" >&2
  exit 70
fi

classpath=""
while IFS= read -r jar; do
  [[ -z "${jar}" ]] && continue
  if [[ "${jar}" == */* || ! -f "${runtime_libs_dir}/${jar}" ]]; then
    echo "kast-indexer: invalid runtime classpath entry: ${jar}" >&2
    exit 70
  fi
  if [[ -z "${classpath}" ]]; then
    classpath="${runtime_libs_dir}/${jar}"
  else
    classpath="${classpath}:${runtime_libs_dir}/${jar}"
  fi
done < "${classpath_file}"
if [[ -z "${classpath}" ]]; then
  echo "kast-indexer: classpath.txt is empty in ${runtime_libs_dir}" >&2
  exit 70
fi

idea_home=""
java_executable=""
idea_system_path=""
idea_config_path=""
idea_log_path=""
private_plugins_path=""
cache_state_path=""
bootstrap_state_path=""
bootstrap_attempt_id=""
for argument in "$@"; do
  case "${argument}" in
    --idea-home=*)
      [[ -z "${idea_home}" ]] || {
        echo "kast-indexer: idea-home argument must occur exactly once" >&2
        exit 70
      }
      idea_home="${argument#--idea-home=}"
      ;;
    --java-executable=*)
      [[ -z "${java_executable}" ]] || {
        echo "kast-indexer: java-executable argument must occur exactly once" >&2
        exit 70
      }
      java_executable="${argument#--java-executable=}"
      ;;
    --idea-system-path=*)
      [[ -z "${idea_system_path}" ]] || {
        echo "kast-indexer: idea-system-path argument must occur exactly once" >&2
        exit 70
      }
      idea_system_path="${argument#--idea-system-path=}"
      ;;
    --idea-config-path=*)
      [[ -z "${idea_config_path}" ]] || {
        echo "kast-indexer: idea-config-path argument must occur exactly once" >&2
        exit 70
      }
      idea_config_path="${argument#--idea-config-path=}"
      ;;
    --idea-log-path=*)
      [[ -z "${idea_log_path}" ]] || {
        echo "kast-indexer: idea-log-path argument must occur exactly once" >&2
        exit 70
      }
      idea_log_path="${argument#--idea-log-path=}"
      ;;
    --private-plugins-path=*)
      [[ -z "${private_plugins_path}" ]] || {
        echo "kast-indexer: private-plugins-path argument must occur exactly once" >&2
        exit 70
      }
      private_plugins_path="${argument#--private-plugins-path=}"
      ;;
    --cache-state-path=*)
      [[ -z "${cache_state_path}" ]] || {
        echo "kast-indexer: cache-state-path argument must occur exactly once" >&2
        exit 70
      }
      cache_state_path="${argument#--cache-state-path=}"
      ;;
    --bootstrap-state-path=*)
      [[ -z "${bootstrap_state_path}" ]] || {
        echo "kast-indexer: bootstrap-state-path argument must occur exactly once" >&2
        exit 70
      }
      bootstrap_state_path="${argument#--bootstrap-state-path=}"
      ;;
    --bootstrap-attempt-id=*)
      [[ -z "${bootstrap_attempt_id}" ]] || {
        echo "kast-indexer: bootstrap-attempt-id argument must occur exactly once" >&2
        exit 70
      }
      bootstrap_attempt_id="${argument#--bootstrap-attempt-id=}"
      ;;
  esac
done

require_argument() {
  local name="$1"
  local value="$2"
  if [[ -z "${value}" ]]; then
    echo "kast-indexer: ${name} argument is required" >&2
    exit 70
  fi
}

require_canonical_directory() {
  local name="$1"
  local path="$2"
  if [[ "${path}" != /* || -L "${path}" || ! -d "${path}" ]]; then
    echo "kast-indexer: ${name} is not a canonical directory: ${path}" >&2
    exit 70
  fi
  local physical
  physical="$(cd -P -- "${path}" >/dev/null 2>&1 && pwd -P)" || {
    echo "kast-indexer: ${name} is unavailable: ${path}" >&2
    exit 70
  }
  if [[ "${physical}" != "${path}" ]]; then
    echo "kast-indexer: ${name} is not physical: ${path}" >&2
    exit 70
  fi
}

require_argument "idea-home" "${idea_home}"
require_argument "java-executable" "${java_executable}"
require_argument "idea-system-path" "${idea_system_path}"
require_argument "idea-config-path" "${idea_config_path}"
require_argument "idea-log-path" "${idea_log_path}"
require_argument "private-plugins-path" "${private_plugins_path}"
require_argument "cache-state-path" "${cache_state_path}"
require_argument "bootstrap-state-path" "${bootstrap_state_path}"
require_argument "bootstrap-attempt-id" "${bootstrap_attempt_id}"

# HOME is the admitted launch authority. Java otherwise obtains user.home from
# the account database, escaping an isolated caller's Gradle and credential home.
kast_user_home="${HOME:-}"
if [[ "${kast_user_home}" != /* || ! -d "${kast_user_home}" || -L "${kast_user_home}" ]]; then
  echo "kast-indexer: admitted HOME is not a physical absolute directory" >&2
  exit 70
fi
kast_physical_user_home="$(cd -P -- "${kast_user_home}" >/dev/null 2>&1 && pwd -P)" || {
  echo "kast-indexer: admitted HOME is unavailable" >&2
  exit 70
}
if [[ "${kast_physical_user_home}" != "${kast_user_home}" ]]; then
  echo "kast-indexer: admitted HOME is not canonical" >&2
  exit 70
fi

require_canonical_directory "idea-home" "${idea_home}"
require_canonical_directory "idea-system-path" "${idea_system_path}"
require_canonical_directory "idea-config-path" "${idea_config_path}"
require_canonical_directory "idea-log-path" "${idea_log_path}"
require_canonical_directory "private-plugins-path" "${private_plugins_path}"
if [[ "${cache_state_path}" != /* || "$(dirname -- "${cache_state_path}")" != \
  "$(dirname -- "${idea_system_path}")" || -L "${cache_state_path}" ]]; then
  echo "kast-indexer: cache-state-path is not owned by the cache: ${cache_state_path}" >&2
  exit 70
fi
if [[ "${bootstrap_state_path}" != /* || "$(dirname -- "${bootstrap_state_path}")" != \
  "$(dirname -- "${idea_system_path}")" || -L "${bootstrap_state_path}" ]]; then
  echo "kast-indexer: bootstrap-state-path is not owned by the cache: ${bootstrap_state_path}" >&2
  exit 70
fi
if [[ ! "${bootstrap_attempt_id}" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]]; then
  echo "kast-indexer: bootstrap-attempt-id is invalid" >&2
  exit 70
fi

if [[ ! -f "${idea_home}/Resources/product-info.json" || \
  ! -f "${idea_home}/lib/nio-fs.jar" || \
  ! -f "${idea_home}/modules/module-descriptors.dat" ]]; then
  echo "kast-indexer: installed IDEA layout is incomplete: ${idea_home}" >&2
  exit 70
fi
if [[ "${java_executable}" != /* || -L "${java_executable}" || \
  ! -f "${java_executable}" || ! -x "${java_executable}" ]]; then
  echo "kast-indexer: java-executable is not a physical executable: ${java_executable}" >&2
  exit 70
fi
java_directory="$(cd -P -- "$(dirname -- "${java_executable}")" >/dev/null 2>&1 && pwd -P)" || {
  echo "kast-indexer: java-executable directory is unavailable" >&2
  exit 70
}
if [[ "${java_directory}/$(basename -- "${java_executable}")" != "${java_executable}" || \
  "${java_executable}" != */bin/java ]]; then
  echo "kast-indexer: java-executable is not canonical: ${java_executable}" >&2
  exit 70
fi
expected_java_directory="$(
  cd -P -- "${idea_home}/jbr/Contents/Home/bin" >/dev/null 2>&1 && pwd -P
)" || {
  echo "kast-indexer: IDEA JBR directory is unavailable" >&2
  exit 70
}
if [[ "${java_executable}" != "${expected_java_directory}/java" ]]; then
  echo "kast-indexer: java-executable does not belong to idea-home: ${java_executable}" >&2
  exit 70
fi
if [[ ! -d "${private_plugins_path}/kast-indexer/lib" ]]; then
  echo "kast-indexer: private Kast plugin is unavailable: ${private_plugins_path}" >&2
  exit 70
fi

export JAVA_HOME="${java_executable%/bin/java}"
jna_arch="amd64"
case "$(uname -m)" in
  arm64|aarch64) jna_arch="aarch64" ;;
esac

idea_jvm_args=(
  "-Xms256m"
  "-Xmx1536m"
  "-Duser.home=${kast_user_home}"
  "-Xbootclasspath/a:${idea_home}/lib/nio-fs.jar"
  "-Djava.system.class.loader=com.intellij.util.lang.PathClassLoader"
  "-Didea.vendor.name=JetBrains"
  "-Didea.home.path=${idea_home}"
  "-Didea.config.path=${idea_config_path}"
  "-Didea.system.path=${idea_system_path}"
  "-Didea.plugins.path=${private_plugins_path}"
  "-Didea.load.plugins.id=io.github.amichne.kast.indexer"
  "-Didea.log.path=${idea_log_path}"
  "-Dkast.cache.state.path=${cache_state_path}"
  "-Dkast.bootstrap.state.path=${bootstrap_state_path}"
  "-Dkast.bootstrap.attempt.id=${bootstrap_attempt_id}"
  "-Djna.boot.library.path=${idea_home}/lib/jna/${jna_arch}"
  "-Djna.nosys=true"
  "-Djna.noclasspath=true"
  "-Dpty4j.preferred.native.folder=${idea_home}/lib/pty4j"
  "-Dio.netty.allocator.type=pooled"
  "-Dintellij.platform.runtime.repository.path=${idea_home}/modules/module-descriptors.dat"
  "-Didea.force.use.core.classloader=true"
  "-Didea.platform.prefix=Idea"
  "-Dsplash=false"
  "-Daether.connector.resumeDownloads=false"
  "-Dcompose.swing.render.on.graphics=true"
  "--add-opens=java.base/java.io=ALL-UNNAMED"
  "--add-opens=java.base/java.lang=ALL-UNNAMED"
  "--add-opens=java.base/java.lang.ref=ALL-UNNAMED"
  "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED"
  "--add-opens=java.base/java.net=ALL-UNNAMED"
  "--add-opens=java.base/java.nio=ALL-UNNAMED"
  "--add-opens=java.base/java.nio.charset=ALL-UNNAMED"
  "--add-opens=java.base/java.text=ALL-UNNAMED"
  "--add-opens=java.base/java.time=ALL-UNNAMED"
  "--add-opens=java.base/java.util=ALL-UNNAMED"
  "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED"
  "--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED"
  "--add-opens=java.base/java.util.concurrent.locks=ALL-UNNAMED"
  "--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED"
  "--add-opens=java.base/jdk.internal.vm=ALL-UNNAMED"
  "--add-opens=java.base/sun.net.dns=ALL-UNNAMED"
  "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
  "--add-opens=java.base/sun.nio.fs=ALL-UNNAMED"
  "--add-opens=java.base/sun.security.ssl=ALL-UNNAMED"
  "--add-opens=java.base/sun.security.util=ALL-UNNAMED"
  "--add-opens=java.desktop/com.sun.java.swing=ALL-UNNAMED"
  "--add-exports=java.desktop/com.apple.laf=ALL-UNNAMED"
  "--add-opens=java.desktop/java.awt=ALL-UNNAMED"
  "--add-opens=java.desktop/java.awt.dnd.peer=ALL-UNNAMED"
  "--add-opens=java.desktop/java.awt.event=ALL-UNNAMED"
  "--add-opens=java.desktop/java.awt.font=ALL-UNNAMED"
  "--add-opens=java.desktop/java.awt.image=ALL-UNNAMED"
  "--add-opens=java.desktop/java.awt.peer=ALL-UNNAMED"
  "--add-opens=java.desktop/javax.swing=ALL-UNNAMED"
  "--add-opens=java.desktop/javax.swing.plaf.basic=ALL-UNNAMED"
  "--add-opens=java.desktop/javax.swing.text=ALL-UNNAMED"
  "--add-opens=java.desktop/javax.swing.text.html=ALL-UNNAMED"
  "--add-opens=java.desktop/javax.swing.text.html.parser=ALL-UNNAMED"
  "--add-opens=java.desktop/sun.awt=ALL-UNNAMED"
  "--add-opens=java.desktop/sun.awt.datatransfer=ALL-UNNAMED"
  "--add-opens=java.desktop/sun.awt.image=ALL-UNNAMED"
  "--add-opens=java.desktop/sun.font=ALL-UNNAMED"
  "--add-opens=java.desktop/sun.java2d=ALL-UNNAMED"
  "--add-opens=java.desktop/sun.swing=ALL-UNNAMED"
  "--add-opens=java.management/sun.management=ALL-UNNAMED"
  "--add-opens=jdk.attach/sun.tools.attach=ALL-UNNAMED"
  "--add-opens=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED"
  "--add-opens=jdk.internal.jvmstat/sun.jvmstat.monitor=ALL-UNNAMED"
  "--add-opens=jdk.jdi/com.sun.tools.jdi=ALL-UNNAMED"
)

exec "${java_executable}" "${idea_jvm_args[@]}" \
  -cp "${classpath}:${idea_home}/lib/*" "${main_class}" "$@"
