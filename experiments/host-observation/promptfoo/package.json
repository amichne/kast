{
  "name": "kast-agent-evaluations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "eval": "promptfoo eval --no-cache --no-share",
    "separation:prepare": "node separation-cases.mjs --prepare",
    "separation:qualify": "node separation-cases.mjs --qualify",
    "eval:separation": "promptfoo eval --no-cache --no-share -c separation.config.mjs --repeat 3",
    "report:separation": "node separation-report.mjs",
    "compare": "node compare.mjs",
    "review": "node review-packet.mjs",
    "test": "node --test *.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "promptfoo": "0.126.0"
  }
}
