#!/usr/bin/env -S uv run --locked --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Stage a coordinator root: the Go frontend, the JVM coordinator bytecode, its metadata, and an explicit launcher.

The root is bound to one existing product installation, whose Hosts the coordinator manages. The coordinator keeps its
own state and publication under the root, so a staged root never competes with the product's native coordinator.
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

LAUNCHER = """#!/bin/sh
# Explicit JVM entry for the persistent Kast coordinator. Generated by frontend/stage.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
exec {java} -XX:TieredStopAtLevel=1 -Xshare:auto -cp "$root/lib/*" \\
  io.github.amichne.kast.cli.KastCoordinatorMain --product {product} "$@"
"""


def admitted_directory(raw: str, name: str) -> Path:
    path = Path(raw)
    if not path.is_absolute() or path.resolve() != path or not path.is_dir():
        raise SystemExit(f"stage: {name} must be an existing absolute real directory: {raw}")
    return path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, help="coordinator root; its socket path must stay under 104 bytes")
    parser.add_argument("--product", required=True, help="installed product root, such as ~/.local/share/kast/installation")
    parser.add_argument("--java-home", required=True, help="admitted Java runtime home (feature 25 or newer)")
    parser.add_argument("--coordinator", required=True, help="output of :cli:assembleJvmCoordinator")
    parser.add_argument("--frontend", required=True, help="the cgo-free Go frontend binary")
    arguments = parser.parse_args()

    root = Path(arguments.root)
    if not root.is_absolute():
        raise SystemExit("stage: --root must be absolute")
    if len(str(root / "state/run/c.sock").encode()) >= 104:
        raise SystemExit("stage: the coordinator socket path would exceed the Unix socket limit")
    product = admitted_directory(arguments.product, "--product")
    java_home = admitted_directory(arguments.java_home, "--java-home")
    coordinator = admitted_directory(arguments.coordinator, "--coordinator")
    frontend = Path(arguments.frontend)
    java = java_home / "bin" / "java"
    if not os.access(java, os.X_OK) or not os.access(frontend, os.X_OK):
        raise SystemExit("stage: the Java runtime and the frontend must be executable")
    if not (coordinator / "lib").is_dir() or not (coordinator / "share/kast/frontend.json").is_file():
        raise SystemExit("stage: --coordinator is not an assembled coordinator layout")

    launcher = root / "libexec" / "kast-coordinator"
    if launcher.exists():
        # Replacing bytecode under a running coordinator is unsafe; its own entry withdraws the supervised job.
        subprocess.run([str(launcher), "stop"], check=True)

    root.mkdir(parents=True, exist_ok=True)
    os.chmod(root, 0o700)
    if (root / "lib").exists():
        shutil.rmtree(root / "lib")
    shutil.copytree(coordinator / "lib", root / "lib")
    (root / "share/kast").mkdir(parents=True, exist_ok=True)
    shutil.copy2(coordinator / "share/kast/frontend.json", root / "share/kast/frontend.json")
    (root / "bin").mkdir(exist_ok=True)
    shutil.copy2(frontend, root / "bin" / "kast")
    launcher.parent.mkdir(exist_ok=True)
    launcher.write_text(LAUNCHER.format(java=shlex.quote(str(java)), product=shlex.quote(str(product))))
    launcher.chmod(0o755)
    print(root)
    return 0


if __name__ == "__main__":
    sys.exit(main())
