{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kast",
  "description": "Connect your coding agent to IntelliJ IDEA to find Kotlin declarations, trace relationships, and make targeted source changes.",
  "colors": {"primary": "#3154C7", "light": "#8FA7FF", "dark": "#27439F"},
  "fonts": {"family": "SUSE"},
  "logo": "/images/kast-mark.svg",
  "favicon": "/images/kast-mark.svg",
  "icons": {"library": "lucide"},
  "background": {"color": {"light": "#FBFBF9", "dark": "#171816"}},
  "appearance": {"default": "light", "strict": false},
  "navigation": {
    "groups": [
      {
        "group": "Start here",
        "pages": [
          "index",
          "start",
          "agent-harnesses"
        ]
      },
      {
        "group": "Using Kast",
        "pages": [
          "search",
          "concepts/evidence-boundaries",
          "change",
          "query-pipelines",
          "troubleshooting",
          {
            "group": "Setup and maintenance",
            "pages": [
              "concepts/background-startup",
              "workspaces"
            ]
          }
        ]
      },
      {
        "group": "Reference",
        "openapi": "reference/callables.openapi.json",
        "pages": [
          "concepts/architecture",
          {
            "group": "Query reference",
            "pages": [
              "reference/api",
              "reference/responses",
              "reference/symbols",
              "reference/callbacks",
              "reference/walkthrough"
            ]
          },
          "reference/schemas",
          {
            "group": "Integration contracts",
            "expanded": false,
            "pages": [
              "reference/mcp-catalog",
              "reference/rpc-catalog",
              "reference/compatibility"
            ]
          },
          {
            "group": "Detailed schemas",
            "expanded": false,
            "pages": [
              {
                "group": "Callable schemas",
                "expanded": false,
                "pages": ["POST /callables/query_symbols", "POST /callables/check_diagnostics", "POST /callables/add_declaration", "POST /callables/replace_body", "POST /callables/workspace_lifecycle"]
              },
              {
                "group": "Transport results",
                "expanded": false,
                "pages": ["reference/models/mcp-tool-call-result", "reference/models/mcp-read-result", "reference/models/mcp-investigation-result", "reference/models/mcp-change-result", "reference/models/tool-rpc-reply"]
              },
              {
                "group": "Semantic results",
                "expanded": false,
                "pages": ["reference/models/query-item", "reference/models/relation-fact", "reference/models/diagnostic", "reference/models/live-evidence"]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [{"label": "Overview", "href": "/"}, {"label": "GitHub", "href": "https://github.com/amichne/kast"}],
    "primary": {"type": "button", "label": "Install Kast", "href": "/start"}
  },
  "footer": {
    "socials": {"github": "https://github.com/amichne/kast"},
    "links": [
      {"header": "Get started", "items": [{"label": "Install", "href": "/start"}, {"label": "Connect your agent", "href": "/agent-harnesses"}, {"label": "Troubleshooting", "href": "/troubleshooting"}]},
      {"header": "Learn", "items": [{"label": "Query examples", "href": "/search"}, {"label": "Combine results", "href": "/query-pipelines"}, {"label": "Schemas and samples", "href": "/reference/schemas"}]},
      {"header": "Source", "items": [{"label": "GitHub", "href": "https://github.com/amichne/kast"}, {"label": "Security", "href": "https://github.com/amichne/kast/security"}]}
    ]
  },
  "metadata": {"timestamp": true},
  "styling": {"eyebrows": "breadcrumbs"},
  "interaction": {"drilldown": false},
  "contextual": {"options": ["copy", "view"], "display": "header"},
  "api": {"playground": {"display": "none"}, "examples": {"autogenerate": false}},
  "search": {"prompt": "Search docs"},
  "errors": {"404": {"redirect": false, "title": "Page not found", "description": "The requested Kast documentation page does not exist. Return to the [documentation home](/)."}},
  "redirects": [{"source": "/concepts/runtime-integration-validation", "destination": "/concepts/architecture", "permanent": true}]
}
