#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
set -- --internal-entrypoint=rpc "$@"
if [ -n "${HOME-}" ]; then set -- "-Duser.home=$HOME" "$@"; fi
if [ -n "${TMPDIR-}" ]; then set -- "-Djava.io.tmpdir=$TMPDIR" "$@"; fi
exec "$script_dir/../share/kast/libexec/kast-management" "$@"
