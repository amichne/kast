{
  "type": "object",
  "properties": {
    "verbose": {
      "type": "boolean"
    },
    "request": {
      "$ref": "#/$defs/Action"
    }
  },
  "required": [
    "verbose",
    "request"
  ],
  "additionalProperties": false,
  "$defs": {
    "DirectoryScope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "DIRECTORY"
          ]
        },
        "relativeDirectoryPath": {
          "type": "string"
        },
        "includeSubdirectories": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceSetNames": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "type",
        "relativeDirectoryPath",
        "includeSubdirectories",
        "sourceSetNames"
      ],
      "additionalProperties": false
    },
    "PackageScope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "PACKAGE"
          ]
        },
        "packageName": {
          "type": "string"
        },
        "includeSubpackages": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceSetNames": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "type",
        "packageName",
        "includeSubpackages",
        "sourceSetNames"
      ],
      "additionalProperties": false
    },
    "SearchSource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SEARCH_DECLARATIONS"
          ]
        },
        "declarationName": {
          "type": "string"
        },
        "nameMatch": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "EXACT",
            "FUZZY",
            null
          ]
        },
        "declarationKinds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "enum": [
              "CLASS",
              "FUNCTION",
              "PROPERTY",
              "TYPE_ALIAS"
            ]
          },
          "minItems": 1,
          "maxItems": 4
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/Scope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "declarationName",
        "nameMatch",
        "declarationKinds",
        "scope"
      ],
      "additionalProperties": false
    },
    "ReferenceSource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SYMBOL_REFS"
          ]
        },
        "symbolRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^exact:v[1-9][0-9]*:"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "type",
        "symbolRefs"
      ],
      "additionalProperties": false
    },
    "Output": {
      "anyOf": [
        {
          "$ref": "#/$defs/SymbolsOutput"
        },
        {
          "$ref": "#/$defs/OccurrencesOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "ReadResultOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/SymbolsOutput"
        },
        {
          "$ref": "#/$defs/OccurrencesOutput"
        },
        {
          "type": "null"
        }
      ]
    },
    "SymbolsOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SYMBOLS"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "NAME",
              "LOCATION",
              "SIGNATURE",
              "SOURCE"
            ]
          },
          "minItems": 0,
          "maxItems": 4
        }
      },
      "required": [
        "type",
        "fields"
      ],
      "additionalProperties": false
    },
    "OccurrencesOutput": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "OCCURRENCES"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ExpandRelation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EXPAND_RELATION"
          ]
        },
        "relation": {
          "type": "string",
          "enum": [
            "REFERENCES",
            "CALLERS",
            "CALLEES",
            "IMPLEMENTATIONS",
            "INHERITORS",
            "OVERRIDES",
            "TYPE_USES"
          ]
        },
        "expansionScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpansionScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "relation",
        "expansionScope"
      ],
      "additionalProperties": false
    },
    "ExecutionBudget": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "maxResults": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "maxReturnedBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "maxResults",
        "maxReturnedBytes"
      ],
      "additionalProperties": false
    },
    "ResultReference": {
      "type": "string",
      "pattern": "^result:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ResultCursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "EvidenceCursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000
    },
    "RunAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RUN"
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "steps": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "terminalStep": {
          "$ref": "#/$defs/TerminalStep"
        },
        "retention": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DISCARD",
            "RETAIN",
            null
          ]
        },
        "executionBudget": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionMode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "source",
        "steps",
        "terminalStep",
        "retention",
        "executionBudget",
        "executionMode"
      ],
      "additionalProperties": false
    },
    "ResumeAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RESUME"
          ]
        },
        "continuation": {
          "$ref": "#/$defs/ExecutionContinuation"
        },
        "executionBudget": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionBudget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "continuation",
        "executionBudget"
      ],
      "additionalProperties": false
    },
    "ReadResultAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "READ_RESULT"
          ]
        },
        "result": {
          "$ref": "#/$defs/ResultReference"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResultCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadResultOutput"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionBudget": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "result",
        "cursor",
        "output",
        "executionBudget",
        "evidence_cursor"
      ],
      "additionalProperties": false
    },
    "ExecutionContinuation": {
      "type": "string",
      "pattern": "^query-output:v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "LocationSource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "AT_LOCATION"
          ]
        },
        "file": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "file",
        "offset"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/DirectoryScope"
        },
        {
          "$ref": "#/$defs/PackageScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "Source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchSource"
        },
        {
          "$ref": "#/$defs/LocationSource"
        },
        {
          "$ref": "#/$defs/ReferenceSource"
        }
      ]
    },
    "Step": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpandRelation"
        }
      ]
    },
    "Action": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunAction"
        },
        {
          "$ref": "#/$defs/ResumeAction"
        },
        {
          "$ref": "#/$defs/ReadResultAction"
        },
        {
          "$ref": "#/$defs/ReadSourceAction"
        }
      ]
    },
    "ImpactWorkspaceDomain": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "WORKSPACE"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ImpactRetainedDomain": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RETAINED_SEED"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "ImpactSourceDomain": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "SOURCE_DOMAIN"
          ]
        },
        "sourceSets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "directory": {
          "type": [
            "string",
            "null"
          ]
        },
        "includeSubdirectories": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourcePolicy": {
          "type": "string",
          "enum": [
            "PRODUCTION_ONLY",
            "TEST_ONLY",
            "PRODUCTION_AND_TEST"
          ]
        },
        "generatedSources": {
          "type": "string",
          "enum": [
            "EXCLUDE",
            "INCLUDE"
          ]
        }
      },
      "required": [
        "type",
        "sourceSets",
        "directory",
        "includeSubdirectories",
        "sourcePolicy",
        "generatedSources"
      ],
      "additionalProperties": false
    },
    "ExpansionScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ImpactWorkspaceDomain"
        },
        {
          "$ref": "#/$defs/ImpactRetainedDomain"
        },
        {
          "$ref": "#/$defs/ImpactSourceDomain"
        }
      ]
    },
    "SourceCandidateReference": {
      "type": "string",
      "pattern": "^(?:(?:candidate|exact):(?:v4:[0-9a-f]{64}|v5:[A-Za-z0-9_-]{21}[AQgw]|v[23]:[A-Za-z0-9_-]+:[0-9a-f]{64})|source-selector-v[12]:[A-Za-z0-9_-]+:[0-9a-f]{64})$"
    },
    "ReadSourceAction": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "READ_SOURCE"
          ]
        },
        "candidateRef": {
          "$ref": "#/$defs/SourceCandidateReference"
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ANCHOR",
            "CALLABLE_BODY",
            "CLASS_BODY",
            "FILE",
            "ENCLOSING_DECLARATION",
            "ENCLOSING_CALLABLE_BODY",
            "ENCLOSING_CLASS_BODY",
            null
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceText"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionBudget": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionBudget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "candidateRef",
        "region",
        "text",
        "executionBudget"
      ],
      "additionalProperties": false
    },
    "TerminalStep": {
      "anyOf": [
        {
          "$ref": "#/$defs/Emit"
        },
        {
          "$ref": "#/$defs/Trace"
        }
      ]
    },
    "Emit": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EMIT"
          ]
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/Output"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "output"
      ],
      "additionalProperties": false
    },
    "TraceOutput": {
      "anyOf": [
        {
          "$ref": "#/$defs/SymbolsOutput"
        }
      ]
    },
    "Trace": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "TRACE"
          ]
        },
        "expansionScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpansionScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceOutput"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "expansionScope",
        "output"
      ],
      "additionalProperties": false
    },
    "SourceTextComplete": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "COMPLETE"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceTextNone": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NONE"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "SourceTextWindow": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "WINDOW"
          ]
        },
        "beforeLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "afterLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "beforeLines",
        "afterLines"
      ],
      "additionalProperties": false
    },
    "SourceText": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceTextComplete"
        },
        {
          "$ref": "#/$defs/SourceTextNone"
        },
        {
          "$ref": "#/$defs/SourceTextWindow"
        },
        {
          "$ref": "#/$defs/SourceTextExcerpt"
        }
      ]
    },
    "SourceTextExcerpt": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EXCERPT"
          ]
        },
        "maxLines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "maxLines"
      ],
      "additionalProperties": false
    },
    "ExecutionMode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "RUNNER_CONTROLLED",
        null
      ]
    }
  }
}
