{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/schemas/hosted-writer/receipt.schema.json",
  "title": "Kast hosted-writer gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "gateId", "programFingerprint", "repositoryHead",
    "dependencyReceiptDigests", "inputDigest", "commandDigest", "observedProofs",
    "artifactDigests"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gateId": { "type": "string", "minLength": 1 },
    "programFingerprint": { "$ref": "#/$defs/sha256" },
    "repositoryHead": { "$ref": "#/$defs/gitSha" },
    "dependencyReceiptDigests": {
      "type": "array",
      "items": { "$ref": "#/$defs/sha256" },
      "uniqueItems": true
    },
    "inputDigest": { "$ref": "#/$defs/sha256" },
    "commandDigest": { "$ref": "#/$defs/sha256" },
    "observedProofs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "artifactDigests": {
      "type": "array",
      "items": { "$ref": "#/$defs/sha256" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
  }
}
