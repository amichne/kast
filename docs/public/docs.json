{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kast",
  "description": "Give your coding agent the Kotlin knowledge your IDE already uses. Find code, trace its connections, and make targeted changes.",
  "colors": {
    "primary": "#3154C7",
    "light": "#8FA7FF",
    "dark": "#27439F"
  },
  "fonts": {
    "family": "SUSE"
  },
  "logo": "/images/kast-mark.svg",
  "favicon": "/images/kast-mark.svg",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FBFBF9",
      "dark": "#171816"
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Tutorials",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "tutorials",
              "tutorials/first-query"
            ]
          }
        ]
      },
      {
        "tab": "How-to guides",
        "groups": [
          {
            "group": "Choose a task",
            "pages": [
              "how-to",
              "search"
            ]
          },
          {
            "group": "Install and connect",
            "pages": [
              "start",
              "agent-harnesses",
              "reference/installation",
              "reference/integrations"
            ]
          },
          {
            "group": "Investigate and change code",
            "pages": [
              "how-to/complete-engineering-task",
              "reference/search",
              "how-to/inspect-diagnostics",
              "how-to/read-retained-evidence",
              "reference/query-pipelines",
              "reference/change"
            ]
          },
          {
            "group": "Recover and maintain",
            "pages": [
              "troubleshooting",
              "reference/troubleshooting",
              "reference/management"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Kast mechanisms",
            "pages": [
              "reference",
              "reference/program-tracing",
              "reference/staleness",
              "reference/lifecycles"
            ]
          },
          {
            "group": "Semantic contracts",
            "pages": [
              "reference/api",
              "reference/responses",
              "reference/symbols",
              "reference/callback-observations",
              "reference/composition",
              "reference/limits"
            ]
          },
          {
            "group": "Client contracts",
            "pages": [
              "reference/mcp-catalog",
              "reference/rpc-catalog",
              "reference/compatibility"
            ]
          },
          {
            "group": "Schemas and recorded evidence",
            "openapi": {
              "source": "reference/callables.openapi.json",
              "directory": "reference/callables"
            },
            "pages": [
              "reference/schemas",
              "reference/walkthrough",
              {
                "group": "Detailed schemas",
                "expanded": false,
                "pages": [
                  {
                    "group": "Callable schemas",
                    "expanded": false,
                    "pages": [
                      "POST /callables/query_symbols",
                      "POST /callables/check_diagnostics",
                      "POST /callables/add_declaration",
                      "POST /callables/replace_body",
                      "POST /callables/workspace_lifecycle"
                    ]
                  },
                  {
                    "group": "Transport results",
                    "expanded": false,
                    "pages": [
                      "reference/models/mcp-tool-call-result",
                      "reference/models/mcp-read-result",
                      "reference/models/mcp-investigation-result",
                      "reference/models/mcp-change-result",
                      "reference/models/tool-rpc-reply"
                    ]
                  },
                  {
                    "group": "Semantic results",
                    "expanded": false,
                    "pages": [
                      "reference/models/query-item",
                      "reference/models/relation-fact",
                      "reference/models/diagnostic",
                      "reference/models/live-evidence"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "group": "Source owners",
            "pages": [
              "reference/source-map"
            ]
          }
        ]
      },
      {
        "tab": "Explanation",
        "groups": [
          {
            "group": "Understand the evidence",
            "pages": [
              "explanation",
              "reference/evidence-boundaries",
              "explanation/query-lifecycle",
              "reference/callbacks"
            ]
          },
          {
            "group": "Runtime ownership",
            "pages": [
              "reference/internals/architecture",
              "reference/internals/background-startup"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "How-to guides",
        "href": "/how-to"
      },
      {
        "label": "Reference",
        "href": "/reference"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/amichne/kast"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install Kast",
      "href": "/start"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/amichne/kast"
    },
    "links": [
      {
        "header": "Kast",
        "items": [
          {
            "label": "Why Kast?",
            "href": "/"
          },
          {
            "label": "What you can do",
            "href": "/search"
          }
        ]
      },
      {
        "header": "Get started",
        "items": [
          {
            "label": "Install",
            "href": "/start"
          },
          {
            "label": "Connect your agent",
            "href": "/agent-harnesses"
          },
          {
            "label": "Troubleshoot",
            "href": "/troubleshooting"
          }
        ]
      },
      {
        "header": "Reference",
        "items": [
          {
            "label": "Technical reference",
            "href": "/reference"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/amichne/kast"
          },
          {
            "label": "Security",
            "href": "https://github.com/amichne/kast/security"
          }
        ]
      }
    ]
  },
  "metadata": {
    "timestamp": true
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": false
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "search": {
    "prompt": "Search Kast"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The requested Kast documentation page does not exist. Return to the [documentation home](/)."
    }
  },
  "redirects": [
    {
      "source": "/change",
      "destination": "/reference/change",
      "permanent": true
    },
    {
      "source": "/concepts/architecture",
      "destination": "/reference/internals/architecture",
      "permanent": true
    },
    {
      "source": "/concepts/background-startup",
      "destination": "/reference/internals/background-startup",
      "permanent": true
    },
    {
      "source": "/concepts/evidence-boundaries",
      "destination": "/reference/evidence-boundaries",
      "permanent": true
    },
    {
      "source": "/query-pipelines",
      "destination": "/reference/query-pipelines",
      "permanent": true
    },
    {
      "source": "/workspaces",
      "destination": "/reference/management",
      "permanent": true
    },
    {
      "source": "/reference/callables.openapi.json",
      "destination": "https://raw.githubusercontent.com/amichne/kast/main/docs/public/reference/callables.openapi.json",
      "permanent": true
    },
    {
      "source": "/examples/query-walkthrough.json",
      "destination": "/reference/examples/query-walkthrough.json",
      "permanent": true
    },
    {
      "source": "/concepts/runtime-integration-validation",
      "destination": "/reference/internals/architecture",
      "permanent": true
    },
    {
      "source": "/api-reference/query-symbols",
      "destination": "/reference/callables/query-symbols",
      "permanent": true
    },
    {
      "source": "/api-reference/check-diagnostics",
      "destination": "/reference/callables/check-diagnostics",
      "permanent": true
    },
    {
      "source": "/api-reference/add-declaration",
      "destination": "/reference/callables/add-declaration",
      "permanent": true
    },
    {
      "source": "/api-reference/replace-body",
      "destination": "/reference/callables/replace-body",
      "permanent": true
    },
    {
      "source": "/api-reference/workspace-lifecycle",
      "destination": "/reference/callables/workspace-lifecycle",
      "permanent": true
    },
    {
      "source": "/reference/examples/query-walkthrough.json",
      "destination": "https://raw.githubusercontent.com/amichne/kast/main/docs/public/reference/examples/query-walkthrough.json",
      "permanent": true
    },
    {
      "source": "/developers",
      "destination": "/reference",
      "permanent": true
    }
  ],
  "api": {
    "playground": {
      "display": "none"
    },
    "examples": {
      "autogenerate": false
    }
  }
}
