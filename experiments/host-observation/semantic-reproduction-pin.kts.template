// Read-only evidence from the original process. No query, import, refresh, or cache mutation.
enum class NativePinStage { HOST_ADMISSION, PLUGIN_ADMISSION, PROJECT_ADMISSION, CONFIGURATION_CAPTURE, ARTIFACT_CAPTURE, MODEL_CAPTURE, PUBLICATION }
enum class NativePinFailure { PIN_CAPTURE_REJECTED }
enum class NativeQualificationSlice { TRY_BRANCH_RESULTS, TRY_LOCAL_IDENTITIES, RELATION_WORK_REDUCTION, QUERY_CHECKPOINT_STORAGE }
data class NativePinInput(val project: String, val hostPid: Long, val qualificationSlice: NativeQualificationSlice?)
data class NativePinRejection(val type: NativePinFailure = NativePinFailure.PIN_CAPTURE_REJECTED, val stage: NativePinStage)
data class NativeProfilePin(val type: String = "NATIVE_PROFILE_PATHS", val hostPid: Long, val processStart: String,
    val ideaHome: String, val userHome: String, val config: String, val system: String, val plugins: String)
run {
    val inputPath = java.nio.file.Path.of(String(java.util.Base64.getDecoder().decode("@INPUT_BASE64@"), Charsets.UTF_8))
    val input = com.google.gson.Gson().fromJson(java.nio.file.Files.readString(inputPath), NativePinInput::class.java)
    var stage = NativePinStage.HOST_ADMISSION
    try {
    val qualificationSlice = checkNotNull(input.qualificationSlice)
    check(ProcessHandle.current().pid() == input.hostPid)
    stage = NativePinStage.PLUGIN_ADMISSION
    val plugin = com.intellij.ide.plugins.PluginManagerCore.getPlugin(com.intellij.openapi.extensions.PluginId.getId("io.github.amichne.kast.ide-hosted"))!!
    val loader = plugin.pluginClassLoader!!
    stage = NativePinStage.PROJECT_ADMISSION
    val project = com.intellij.openapi.project.ProjectManager.getInstance().openProjects.single { it.basePath == input.project }
    fun constant(owner: String, name: String): Any {
        val field = loader.loadClass(owner).getDeclaredField(name)
        field.isAccessible = true
        return field.get(null)
    }
    fun getter(value: Any, name: String): Any = value.javaClass.methods.single {
        it.name.startsWith(name) && it.parameterCount == 0
    }.invoke(value)
    stage = NativePinStage.CONFIGURATION_CAPTURE
    val serviceClass = loader.loadClass("io.github.amichne.kast.workspace.intellij.read.hosted.HostedQueryService")
    val configurationGetter = serviceClass.methods.singleOrNull { it.name == "getReadConfiguration" && it.parameterCount == 0 }
    val policy = if (configurationGetter == null) null else {
        val admission = configurationGetter.invoke(project.getService(serviceClass))
        check(admission.javaClass.simpleName == "Refined") { "Host read configuration rejected" }
        getter(admission, "getValue")
    }
    val effective = if (policy == null) emptyMap<String, Any>() else
        (getter(policy, "getValues") as List<*>).associate { value ->
            getter(value!!, "getParameter").toString() to getter(value, "getValue")
        }
    val settings = if (policy == null) emptyList<Map<String, Any>>() else
        (getter(policy, "getValues") as List<*>).map { value ->
            mapOf("parameter" to getter(value!!, "getParameter").toString(), "value" to getter(value, "getValue"), "source" to getter(value, "getSource").toString())
        }
    val modelLimits = if (policy == null) loader.loadClass("io.github.amichne.kast.workspace.intellij.read.DetachedModelLimits").declaredFields
        .filter { it.name.startsWith("MAX_") }.associate { it.isAccessible = true; it.name to it.get(null) }
        else mapOf("MAX_MODULES" to effective.getValue("MODEL_MODULES"), "MAX_SOURCE_ROOTS_PER_MODULE" to effective.getValue("MODEL_SOURCE_ROOTS_PER_MODULE"))
    // Current hosts admit budgets per request. Configuration proves defaults; every
    // replay response independently retains its actual admitted execution budget.
    val legacyBudget = if (policy == null) constant("io.github.amichne.kast.runtime.hosted.HostedCanonicalQueryKt", "hostedQueryBudget") else null
    val legacyResources = legacyBudget?.let { getter(it, "getResources") }
    stage = NativePinStage.ARTIFACT_CAPTURE
    val commonClasses = listOf(
        "io.github.amichne.kast.workspace.intellij.read.DetachedModelLimits",
        "io.github.amichne.kast.workspace.intellij.read.LiveNamedGradleSourceScopeCapture",
        "io.github.amichne.kast.workspace.intellij.read.hosted.HostedQueryExecutorKt",
        "io.github.amichne.kast.workspace.intellij.read.hosted.HostedReadDiagnostics",
    "io.github.amichne.kast.workspace.intellij.read.hosted.HostedQueryService",
    "io.github.amichne.kast.workspace.intellij.read.hosted.HostedReadTraceIdentity",
    "io.github.amichne.kast.workspace.intellij.read.hosted.HostedReadDiagnosticEncodingKt",
    "io.github.amichne.kast.runtime.hosted.HostedEndpointService",
    "io.github.amichne.kast.runtime.hosted.HostedTransportTrace",
    "io.github.amichne.kast.runtime.hosted.LoggingHostedEndpointObserver",
    "io.github.amichne.kast.runtime.hosted.HostedSmartModeWaitKt",
        "io.github.amichne.kast.runtime.hosted.HostedCanonicalQueryKt",
        "io.github.amichne.kast.symbol.intellij.IntellijNativeDiscoveryQueryKt",
        "io.github.amichne.kast.relation.intellij.IntellijK2RelationSearch",
        "io.github.amichne.kast.relation.intellij.IntellijCallbackFlowRead",
        "io.github.amichne.kast.relation.intellij.IntellijCallbackFlowScan",
        "io.github.amichne.kast.relation.intellij.CallbackFormalWorklist",
        "io.github.amichne.kast.relation.intellij.CallbackFlowRetention",
        "io.github.amichne.kast.relation.intellij.CallbackRetainedRecords",
        "io.github.amichne.kast.relation.intellij.CallbackParameterSummaries",
        "io.github.amichne.kast.relation.contract.CompleteCallbackForwardingGraph",
        "io.github.amichne.kast.relation.contract.CompleteStaticCallbackGraph",
        "io.github.amichne.kast.relation.contract.RelationReferenceOccurrence"
    )
    val branchClasses = listOf(
        "io.github.amichne.kast.workspace.intellij.read.IntellijReadCounter",
        "io.github.amichne.kast.relation.intellij.IntellijValueFlowNative",
        "io.github.amichne.kast.relation.intellij.NativeTryBranchResult",
        "io.github.amichne.kast.relation.intellij.TryBranchResultPosition",
        "io.github.amichne.kast.relation.intellij.IntellijCompilerTypeProofKt",
        "io.github.amichne.kast.relation.intellij.NativeCompilerTypeProof",
        "io.github.amichne.kast.relation.contract.ValueTransferEvidence\$NormalBranchResult"
    )
    val localClasses = when (qualificationSlice) {
        NativeQualificationSlice.TRY_BRANCH_RESULTS -> emptyList()
        NativeQualificationSlice.RELATION_WORK_REDUCTION, NativeQualificationSlice.QUERY_CHECKPOINT_STORAGE -> emptyList()
        NativeQualificationSlice.TRY_LOCAL_IDENTITIES -> listOf(
        "io.github.amichne.kast.workspace.intellij.read.IntellijLocalIdentityObservationKt",
        "io.github.amichne.kast.symbol.intellij.IntellijLocalDeclarationAddressProjectionKt",
        "io.github.amichne.kast.symbol.intellij.IntellijLocalDeclarationAnchorsKt",
        "io.github.amichne.kast.symbol.intellij.IntellijLocalCompilerTypeProofKt",
        "io.github.amichne.kast.symbol.intellij.LocalCompilerTypeProof",
        "io.github.amichne.kast.source.intellij.IntellijLocalCompilerTypeProofKt",
        "io.github.amichne.kast.source.intellij.LocalCompilerTypeProof",
        "io.github.amichne.kast.source.intellij.IntellijSourceCompilerProjectionKt",
        "io.github.amichne.kast.source.intellij.SourceLocalOwnerCallableIdentityKt",
        "io.github.amichne.kast.source.intellij.SourceLocalOwnerCallableIdentityObservationKt",
        "io.github.amichne.kast.symbol.contract.LocalDeclarationAddress",
        "io.github.amichne.kast.relation.intellij.IntellijK2RelationProjectionKt",
        "io.github.amichne.kast.relation.intellij.IntellijK2SymbolIdentityKt",
        "io.github.amichne.kast.relation.intellij.IntellijLocalDeclarationAnchorsKt",
        "io.github.amichne.kast.relation.intellij.RelationLocalOwnerCallableIdentityKt",
        "io.github.amichne.kast.relation.intellij.RelationLocalOwnerCallableIdentityObservationKt",
        "io.github.amichne.kast.relation.intellij.IntellijLocalRelationOwnerSignatureKt"
        )
    }
    val workClasses = when (qualificationSlice) {
        NativeQualificationSlice.TRY_BRANCH_RESULTS, NativeQualificationSlice.TRY_LOCAL_IDENTITIES -> emptyList()
        NativeQualificationSlice.QUERY_CHECKPOINT_STORAGE -> emptyList()
        NativeQualificationSlice.RELATION_WORK_REDUCTION -> listOf(
            "io.github.amichne.kast.query.service.QueryTraceTasksKt",
            "io.github.amichne.kast.relation.intellij.AdmittedRelationScopes",
            "io.github.amichne.kast.relation.intellij.IntellijRelationScopeCompilerKt",
            "io.github.amichne.kast.relation.intellij.CompiledRelationScope",
            "io.github.amichne.kast.relation.intellij.RelationFileEnumerationPlan",
            "io.github.amichne.kast.relation.intellij.RelationFileInventory",
            "io.github.amichne.kast.relation.intellij.CompleteRelationFileUniverse",
            "io.github.amichne.kast.relation.intellij.EnumeratedRelationScope",
            "io.github.amichne.kast.relation.intellij.ObservedRelationSearchKt",
            "io.github.amichne.kast.topology.intellij.IntellijSemanticDependencyCapture",
            "io.github.amichne.kast.topology.intellij.SemanticDependencyReadInputs",
            "io.github.amichne.kast.topology.intellij.SemanticNativeSdkFilePlan",
            "io.github.amichne.kast.topology.intellij.SemanticNativeFileMemo",
            "io.github.amichne.kast.runtime.hosted.HostedSemanticCallbackFacts",
            "io.github.amichne.kast.runtime.hosted.HostedReadCallbackPartitions",
            "io.github.amichne.kast.workspace.intellij.read.hosted.HostedReadActionAccounting",
            "io.github.amichne.kast.workspace.intellij.read.hosted.HostedReadSearchAccounting",
            "io.github.amichne.kast.workspace.intellij.read.IntellijReadCall",
        )
    }
    val checkpointClasses = when (qualificationSlice) {
        NativeQualificationSlice.QUERY_CHECKPOINT_STORAGE -> listOf(
            "io.github.amichne.kast.query.service.QueryService",
            "io.github.amichne.kast.query.service.QueryService\$Execution",
            "io.github.amichne.kast.query.service.QueryCheckpointStorageAdmissionKt",
            "io.github.amichne.kast.query.service.PipelineCheckpoint",
            "io.github.amichne.kast.query.service.PipelineCheckpointKt",
            "io.github.amichne.kast.query.contract.QueryCheckpointStorageBytes",
            "io.github.amichne.kast.query.contract.QueryCheckpointStorageEstimate",
            "io.github.amichne.kast.query.contract.QueryCheckpointStorageAdmission",
            "io.github.amichne.kast.query.contract.QueryCheckpointStorageOutcome",
            "io.github.amichne.kast.runtime.hosted.HostedQueryCheckpointStorageObservationKt",
            "io.github.amichne.kast.workspace.intellij.read.IntellijReadGauge",
            "io.github.amichne.kast.workspace.intellij.read.IntellijReadGaugeKt",
            "io.github.amichne.kast.workspace.intellij.read.IntellijReadCounter",
        )
        else -> emptyList()
    }
    val classes = (commonClasses + branchClasses + localClasses + workClasses + checkpointClasses).associateWith { name ->
        val resource = loader.getResource(name.replace('.', '/') + ".class")!!
        mapOf("url" to resource.toString(), "sha256" to java.security.MessageDigest.getInstance("SHA-256")
            .digest(resource.openStream().use { it.readBytes() }).joinToString("") { "%02x".format(it) })
    }
    stage = NativePinStage.MODEL_CAPTURE
    val native = com.intellij.openapi.application.ReadAction.compute<Map<String, Any>, RuntimeException> {
        val modules = com.intellij.openapi.module.ModuleManager.getInstance(project).modules
        check(modules.size <= 5000) // Diagnostic bound, never an admission override.
        val roots = modules.sortedBy { it.name }.map { module ->
            val entries = com.intellij.openapi.roots.ModuleRootManager.getInstance(module).contentEntries
            mapOf("module" to module.name, "sourceRoots" to entries.flatMap { it.sourceFolders.toList() }.sortedBy { it.url }.map {
                mapOf("url" to it.url, "kind" to it.rootType.javaClass.name)
            }, "contentRoots" to entries.map { it.url }.sorted())
        }
        val gradlePlugin = com.intellij.ide.plugins.PluginManagerCore.getPlugin(com.intellij.openapi.extensions.PluginId.getId("org.jetbrains.plugins.gradle"))!!
        val cacheClass = gradlePlugin.pluginClassLoader!!.loadClass("org.jetbrains.plugins.gradle.service.project.data.ExternalProjectDataCache")
        val cache = cacheClass.getMethod("getInstance", com.intellij.openapi.project.Project::class.java).invoke(null, project)
        val imported = cacheClass.getMethod("getRootExternalProject", String::class.java).invoke(cache, project.basePath)
        val projects = mutableListOf<Map<String, Any>>()
        val pending = java.util.ArrayDeque<Any>()
        if (imported != null) pending.add(imported)
        while (pending.isNotEmpty()) {
            check(projects.size < 5000)
            val current = pending.removeFirst()
            val sourceSets = getter(current, "getSourceSets") as Map<*, *>
            projects.add(mapOf("path" to getter(current, "getPath"), "directory" to getter(current, "getProjectDir").toString(),
                "sourceSets" to sourceSets.values.sortedBy { getter(it!!, "getName").toString() }.map { set ->
                    mapOf("name" to getter(set!!, "getName"), "roots" to (getter(set, "getSources") as Map<*, *>).entries.sortedBy { it.key.toString() }.map { (kind, value) ->
                        mapOf("kind" to kind.toString(), "directories" to (getter(value!!, "getSrcDirs") as Collection<*>).map { it.toString() }.sorted())
                    })
                }))
            pending.addAll((getter(current, "getChildProjects") as Map<*, *>).values.filterNotNull())
        }
        mapOf("root" to project.basePath!!, "smart" to !com.intellij.openapi.project.DumbService.isDumb(project),
            "intellijModuleCount" to modules.size, "gradleModelState" to if (imported == null) "unavailable" else "captured", "gradleProjectCount" to projects.size,
            "sourceRootCount" to roots.sumOf { (it["sourceRoots"] as List<*>).size },
            "modules" to roots, "importedGradleProjects" to projects.sortedBy { it.getValue("directory").toString() },
            "savedDocuments" to com.intellij.openapi.fileEditor.FileDocumentManager.getInstance().unsavedDocuments.isEmpty(),
            "committedPsi" to !com.intellij.psi.PsiDocumentManager.getInstance(project).hasUncommitedDocuments())
    }
    val result = mapOf("schemaVersion" to 1, "pid" to ProcessHandle.current().pid(),
        "processStart" to ProcessHandle.current().info().startInstant().get().toString(),
        "ideaBuild" to com.intellij.openapi.application.ApplicationInfo.getInstance().build.asString(),
        "jbr" to System.getProperty("java.runtime.version"), "javaHome" to System.getProperty("java.home"),
        "kotlinPlugin" to com.intellij.ide.plugins.PluginManagerCore.getPlugin(com.intellij.openapi.extensions.PluginId.getId("org.jetbrains.kotlin"))!!.version,
        "plugin" to mapOf("version" to plugin.version, "path" to plugin.pluginPath.toString(), "classResources" to classes),
        "limits" to mapOf("model" to modelLimits,
            "effectiveSettings" to settings, "outerDeadlineMillis" to (effective["HOST_QUERY_MILLIS"] ?: constant("io.github.amichne.kast.workspace.intellij.read.hosted.HostedQueryExecutorKt", "HOSTED_QUERY_BUDGET_MILLIS")),
            "innerElapsedMillis" to (effective["SEMANTIC_MILLIS"] ?: getter(legacyResources!!, "getElapsedTimeLimit")), "workUnits" to (effective["SEMANTIC_WORK"] ?: getter(legacyResources!!, "getWorkUnitLimit")),
            "results" to (effective["SEMANTIC_RESULTS"] ?: getter(legacyResources!!, "getResultLimit")), "queryBytes" to (effective["SEMANTIC_RETURNED_BYTES"] ?: getter(legacyBudget!!, "getReturnedBytes")),
            "nativeNames" to (effective["DISCOVERY_NAMES"] ?: constant("io.github.amichne.kast.symbol.intellij.IntellijNativeDiscoveryQueryKt", "MAX_NATIVE_DISCOVERY_NAMES")),
            "nativeCandidates" to (effective["DISCOVERY_CANDIDATES"] ?: constant("io.github.amichne.kast.symbol.intellij.IntellijNativeDiscoveryQueryKt", "MAX_NATIVE_DISCOVERY_CANDIDATES"))),
        "model" to native,
        "diagnosticAvailability" to mapOf("instrumented" to (loader.getResource("io/github/amichne/kast/workspace/intellij/read/hosted/HostedReadDiagnostics.class") != null),
            "enabled" to (policy != null || java.lang.Boolean.getBoolean("kast.hosted.read.diagnostics"))))
    stage = NativePinStage.PUBLICATION
    fun actualPath(value: String) = java.nio.file.Path.of(value).toRealPath().toString()
    val profile = NativeProfilePin(hostPid = ProcessHandle.current().pid(),
        processStart = ProcessHandle.current().info().startInstant().get().toString(),
        ideaHome = actualPath(com.intellij.openapi.application.PathManager.getHomePath()),
        userHome = actualPath(System.getProperty("user.home")),
        config = actualPath(com.intellij.openapi.application.PathManager.getConfigPath()),
        system = actualPath(com.intellij.openapi.application.PathManager.getSystemPath()),
        plugins = actualPath(com.intellij.openapi.application.PathManager.getPluginsPath()))
    java.nio.file.Files.writeString(inputPath.parent.resolve("profile.json"), com.google.gson.Gson().toJson(profile))
    java.nio.file.Files.writeString(inputPath.parent.resolve("host.json"), com.google.gson.GsonBuilder().setPrettyPrinting().create().toJson(result))
    } catch (failure: Throwable) {
        // Bounded stage evidence; exception messages may contain project/source data.
        java.nio.file.Files.writeString(inputPath.parent.resolve("pin-rejection.json"), com.google.gson.Gson().toJson(NativePinRejection(stage = stage)))
    }
}
