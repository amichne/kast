{
  "examples": {
    "exactSymbol": {
      "summary": "Read the declaration at an exact symbol reference returned by Kast.",
      "value": {
        "symbolRef": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ"
      }
    },
    "callableBody": {
      "summary": "Read a bounded callable body and direct declarations.",
      "value": {
        "symbolRef": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ",
        "region": "CALLABLE_BODY",
        "text": {
          "type": "WINDOW",
          "beforeLines": 2,
          "afterLines": 2,
          "maxBytes": 12000
        },
        "entities": {
          "type": "MATCHING",
          "filters": [
            {
              "type": "DECLARATIONS",
              "kinds": [
                "FUNCTION"
              ]
            }
          ],
          "limit": 50
        }
      }
    }
  },
  "invalidExamples": {
    "retiredSymbol": {
      "summary": "The retired symbol shortcut is rejected.",
      "value": {
        "symbol": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ"
      }
    },
    "retiredAnchor": {
      "summary": "The retired anchor object is rejected.",
      "value": {
        "anchor": {
          "symbolRef": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ"
        }
      }
    },
    "missingTextVariant": {
      "summary": "A supplied text object requires its type.",
      "value": {
        "symbolRef": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ",
        "text": {}
      }
    },
    "missingTextType": {
      "summary": "Every supplied text variant requires type.",
      "value": {
        "symbolRef": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ",
        "text": {
          "beforeLines": 2,
          "afterLines": 2
        }
      }
    },
    "mixedTextVariant": {
      "summary": "Text variants cannot be mixed.",
      "value": {
        "symbolRef": "exact:v5:AAAAAAAAAAAAAAAAAAAAAQ",
        "text": {
          "type": "COMPLETE",
          "beforeLines": 2
        }
      }
    }
  }
}
