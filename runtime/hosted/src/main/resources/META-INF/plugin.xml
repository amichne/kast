<idea-plugin>
  <id>io.github.amichne.kast.ide-hosted</id>
  <name>Kast Existing IDE Runtime</name>
  <version>0.1.0</version>
  <vendor>amichne</vendor>
  <description>Project-owned local access to the existing Kotlin index and bounded semantic reads.</description>
  <idea-version since-build="${ideBuild}" until-build="${ideBuild}"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>
  <depends>org.jetbrains.kotlin</depends>
  <depends>org.jetbrains.plugins.gradle</depends>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="io.github.amichne.kast.runtime.hosted.HostedEndpointStartup"/>
  </extensions>
</idea-plugin>
