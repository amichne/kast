{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/experimental/hosted-approval/v1",
  "description": "Existing private approval preparation request and owner-bound challenge response. Operation is the existing finite effect selector.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "planIdentity"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "CHANGE_APPLY",
            "CHANGE_RECOVER"
          ]
        },
        "planIdentity": {
          "type": "string",
          "pattern": "^plan:[0-9a-f]{64}$"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operation",
        "root",
        "host",
        "planId",
        "challenge",
        "preview"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "CHANGE_APPLY",
            "CHANGE_RECOVER"
          ]
        },
        "root": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "host": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "challenge": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "diff"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "diff": {
              "type": "string",
              "minLength": 1,
              "maxLength": 262144
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "operation": "CHANGE_APPLY",
      "planIdentity": "plan:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "version": 1,
      "operation": "CHANGE_RECOVER",
      "root": "/workspace",
      "host": "11111111-1111-1111-1111-111111111111",
      "planId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "challenge": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "preview": {
        "path": "src/main/kotlin/Example.kt",
        "diff": "@@ restore body @@\n-fun example() = 2\n+fun example() = 1"
      }
    }
  ]
}
