{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kast.dev/schemas/public-semantic-contract-inventory.schema.json",
  "title": "Kast public semantic contract inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inventoryKind", "operations", "values", "findings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "inventoryKind": {"const": "BASELINE_AND_MIGRATION_LEDGER"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "currentRoute", "inputs", "outputs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*$"},
          "currentRoute": {"type": "string", "minLength": 1},
          "inputs": {"$ref": "#/$defs/valueReferences"},
          "outputs": {"$ref": "#/$defs/valueReferences", "minItems": 1}
        }
      }
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/value"}
    },
    "findings": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "valueReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}
    },
    "nullableDescription": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publicTerm",
        "operation",
        "direction",
        "rustType",
        "wireType",
        "parser",
        "normalization",
        "default",
        "constraint",
        "authority",
        "classification",
        "producers",
        "consumers"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "publicTerm": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*$"},
        "direction": {"enum": ["INPUT", "OUTPUT"]},
        "rustType": {"type": "string", "minLength": 1},
        "wireType": {"type": "string", "minLength": 1},
        "parser": {"$ref": "#/$defs/nullableDescription"},
        "normalization": {"$ref": "#/$defs/nullableDescription"},
        "default": {"$ref": "#/$defs/nullableDescription"},
        "constraint": {"$ref": "#/$defs/nullableDescription"},
        "authority": {"type": "string", "minLength": 1},
        "classification": {
          "enum": ["CALLER_VALUE", "KAST_ISSUED_VALUE", "CLOSED_CONTROL", "EVIDENCE"]
        },
        "producers": {"$ref": "#/$defs/valueReferences"},
        "consumers": {"$ref": "#/$defs/valueReferences"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "evidence",
        "requiredResolution",
        "resolutionProof"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "kind": {
          "enum": [
            "TERM_COLLISION",
            "SEMANTIC_ALIAS",
            "UNRESTRICTED_KAST_ISSUED_VALUE",
            "PRODUCER_WITHOUT_CONSUMER",
            "CALLER_RECONSTRUCTION_REQUIRED",
            "OVERCLAIMED_TYPE",
            "CONTENT_INFERRED_INPUT_TYPE",
            "PARALLEL_DRIFT_SURFACE"
          ]
        },
        "status": {"enum": ["OPEN", "RESOLVED"]},
        "evidence": {"type": "string", "minLength": 1},
        "requiredResolution": {"type": "string", "minLength": 1},
        "resolutionProof": {"$ref": "#/$defs/nullableDescription"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "RESOLVED"}}},
          "then": {"properties": {"resolutionProof": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"resolutionProof": {"type": "null"}}}
        }
      ]
    }
  }
}
